{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/jes-licensed-differential-adapter@1",
  "title": "Licensed JES2 execution differential adapter policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "target_version", "baseline_id", "required_product",
    "receipt_environment_variable", "candidate_identity", "required_scenarios",
    "licensed_receipt_required_for_pass",
    "generated_historical_or_local_result_counts_as_pass",
    "publication_bytes_retained", "oracle_binary_retained"
  ],
  "properties": {
    "schema_version": {"const": "mainframe-env.jes-licensed-differential-adapter@1"},
    "target_version": {"const": "0.8.0"},
    "baseline_id": {"const": "ibm-zos-3.2-jcl-jes2-2026-06"},
    "required_product": {"const": "z/OS 3.2 JES2 execution environment"},
    "receipt_environment_variable": {"const": "MAINFRAME_ENV_JES_LICENSED_ORACLE_RECEIPT"},
    "candidate_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "domain", "source", "command", "excluded_derived_paths"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "domain": {"const": "mainframe-env.jes-oracle-candidate@1"},
        "source": {"const": "git-index"},
        "command": {"const": "cargo xtask jes-oracle-candidate"},
        "excluded_derived_paths": {
          "const": [
            "conformance/0.8/evidence/jes-806-matrix.json",
            "docs/delivery/subsystems/jes/execution-status.md"
          ]
        }
      }
    },
    "required_scenarios": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "licensed_receipt_required_for_pass": {"const": true},
    "generated_historical_or_local_result_counts_as_pass": {"const": false},
    "publication_bytes_retained": {"const": false},
    "oracle_binary_retained": {"const": false}
  }
}
