            "GSAM",
            "HDAM",
            "HIDAM",
            "HISAM",
            "HSAM",
            "INDEX",
            "MSDB",
            "PHDAM",
            "PHIDAM",
            "PSINDEX",
            "SHISAM",
            "SHSAM"
          ]
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 255,
          "items": {
            "$ref": "#/$defs/segment"
          }
