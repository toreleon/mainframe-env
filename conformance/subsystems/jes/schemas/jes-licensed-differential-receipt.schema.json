{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/jes-licensed-differential-receipt@1",
  "title": "Licensed JES2 execution differential receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "target_subsystem", "baseline_id", "candidate_digest",
    "product", "licensed_environment_attested", "scenarios"
  ],
  "properties": {
    "schema_version": {"const": "mainframe-env.jes-licensed-differential-receipt@1"},
    "target_subsystem": {"const": "jes.execution"},
    "baseline_id": {"const": "ibm-zos-3.2-jcl-jes2-2026-06"},
    "candidate_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "product": {"const": "z/OS 3.2 JES2"},
    "licensed_environment_attested": {"const": true},
    "scenarios": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "observation_digest"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "status": {"const": "pass"},
          "observation_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  }
}
