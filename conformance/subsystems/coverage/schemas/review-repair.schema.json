{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/review-repair@1",
  "title": "mainframe-env 0.2 independent review repair evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "derived", "status", "evidence_digest", "receipt"],
  "properties": {
    "schema_version": {"const": "mainframe-env.review-repair@1"},
    "derived": {"const": true},
    "status": {"const": "pass"},
    "evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_subsystem", "source_identity", "candidate_source_digest", "findings", "commands", "artifacts", "remote_actions"],
      "properties": {
        "target_subsystem": {"const": "coverage.foundation"},
        "source_identity": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "candidate_source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "findings": {"type": "array", "minItems": 7, "maxItems": 7},
        "commands": {"type": "array", "minItems": 15},
        "artifacts": {"type": "array", "minItems": 1},
        "remote_actions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tagged", "published", "deployed", "merged"],
          "properties": {
            "tagged": {"const": false},
            "published": {"const": false},
            "deployed": {"const": false},
            "merged": {"const": false}
          }
        }
      }
    }
  }
}
