{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/application-install-generation@1",
  "title": "mainframe-env atomic application install generation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package", "version", "generation", "identity", "state", "selected"],
  "properties": {
    "schema_version": {"const": "mainframe-env.application-install-generation@1"},
    "package": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 1},
    "identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "state": {"enum": ["staged", "ready"]},
    "selected": {"type": "boolean"}
  },
  "allOf": [
    {"if": {"properties": {"selected": {"const": true}}}, "then": {"properties": {"state": {"const": "ready"}}}}
  ]
}
