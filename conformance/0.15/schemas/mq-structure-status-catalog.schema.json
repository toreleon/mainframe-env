{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/mq-structure-status-catalog.schema.json",
  "title": "mainframe-env IBM MQ MQI structure and status identity catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_version",
    "work_package",
    "baseline_id",
    "topic_manifest",
    "source_call_list",
    "unique_call_count",
    "verified_call_topic_count",
    "missing_call_topic_count",
    "identity_authority",
    "behavioral_coverage_credit",
    "licensed_execution_credit",
    "calls",
    "wire_options",
    "raw_layout"
  ],
  "properties": {
    "schema_version": {"const": "mainframe-env.mq-structure-status-catalog@2"},
    "target_version": {"const": "0.15.0"},
    "work_package": {"const": "MQ-1501.structure-status-catalog"},
    "baseline_id": {"const": "ibm-mq-9.4-mqi-2026-08-31"},
    "topic_manifest": {"$ref": "#/$defs/file-binding"},
    "source_call_list": {"$ref": "#/$defs/file-binding"},
    "unique_call_count": {"const": 26},
    "verified_call_topic_count": {"const": 26},
    "missing_call_topic_count": {"const": 0},
    "identity_authority": {"const": true},
    "behavioral_coverage_credit": {"const": 0},
    "licensed_execution_credit": {"const": 0},
    "wire_options": {"$ref": "#/$defs/wire-options"},
    "raw_layout": {"$ref": "#/$defs/raw-layout"},
    "calls": {
      "type": "array",
      "minItems": 26,
      "maxItems": 26,
      "items": {"$ref": "#/$defs/call"}
    }
  },
  "$defs": {
    "raw-locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic_path",
        "topic_sha256",
        "first_line",
        "last_line",
        "fragment_sha256"
      ],
      "properties": {
        "topic_path": {
          "type": "string",
          "pattern": "^SSFKSJ_9\\.4\\.0/refdev/q[0-9]+_\\.html$"
        },
        "topic_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "first_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000
        },
        "last_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000
        },
        "fragment_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "raw-initial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value",
        "source"
      ],
      "properties": {
        "kind": {
          "enum": [
            "long",
            "identifier",
            "blanks",
            "nulls",
            "environment"
          ]
        },
        "value": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "source": {
          "$ref": "#/$defs/raw-locator"
        }
      }
    },
    "raw-field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "width",
        "offset",
        "c_line",
        "cobol_line",
        "initial",
        "writeback",
        "writeback_source"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]+$"
        },
        "kind": {
          "enum": [
            "long",
            "characters",
            "bytes",
            "alias",
            "signal-slot"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 48
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 364
        },
        "c_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000
        },
        "cobol_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000
        },
        "initial": {
          "$ref": "#/$defs/raw-initial"
        },
        "writeback": {
          "enum": [
            "input",
            "get",
            "get-put",
            "dynamic-open",
            "put-count-other",
            "single-queue-put"
          ]
        },
        "writeback_source": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/raw-locator"
            }
          ]
        }
      }
    },
    "raw-layout-descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "family",
        "version",
        "identifier",
        "prefix_bytes",
        "c_declaration",
        "cobol_declaration",
        "fields"
      ],
      "properties": {
        "kind": {
          "enum": [
            "Od1",
            "Md1",
            "Md2",
            "Gmo1",
            "Pmo1"
          ]
        },
        "family": {
          "enum": [
            "MQOD",
            "MQMD",
            "MQGMO",
            "MQPMO"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "identifier": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4
        },
        "prefix_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 364
        },
        "c_declaration": {
          "$ref": "#/$defs/raw-locator"
        },
        "cobol_declaration": {
          "$ref": "#/$defs/raw-locator"
        },
        "fields": {
          "type": "array",
          "minItems": 7,
          "maxItems": 29,
          "items": {
            "$ref": "#/$defs/raw-field"
          }
        }
      }
    },
    "raw-layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "semantic_execution_credit",
        "historical_catalog_sha256",
        "wire_options_projection_sha256",
        "sources",
        "elementary",
        "integer_order",
        "structure_rules",
        "layouts",
        "identifier_sources",
        "signal_policy",
        "body_encoding_policy",
        "character_policy",
        "owned_character_table",
        "descriptor_output_policy"
      ],
      "properties": {
        "schema_version": {
          "const": "mainframe-env.mq-raw-layout-projection@1"
        },
        "semantic_execution_credit": {
          "const": 0
        },
        "historical_catalog_sha256": {
          "const": "3dc77d004bd79ad7f6daa99ffb4a3fb958ff1d816cb6c33bc4b6bac794a23448"
        },
        "wire_options_projection_sha256": {
          "const": "4d55b1d825762ff4319215185fb240513ab97b0b9b8ff25192b1b0bab12b9d1c"
        },
        "sources": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope_id",
              "baseline_id",
              "topic_manifest"
            ],
            "properties": {
              "scope_id": {
                "enum": [
                  "mq-programming-supplements",
                  "mq-point-layout-sources"
                ]
              },
              "baseline_id": {
                "type": "string",
                "maxLength": 100
              },
              "topic_manifest": {
                "$ref": "#/$defs/file-binding"
              }
            }
          }
        },
        "elementary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "long_bytes",
            "cobol_long_min",
            "cobol_long_max",
            "source"
          ],
          "properties": {
            "long_bytes": {
              "const": 4
            },
            "cobol_long_min": {
              "const": -999999999
            },
            "cobol_long_max": {
              "const": 999999999
            },
            "source": {
              "$ref": "#/$defs/raw-locator"
            }
          }
        },
        "integer_order": {
          "$ref": "#/$defs/raw-locator"
        },
        "structure_rules": {
          "$ref": "#/$defs/raw-locator"
        },
        "layouts": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/raw-layout-descriptor"
          }
        },
        "identifier_sources": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/raw-locator"
          }
        },
        "signal_policy": {
          "$ref": "#/$defs/raw-locator"
        },
        "body_encoding_policy": {
          "$ref": "#/$defs/raw-locator"
        },
        "character_policy": {
          "$ref": "#/$defs/raw-locator"
        },
        "owned_character_table": {
          "$ref": "#/$defs/file-binding"
        },
        "descriptor_output_policy": {
          "$ref": "#/$defs/raw-locator"
        }
      }
    }
,
    "wire-options": {
      "type": "object", "additionalProperties": false,
      "required": ["baseline_id", "scope_id", "topic_manifest", "historical_catalog_sha256", "semantic_execution_credit", "facts", "corroboration"],
      "properties": {
        "baseline_id": {"const": "ibm-mq-9.4-programming-supplements-2026-09-12"},
        "scope_id": {"const": "mq-programming-supplements"},
        "topic_manifest": {"$ref": "#/$defs/file-binding"},
        "historical_catalog_sha256": {"const": "3dc77d004bd79ad7f6daa99ffb4a3fb958ff1d816cb6c33bc4b6bac794a23448"},
        "semantic_execution_credit": {"const": 0},
        "facts": {"type": "array", "minItems": 102, "maxItems": 102, "uniqueItems": true, "items": {"$ref": "#/$defs/wire-fact"}},
        "corroboration": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/wire-locator"}}
      }
    },
    "wire-locator": {
      "type": "object", "additionalProperties": false,
      "required": ["topic_path", "topic_sha256", "first_line", "last_line", "fragment_sha256"],
      "properties": {
        "topic_path": {"type": "string", "pattern": "^SSFKSJ_9\\.4\\.0/refdev/q[0-9]+_\\.html$"},
        "topic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "first_line": {"type": "integer", "minimum": 1, "maximum": 1600},
        "last_line": {"type": "integer", "minimum": 1, "maximum": 1600},
        "fragment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "wire-fact": {
      "type": "object", "additionalProperties": false,
      "required": ["symbol", "decimal", "hexadecimal", "kind", "topic_path", "topic_sha256", "first_line", "last_line", "fragment_sha256"],
      "properties": {
        "symbol": {"type": "string", "pattern": "^MQ(?:OO|CO|GMO|PMO|MD|OD)_[A-Z0-9_]+$"},
        "decimal": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "hexadecimal": {"type": ["string", "null"], "pattern": "^[0-9A-Fa-f]{8}$"},
        "kind": {"enum": ["version", "option", "cpp-only"]},
        "topic_path": {"type": "string", "pattern": "^SSFKSJ_9\\.4\\.0/refdev/q[0-9]+_\\.html$"},
        "topic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "first_line": {"type": "integer", "minimum": 1, "maximum": 1600},
        "last_line": {"type": "integer", "minimum": 1, "maximum": 1600},
        "fragment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "file-binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 256},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "official_row",
        "label",
        "topic_path",
        "topic_sha256",
        "source_status",
        "signature_status",
        "parameters"
      ],
      "properties": {
        "official_row": {
          "type": "string",
          "pattern": "^ibm-mq-9\\.4-mqi-2026-08-31:mqi-calls-unique:[0-9]{4}$"
        },
        "label": {"type": "string", "pattern": "^MQ[A-Z0-9_]+$"},
        "topic_path": {
          "type": "string",
          "pattern": "^SSFKSJ_9\\.4\\.0/refdev/q[0-9]+_\\.html$"
        },
        "topic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_status": {"enum": ["verified", "missing"]},
        "signature_status": {"enum": ["source-verified", "pending-source"]},
        "parameters": {
          "type": "array",
          "maxItems": 16,
          "items": {"$ref": "#/$defs/parameter"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"source_status": {"const": "verified"}}},
          "then": {
            "properties": {
              "signature_status": {"const": "source-verified"},
              "parameters": {"minItems": 3}
            }
          }
        },
        {
          "if": {"properties": {"source_status": {"const": "missing"}}},
          "then": {
            "properties": {
              "signature_status": {"const": "pending-source"},
              "parameters": {"maxItems": 0}
            }
          }
        }
      ]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "name",
        "data_type",
        "direction",
        "roles"
      ],
      "properties": {
        "position": {"type": "integer", "minimum": 1, "maximum": 16},
        "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$"},
        "data_type": {"type": "string", "minLength": 2, "maxLength": 64},
        "direction": {"enum": ["input", "output", "input-output"]},
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "scalar",
              "name",
              "length",
              "data",
              "handle",
              "structure",
              "options",
              "selector",
              "completion",
              "reason"
            ]
          }
        },
        "symbolic_identities": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^MQ[A-Z0-9_]+$"}
        },
        "handle_role": {
          "type": ["string", "null"],
          "enum": ["connection", "object", "subscription", "message", null]
        },
        "handle_action": {
          "type": ["string", "null"],
          "enum": ["use", "create", "release", "use-or-create", null]
        },
        "structure_version_identity": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^MQ[A-Z0-9_]+_VERSION$"}
          ]
        },
        "source_spelling_anomaly": {
          "$ref": "#/$defs/source-spelling-anomaly"
        }
      }
    },
    "source-spelling-anomaly": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_topic_path",
        "source_topic_sha256",
        "source_line",
        "literal_data_type",
        "canonical_topic_path",
        "canonical_topic_sha256",
        "canonical_first_line",
        "canonical_last_line"
      ],
      "properties": {
        "source_topic_path": {"const": "SSFKSJ_9.4.0/refdev/q101710_.html"},
        "source_topic_sha256": {"const": "8a94879a9c9f2e18ddb2171b0dd5ea477ebaf26684a760c9e1e31931f2084156"},
        "source_line": {"const": 13},
        "literal_data_type": {"const": "MQHMQSG"},
        "canonical_topic_path": {"const": "SSFKSJ_9.4.0/refdev/q101780_.html"},
        "canonical_topic_sha256": {"const": "66cf482573408e227aec23ec2219cd52bf7bf879591f33acb04dc3f33fb386db"},
        "canonical_first_line": {"const": 37},
        "canonical_last_line": {"const": 49}
      }
    }
  }
}
