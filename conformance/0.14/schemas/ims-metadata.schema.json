{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/ims-metadata@1",
  "title": "mainframe-env IMS DBD and PSB metadata contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "databases",
    "psbs"
  ],
  "properties": {
    "schema_version": {
      "const": "mainframe-env.ims-metadata@1"
    },
    "databases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/database"
      }
    },
    "psbs": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/psb"
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]{1,8}$"
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "offset",
        "length",
        "sequence",
        "unique"
      ],
      "properties": {
        "name": {
          "oneOf": [
            {
              "$ref": "#/$defs/name"
            },
            {
              "type": "null"
            }
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 1
        },
        "sequence": {
          "type": "boolean"
        },
        "unique": {
          "type": "boolean"
        }
      },
      "x-ims-source-topics": [
        {
          "topic_path": "SSEPH2_15.6.0/com.ibm.ims156.doc.sur/ims_fieldstmt.htm",
          "sha256": "94455fbdc9d5f7404c89c0fd73a813fee237fb851fc0d2348a96ba1ce9d36fcb"
        }
      ]
    },
