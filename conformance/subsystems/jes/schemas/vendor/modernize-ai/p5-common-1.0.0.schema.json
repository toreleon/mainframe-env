{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.modernize.ai/p5-common/1.0.0",
  "title": "P5 shared runtime definitions",
  "$defs": {
    "sha256": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "artifactId": {"type":"string","pattern":"^art_sha256_[0-9a-f]{64}$"},
    "artifactRef": {
      "type":"object","additionalProperties":false,
      "required":["artifactId","artifactType","schemaVersion","envelopeDigest","payloadDigest"],
      "properties": {
        "artifactId":{"$ref":"#/$defs/artifactId"},
        "artifactType":{"type":"string","minLength":1,"maxLength":64},
        "schemaVersion":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "envelopeDigest":{"$ref":"#/$defs/sha256"},
        "payloadDigest":{"$ref":"#/$defs/sha256"}
      }
    },
    "digestRef": {
      "type":"object","additionalProperties":false,
      "required":["id","version","digest"],
      "properties": {
        "id":{"type":"string","minLength":1,"maxLength":160},
        "version":{"type":"string","minLength":1,"maxLength":80},
        "digest":{"$ref":"#/$defs/sha256"}
      }
    },
    "authority": {
      "enum":["authoritative-zos","customer-captured","calibrated-local","development-only","lab-simulated"]
    },
    "p5Authority": {
      "enum":["authoritative-zos","customer-captured","calibrated-local","development-only"]
    },
    "runnerRole":{"enum":["legacy-oracle","modern-candidate"]},
    "faultPhase":{"enum":["before-commit","after-durable-commit","before-result-export"]},
    "faultSchedule": {
      "type":"object","additionalProperties":false,
      "required":["boundaryId","phase","mode"],
      "properties": {
        "boundaryId":{"type":"string","pattern":"^[a-z0-9][a-z0-9.-]{0,79}$"},
        "phase":{"$ref":"#/$defs/faultPhase"},
        "mode":{"enum":["process-halt","supervisor-kill","transaction-failure"]}
      }
    },
    "runtimeProvenance": {
      "type":"object","additionalProperties":false,
      "required":["authority","executionManifestRef","runtimeContractRef","runnerBuildRef","runtimeRef","shimRef","policyRef","comparatorRegistryRef","codecProfileRef","packetRef","replayRef","stateSnapshotRef","graphRef","ruleCatalogRef","packRef"],
      "properties": {
        "authority":{"$ref":"#/$defs/p5Authority"},
        "executionManifestRef":{"$ref":"#/$defs/artifactRef"},
        "runtimeContractRef":{"$ref":"#/$defs/artifactRef"},
        "runnerBuildRef":{"$ref":"#/$defs/artifactRef"},
        "runtimeRef":{"$ref":"#/$defs/digestRef"},
        "shimRef":{"$ref":"#/$defs/artifactRef"},
        "policyRef":{"$ref":"#/$defs/artifactRef"},
        "comparatorRegistryRef":{"$ref":"#/$defs/digestRef"},
        "codecProfileRef":{"$ref":"#/$defs/digestRef"},
        "packetRef":{"$ref":"#/$defs/artifactRef"},
        "replayRef":{"$ref":"#/$defs/artifactRef"},
        "stateSnapshotRef":{"$ref":"#/$defs/artifactRef"},
        "graphRef":{"$ref":"#/$defs/artifactRef"},
        "ruleCatalogRef":{"$ref":"#/$defs/artifactRef"},
        "packRef":{"$ref":"#/$defs/artifactRef"}
      }
    },
    "runtimeTraceRecord": {
      "type":"object","additionalProperties":false,
      "required":["sequence","jobId","stepId","attempt","event","boundaryId","checkpointDigest","transactionId","transactionOutcome","sideEffectSetDigest","idempotencyKeyDigest","effectDisposition"],
      "properties": {
        "sequence":{"type":"integer","minimum":0,"maximum":9007199254740991},
        "jobId":{"type":"string","minLength":1,"maxLength":80},
        "stepId":{"type":"string","minLength":1,"maxLength":80},
        "attempt":{"type":"integer","minimum":1,"maximum":100},
        "event":{"enum":["job-start","step-start","checkpoint-declared","transaction-begin","effect-attempt","commit","rollback","checkpoint-advance","effect-reconciled","effect-deduplicated","step-complete","job-complete","abend"]},
        "boundaryId":{"type":["string","null"],"maxLength":80},
        "checkpointDigest":{"anyOf":[{"$ref":"#/$defs/sha256"},{"type":"null"}]},
        "transactionId":{"type":["string","null"],"maxLength":120},
        "transactionOutcome":{"enum":["not-applicable","pending","committed","rolled-back"]},
        "sideEffectSetDigest":{"anyOf":[{"$ref":"#/$defs/sha256"},{"type":"null"}]},
        "idempotencyKeyDigest":{"anyOf":[{"$ref":"#/$defs/sha256"},{"type":"null"}]},
        "effectDisposition":{"enum":["not-applicable","newly-applied","reconciled","deduplicated","rolled-back"]}
      }
    }
  }
}
