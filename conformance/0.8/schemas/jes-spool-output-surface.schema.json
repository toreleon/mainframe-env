{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/jes-spool-output-surface.schema.json",
  "title": "JES spool and output surface inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_version",
    "work_package",
    "authorities",
    "contracts",
    "capabilities",
    "routing",
    "bounds",
    "recovery",
    "non_claims"
  ],
  "properties": {
    "schema_version": {"const": "mainframe-env.jes-spool-output-inventory@1"},
    "target_version": {"const": "0.8.0"},
    "work_package": {"const": "JES-803"},
    "authorities": {"$ref": "#/$defs/nonEmptyStringMap"},
    "contracts": {"$ref": "#/$defs/boundedUniqueStrings"},
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "additionalProperties": {"$ref": "#/$defs/boundedUniqueStrings"}
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "selection", "jcl_sources", "authorized_controls"],
      "properties": {
        "identity": {"$ref": "#/$defs/boundedUniqueStrings"},
        "selection": {"$ref": "#/$defs/boundedUniqueStrings"},
        "jcl_sources": {"$ref": "#/$defs/boundedUniqueStrings"},
        "authorized_controls": {"$ref": "#/$defs/boundedUniqueStrings"}
      }
    },
    "bounds": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "recovery": {"$ref": "#/$defs/boundedUniqueStrings"},
    "non_claims": {"$ref": "#/$defs/boundedUniqueStrings"}
  },
  "$defs": {
    "boundedUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "nonEmptyStringMap": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 256}
    }
  }
}
