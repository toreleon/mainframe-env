{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/cobol-semantic-fixtures-v1.json",
  "title": "mainframe-env COBOL semantic clause conformance fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_version", "fixtures"],
  "properties": {
    "schema_version": {"const": "mainframe-env.cobol-semantic-fixtures@1"},
    "target_version": {"const": "0.3.0"},
    "fixtures": {"type": "array", "minItems": 27, "maxItems": 27, "items": {"$ref": "#/$defs/fixture"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 64},
    "row_id": {"type": "string", "pattern": "^ibm-enterprise-cobol-6\\.5-2026-05-31:[a-z-]+:[0-9]{4}$"},
    "case": {
      "type": "object", "additionalProperties": false, "required": ["declaration"],
      "properties": {"declaration": {"type": "string", "minLength": 1, "maxLength": 8192}}
    },
    "fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "row_id", "target_kind", "target_id", "valid", "invalid"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "row_id": {"$ref": "#/$defs/row_id"},
        "target_kind": {"enum": ["file-clause", "data-clause"]}, "target_id": {"$ref": "#/$defs/id"},
        "valid": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/case"}},
        "invalid": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/case"}}
      }
    }
  }
}
