{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/release-build-inputs@1",
  "title": "mainframe-env deterministic target release build inputs",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target", "rustc_verbose", "cargo_version", "profile", "profile_settings", "features", "locked", "cargo_lock_sha256", "source_digest", "path_remapping", "deterministic_environment", "linker_determinism"],
  "properties": {
    "schema_version": {"const": "mainframe-env.release-build-inputs@1"},
    "target": {"type": "string", "minLength": 1},
    "rustc_verbose": {"type": "string", "pattern": "^rustc 1\\.98\\.0"},
    "cargo_version": {"type": "string", "pattern": "^cargo 1\\.98\\.0"},
    "profile": {"const": "release"},
    "profile_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codegen_units", "debug", "incremental", "strip"],
      "properties": {
        "codegen_units": {"const": 1},
        "debug": {"const": 0},
        "incremental": {"const": false},
        "strip": {"const": "symbols"}
      }
    },
    "features": {"const": "all"},
    "locked": {"const": true},
    "cargo_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "path_remapping": {"type": "object"},
    "deterministic_environment": {"type": "object"},
    "linker_determinism": {"type": "string", "minLength": 1}
  }
}
