{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/full-regression@1",
  "title": "mainframe-env 0.2 unchanged-candidate full regression receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_version", "status", "candidate", "environment", "results", "workspace", "postgresql", "carddemo", "live_zowe", "release", "candidate_unchanged", "remote_actions"],
  "properties": {
    "schema_version": {"const": "mainframe-env.full-regression@1"},
    "target_version": {"const": "0.2.0"},
    "status": {"const": "pass"},
    "candidate": {
      "type": "object",
      "required": ["source_digest", "work_package_base_commit", "accepted_release_commit", "accepted_release_tree", "accepted_carddemo_commit", "accepted_carddemo_tree"],
      "properties": {
        "source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "work_package_base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "accepted_release_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "accepted_release_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "accepted_carddemo_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "accepted_carddemo_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "environment": {"type": "object"},
    "results": {"type": "array", "minItems": 12},
    "workspace": {"type": "object"},
    "postgresql": {"type": "object"},
    "carddemo": {"type": "object"},
    "live_zowe": {"type": "object"},
    "release": {"type": "object"},
    "candidate_unchanged": {"const": true},
    "remote_actions": {
      "type": "object",
      "required": ["tagged", "published", "deployed", "merged"],
      "properties": {
        "tagged": {"const": false},
        "published": {"const": false},
        "deployed": {"const": false},
        "merged": {"const": false}
      }
    }
  }
}
