{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/cics-command-source-map@1",
  "title": "CICS command-summary projection and zero-credit source mapping",
  "description": "Strict schemas for bounded IBM CICS TOC projections and zero-credit application, SPI and FEPI row-to-topic maps. No artifact grants grammar, execution or licensed coverage.",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/toc-projection"
    },
    {
      "$ref": "#/$defs/source-map"
    },
    {
      "$ref": "#/$defs/administrative-projection"
    },
    {
      "$ref": "#/$defs/administrative-source-map"
    },
    {
      "$ref": "#/$defs/command-form-locators"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "topic-path": {
      "type": "string",
      "pattern": "^SSJL4D_6\\.x/reference-applications/commands-(api|bts)/[A-Za-z0-9_-]+\\.html$"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "topic_path",
        "topic_id"
      ],
      "properties": {
        "label": {
          "const": "CICS command summary"
        },
        "topic_path": {
          "const": "SSJL4D_6.x/reference-applications/commands-api/dfhp4_commandsummary.html"
        },
        "topic_id": {
          "const": "reference-cics-command-summary"
        }
      }
    },
    "projected-topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "label",
        "topic_path",
        "topic_id"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 345
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "topic_path": {
          "$ref": "#/$defs/topic-path"
        },
        "topic_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "maxLength": 200
        }
      }
    },
    "toc-projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "target_version",
        "source_toc_url",
        "source_toc_sha256",
        "retained_source_bytes",
        "coverage_credit",
        "summary",
        "topic_count",
        "projection_digest_definition",
        "projection_sha256",
        "topics"
      ],
      "properties": {
        "schema_version": {
          "const": "mainframe-env.cics-command-summary-topics@1"
        },
        "target_version": {
          "const": "0.9.0"
        },
        "source_toc_url": {
          "const": "https://www.ibm.com/docs/api/v1/toc/cics-ts/6.x?lang=en"
        },
        "source_toc_sha256": {
          "const": "sha256:f65c51e52facc390c05f084e1d249ff19e68bf2d7f8d3f32d4d745faf622681a"
        },
        "retained_source_bytes": {
          "const": false
        },
        "coverage_credit": {
          "const": 0
        },
        "summary": {
          "$ref": "#/$defs/summary"
        },
        "topic_count": {
          "const": 345
        },
        "projection_digest_definition": {
          "const": "SHA-256 over ASCII domain mainframe-env.cics-command-summary-topics@1, one NUL byte (0x00), then UTF-8 JSON with ensure_ascii=true, sort_keys=true and separators=(',', ':') of source_toc_sha256, summary, and ordered topics"
        },
        "projection_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "topics": {
          "type": "array",
          "minItems": 345,
          "maxItems": 345,
          "items": {
            "$ref": "#/$defs/projected-topic"
          }
        }
      }
    },
    "topic-reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic_path",
        "topic_id",
        "toc_label",
        "role"
      ],
      "properties": {
        "topic_path": {
          "$ref": "#/$defs/topic-path"
        },
        "topic_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "maxLength": 200
        },
        "toc_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "role": {
          "enum": [
            "primary",
            "variant",
            "shared",
            "combined",
            "alias"
          ]
        }
      }
    },
    "mapping-row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "official_row",
        "label",
        "eibfn",
        "state",
        "selection_kind",
        "rationale",
        "topics"
      ],
      "properties": {
        "official_row": {
          "type": "string",
          "pattern": "^ibm-cics-ts-6x-2026-08-31:api-commands:[0-9]{4}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "eibfn": {
          "type": "string",
          "pattern": "^[0-9A-F]{4}$"
        },
        "state": {
          "enum": [
            "mapped",
            "source-gap"
          ]
        },
        "selection_kind": {
          "enum": [
            "exact",
            "variant-set",
            "shared-page",
            "combined-page",
            "aliased-page",
            "source-gap"
          ]
        },
        "rationale": {
          "enum": [
            "exact-toc-label",
            "qualified-variant-set",
            "shared-command-form",
            "combined-command-page",
            "catalog-label-alias",
            "no-command-summary-node"
          ]
        },
        "topics": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/topic-reference"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "selection_kind": {
                "const": "source-gap"
              }
            },
            "required": [
              "selection_kind"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "const": "source-gap"
              },
              "rationale": {
                "const": "no-command-summary-node"
              },
              "topics": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "state": {
                "const": "mapped"
              },
              "topics": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "selection_kind": {
                "const": "exact"
              }
            },
            "required": [
              "selection_kind"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "const": "mapped"
              },
              "rationale": {
                "const": "exact-toc-label"
              },
              "topics": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "const": "primary"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "selection_kind": {
                "const": "variant-set"
              }
            },
            "required": [
              "selection_kind"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "const": "mapped"
              },
              "rationale": {
                "const": "qualified-variant-set"
              },
              "topics": {
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "const": "variant"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "selection_kind": {
                "const": "aliased-page"
              }
            },
            "required": [
              "selection_kind"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "const": "mapped"
              },
              "rationale": {
                "const": "catalog-label-alias"
              },
              "topics": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "const": "alias"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "selection_kind": {
                "const": "shared-page"
              }
            },
            "required": [
              "selection_kind"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "const": "mapped"
              },
              "rationale": {
                "const": "shared-command-form"
              },
              "topics": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "const": "shared"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "selection_kind": {
                "const": "combined-page"
              }
            },
            "required": [
              "selection_kind"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "const": "mapped"
              },
              "rationale": {
                "const": "combined-command-page"
              },
              "topics": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "const": "combined"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "catalog-binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptor_path",
        "descriptor_sha256",
        "official_catalog_sha256",
        "application_identity_set_sha256"
      ],
      "properties": {
        "descriptor_path": {
          "const": "conformance/0.9/cics/command-descriptors.json"
        },
        "descriptor_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "official_catalog_sha256": {
          "const": "sha256:fccd2a8e5cc24dd08aeb32754daf14ed80e9f1b20b5d9e762a1b0cfe429ceeba"
        },
        "application_identity_set_sha256": {
          "const": "sha256:a18057164564781563252d53586a8afbc401f2783950db456b3b98177fc60b94"
        }
      }
    },
    "toc-binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "source_toc_sha256",
        "projection_sha256",
        "summary_topic_path"
      ],
      "properties": {
        "path": {
          "const": "conformance/0.9/cics/command-summary-topics.json"
        },
        "source_toc_sha256": {
          "const": "sha256:f65c51e52facc390c05f084e1d249ff19e68bf2d7f8d3f32d4d745faf622681a"
        },
        "projection_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "summary_topic_path": {
          "const": "SSJL4D_6.x/reference-applications/commands-api/dfhp4_commandsummary.html"
        }
      }
    },
    "row-range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first",
        "last",
        "count"
      ],
      "properties": {
        "first": {
          "type": "string",
          "pattern": "^ibm-cics-ts-6x-2026-08-31:api-commands:[0-9]{4}$"
        },
        "last": {
          "type": "string",
          "pattern": "^ibm-cics-ts-6x-2026-08-31:api-commands:[0-9]{4}$"
        },
        "count": {
          "type": "integer",
          "minimum": 87,
          "maximum": 88
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "resolved_row_count",
        "source_gap_count",
        "edge_count",
        "unique_topic_count",
        "multi_topic_row_count",
        "shared_topic_count",
        "selection_kind_counts"
      ],
      "properties": {
        "row_count": {
          "type": "integer",
          "minimum": 87,
          "maximum": 88
        },
        "resolved_row_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 88
        },
        "source_gap_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 88
        },
        "edge_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "unique_topic_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 345
        },
        "multi_topic_row_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 88
        },
        "shared_topic_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 345
        },
        "selection_kind_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exact",
            "variant-set",
            "shared-page",
            "combined-page",
            "source-gap"
          ],
          "properties": {
            "exact": {
              "type": "integer",
              "minimum": 0,
              "maximum": 88
            },
            "variant-set": {
              "type": "integer",
              "minimum": 0,
              "maximum": 88
            },
            "shared-page": {
              "type": "integer",
              "minimum": 0,
              "maximum": 88
            },
            "combined-page": {
              "type": "integer",
              "minimum": 0,
              "maximum": 88
            },
            "aliased-page": {
              "type": "integer",
              "minimum": 0,
              "maximum": 88
            },
            "source-gap": {
              "type": "integer",
              "minimum": 0,
              "maximum": 88
            }
          }
        }
      }
    },
    "source-map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "target_version",
        "work_package",
        "status",
        "semantic_authority",
        "automatic_registration",
        "coverage_credit",
        "differential_credit",
        "catalog",
        "toc_projection",
        "row_range",
        "counts",
        "mapping_digest_definition",
        "mapping_sha256",
        "rows"
      ],
      "properties": {
        "schema_version": {
          "const": "mainframe-env.cics-command-source-map@1"
        },
        "target_version": {
          "const": "0.9.0"
        },
        "work_package": {
          "enum": [
            "CIC-901.sources-a-map",
            "CIC-901.sources-b-map",
            "CIC-901.sources-c-map"
          ]
        },
        "status": {
          "const": "candidate"
        },
        "semantic_authority": {
          "const": false
        },
        "automatic_registration": {
          "const": false
        },
        "coverage_credit": {
          "const": 0
        },
        "differential_credit": {
          "const": 0
        },
        "catalog": {
          "$ref": "#/$defs/catalog-binding"
        },
        "toc_projection": {
          "$ref": "#/$defs/toc-binding"
        },
        "row_range": {
          "$ref": "#/$defs/row-range"
        },
        "counts": {
          "$ref": "#/$defs/counts"
        },
        "mapping_digest_definition": {
          "const": "SHA-256 over ASCII domain mainframe-env.cics-command-source-map@1, one NUL byte (0x00), then UTF-8 JSON with ensure_ascii=true, sort_keys=true and separators=(',', ':') of catalog, toc_projection, row_range, and ordered rows"
        },
        "mapping_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "rows": {
          "type": "array",
          "minItems": 87,
          "maxItems": 88,
          "items": {
            "$ref": "#/$defs/mapping-row"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "work_package": {
                "const": "CIC-901.sources-a-map"
              }
            },
            "required": [
              "work_package"
            ]
          },
          "then": {
            "properties": {
              "row_range": {
                "properties": {
                  "first": {
                    "const": "ibm-cics-ts-6x-2026-08-31:api-commands:0001"
                  },
                  "last": {
                    "const": "ibm-cics-ts-6x-2026-08-31:api-commands:0088"
                  },
                  "count": {
                    "const": 88
                  }
                }
              },
              "rows": {
                "minItems": 88,
                "maxItems": 88
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "work_package": {
                "const": "CIC-901.sources-b-map"
              }
            },
            "required": [
              "work_package"
            ]
          },
          "then": {
            "properties": {
              "row_range": {
                "properties": {
                  "first": {
                    "const": "ibm-cics-ts-6x-2026-08-31:api-commands:0089"
                  },
                  "last": {
                    "const": "ibm-cics-ts-6x-2026-08-31:api-commands:0176"
                  },
                  "count": {
                    "const": 88
                  }
                }
              },
              "rows": {
                "minItems": 88,
                "maxItems": 88
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "work_package": {
                "const": "CIC-901.sources-c-map"
              }
            },
            "required": [
              "work_package"
            ]
          },
          "then": {
            "properties": {
              "row_range": {
                "properties": {
                  "first": {
                    "const": "ibm-cics-ts-6x-2026-08-31:api-commands:0177"
                  },
                  "last": {
                    "const": "ibm-cics-ts-6x-2026-08-31:api-commands:0263"
                  },
                  "count": {
                    "const": 87
                  }
                }
              },
              "rows": {
                "minItems": 87,
                "maxItems": 87
              }
            }
          }
        }
      ]
    },
    "administrative-topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic_path",
        "topic_id",
        "toc_label",
        "heading_id",
        "heading_label",
        "sha256",
        "bytes"
      ],
      "properties": {
        "topic_path": {
          "type": "string",
          "pattern": "^SSJL4D_6\\.x/reference-(system-programming/commands-spi|applications/commands-fepi)/[A-Za-z0-9_.-]+\\.html$"
        },
        "topic_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "toc_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "heading_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "heading_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        }
      }
    },
    "administrative-projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "target_version",
        "family",
        "source_toc_url",
        "source_toc_sha256",
        "branches",
        "manifest",
        "manifest_sha256",
        "topic_manifest_sha256",
        "semantic_authority",
        "coverage_credit",
        "retained_source_bytes",
        "topic_count",
        "topics",
        "projection_digest_definition",
        "projection_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "mainframe-env.cics-command-topic-projection@1"
        },
        "target_version": {
          "const": "0.10.0"
        },
        "family": {
          "enum": [
            "spi",
            "fepi"
          ]
        },
        "source_toc_url": {
          "const": "https://www.ibm.com/docs/api/v1/toc/cics-ts/6.x?lang=en"
        },
        "source_toc_sha256": {
          "const": "sha256:f65c51e52facc390c05f084e1d249ff19e68bf2d7f8d3f32d4d745faf622681a"
        },
        "branches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "manifest": {
          "enum": [
            "conformance/0.10/manifests/cics-spi-command-topics.json",
            "conformance/0.10/manifests/cics-fepi-command-topics.json"
          ]
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "topic_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "semantic_authority": {
          "const": false
        },
        "coverage_credit": {
          "const": 0
        },
        "retained_source_bytes": {
          "const": false
        },
        "topic_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 277
        },
        "topics": {
          "type": "array",
          "minItems": 36,
          "maxItems": 277,
          "items": {
            "$ref": "#/$defs/administrative-topic"
          }
        },
        "projection_digest_definition": {
          "const": "SHA-256 over ASCII domain mainframe-env.cics-command-topic-projection@1, one NUL byte, then canonical UTF-8 JSON (ensure_ascii=true, sort_keys=true, separators=(',', ':')) excluding projection_sha256 and projection_digest_definition"
        },
        "projection_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "family": {
                "const": "spi"
              }
            }
          },
          "then": {
            "properties": {
              "branches": {
                "const": [
                  "SSJL4D_6.x/reference-system-programming/commands-spi/dfha81j.html"
                ]
              },
              "manifest": {
                "const": "conformance/0.10/manifests/cics-spi-command-topics.json"
              },
              "topic_count": {
                "const": 277
              },
              "topics": {
                "type": "array",
                "minItems": 277,
                "maxItems": 277,
                "items": {
                  "$ref": "#/$defs/administrative-topic"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "fepi"
              }
            }
          },
          "then": {
            "properties": {
              "branches": {
                "const": [
