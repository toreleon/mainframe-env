{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/jes-program-registration@1",
  "title": "mainframe-env JES typed program registration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "program", "disposition", "handler"],
  "properties": {
    "schema_version": {"const": "mainframe-env.jes-utility-registry@1"},
    "program": {"type": "string", "pattern": "^[A-Z0-9@$#_-]{1,128}$"},
    "disposition": {
      "type": ["string", "null"],
      "enum": [null, "implemented", "cics-file-control", "network-ftp", "report-rexx", "db2-tso", "ims-controller"]
    },
    "handler": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"enum": ["program-service", "sdsf", "db2-tso", "ims-controller", "unsupported"]}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "handler"],
          "properties": {
            "kind": {"const": "utility"},
            "handler": {"enum": ["iefbr14", "iebgener", "iebcopy", "iebcompr", "iebdg", "iebedit", "iebupdte", "idcams", "sort"]}
          }
        }
      ]
    }
  }
}
