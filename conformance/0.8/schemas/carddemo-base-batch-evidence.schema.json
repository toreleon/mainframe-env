{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/carddemo-base-batch-evidence.schema.json",
  "title": "Versioned CardDemo base-batch exact receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_version",
    "supersedes",
    "historical_receipt_rewritten",
    "transition_justification",
    "evidence_digest",
    "receipt"
  ],
  "properties": {
    "schema_version": {"const": "mainframe-env.carddemo-base-batch-version-evidence@1"},
    "target_version": {"const": "0.8.0"},
    "supersedes": {"const": "conformance/0.1.1/evidence/issues/CD-023.json"},
    "historical_receipt_rewritten": {"const": false},
    "transition_justification": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "corpus_commit",
        "business_date",
        "journeys_passed",
        "initialization_jobs",
        "operational_jobs",
        "cics_file_controls",
        "internal_submissions",
        "warm_restart_controls",
        "rollback_controls",
        "cancellation_controls",
        "tranrept_selected_records",
        "tranrept_report_records",
        "dataset_sha256",
        "spool_sha256",
        "journey_shape_sha256"
      ],
      "properties": {
        "schema_version": {"const": "mainframe-env.carddemo-base-batch-receipt@1"},
        "status": {"const": "pass"},
        "corpus_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "business_date": {"const": "2022-07-06"},
        "journeys_passed": {"type": "integer", "minimum": 1},
        "initialization_jobs": {"type": "integer", "minimum": 1},
        "operational_jobs": {"type": "integer", "minimum": 1},
        "cics_file_controls": {"type": "integer", "minimum": 1},
        "internal_submissions": {"type": "integer", "minimum": 1},
        "warm_restart_controls": {"type": "integer", "minimum": 1},
        "rollback_controls": {"type": "integer", "minimum": 1},
        "cancellation_controls": {"type": "integer", "minimum": 1},
        "tranrept_selected_records": {"type": "integer", "minimum": 1},
        "tranrept_report_records": {"type": "integer", "minimum": 1},
        "dataset_sha256": {"$ref": "#/$defs/digestMap"},
        "spool_sha256": {"$ref": "#/$defs/digestMap"},
        "journey_shape_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "$defs": {
    "digestMap": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 4096,
      "propertyNames": {"type": "string", "minLength": 1, "maxLength": 128},
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }
  }
}
