    "secondary_index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "target_segment",
        "source_segment",
        "source_fields"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "target_segment": {
          "$ref": "#/$defs/name"
