{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.example/schemas/jcl-path-gate-map.schema.json",
  "title": "JCL affected path and contract gate map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_version", "default_policy", "mappings"],
  "properties": {
    "schema_version": {"const": "mainframe-env.jcl-path-gate-map@1"},
    "target_version": {"const": "0.7.0"},
    "default_policy": {"const": "fail-closed"},
    "mappings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "affected_path_patterns", "contracts", "required_gates"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
          "affected_path_patterns": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "contracts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "required_gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
