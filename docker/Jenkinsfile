pipeline {
    agent any
    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '5', artifactNumToKeepStr: '2'))
        timeout(time: 60, unit: 'MINUTES')
    }
    triggers { pollSCM('H/5 * * * *') }
    parameters {
        choice(name: 'CHECK_MODE', choices: ['auto', 'runtime'],
               description: 'auto narrows prose-only changes since the last successful build; runtime always checks all local runtime gates. Full assurance remains in the root Jenkinsfile.')
    }
    environment {
        MAINFRAME_ENV_CI_CHECK_MODE = "${params.CHECK_MODE ?: 'auto'}"
    }
    stages {
        stage('Checkout main') {
            steps {
                sh 'flock /cache/build.lock sh -c "rm -rf /target/ci-assurance /target/ci-backend"'
                deleteDir()
                checkout([$class: 'GitSCM',
                    branches: [[name: "*/${env.MAINFRAME_ENV_CI_BRANCH}"]],
                    userRemoteConfigs: [[url: env.MAINFRAME_ENV_CI_REPOSITORY,
                        credentialsId: env.MAINFRAME_ENV_CI_REPOSITORY == 'https://github.com/toreleon/mainframe-env.git'
                            ? env.MAINFRAME_ENV_CI_CREDENTIAL_ID : '']]])
                sh 'git rev-parse HEAD'
            }
        }
        stage('Storage and checks') {
            options { timeout(time: 30, unit: 'MINUTES') }
            steps {
                sh 'flock /cache/build.lock /opt/mainframe-env/docker/ci.sh check'
                script {
                    env.CI_RUNTIME_REQUIRED = sh(
                        script: 'python3 -B docker/ci_plan.py build-required',
                        returnStdout: true
                    ).trim()
                }
            }
        }
        stage('Build deployable binary') {
            when { expression { env.CI_RUNTIME_REQUIRED == 'true' } }
            options { timeout(time: 15, unit: 'MINUTES') }
            steps {
                sh 'flock /cache/build.lock /opt/mainframe-env/docker/ci.sh build'
            }
        }
        stage('Deploy local main') {
            when { expression { env.CI_RUNTIME_REQUIRED == 'true' } }
            options { timeout(time: 3, unit: 'MINUTES') }
            steps {
                sh 'python3 /opt/mainframe-env/docker/deploy.py deploy'
            }
        }
    }
    post {
        always {
            sh(returnStatus: true, script: 'mkdir -p ci-backend ci-checks; cp /target/ci-backend/*.json ci-backend/ 2>/dev/null || true; cp /target/ci-assurance/*.json /target/ci-assurance/*.log ci-checks/ 2>/dev/null || true')
            archiveArtifacts artifacts: 'deployment.json,ci-checks/*,ci-backend/*.json,.postgres/postgres.log', allowEmptyArchive: true
            sh(returnStatus: true, script: 'flock /cache/build.lock /opt/mainframe-env/docker/ci.sh maintain')
            deleteDir()
        }
    }
}
