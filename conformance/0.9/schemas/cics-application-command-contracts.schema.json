{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/cics-application-command-contracts@1",
  "title": "Generated CICS application command contract batches",
  "description": "A zero-credit 263-row scaffold that carries source-projected facts without registering or claiming implementation for any command.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_version",
    "work_package",
    "status",
    "automatic_registration",
    "semantic_authority",
    "coverage_credit",
    "semantic_credit",
    "differential_credit",
    "inputs",
    "contract_dimensions",
    "counts",
    "batches",
    "contract_sha256"
  ],
  "properties": {
    "schema_version": {"const": "mainframe-env.cics-application-command-contracts@1"},
    "target_version": {"const": "0.9.0"},
    "work_package": {"const": "CIC-901.command-contract"},
    "status": {"const": "generated-scaffold"},
    "automatic_registration": {"const": false},
    "semantic_authority": {"const": false},
    "coverage_credit": {"const": 0},
    "semantic_credit": {"const": 0},
    "differential_credit": {"const": 0},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_descriptors"],
      "properties": {
        "command_descriptors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "file_sha256", "application_identity_set_sha256"],
          "properties": {
            "path": {"const": "conformance/0.9/cics/command-descriptors.json"},
            "file_sha256": {"$ref": "#/$defs/sha256"},
            "application_identity_set_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "contract_dimensions": {
      "const": [
        "grammar",
        "option-legality",
        "operand-direction",
        "option-bounds",
        "resource-key",
        "capability-intent",
        "eib-response",
        "conditions",
        "context-applicability",
        "effect-class",
        "cancellation",
        "audit",
        "recovery"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batches",
        "commands",
        "source_projected_commands",
        "source_reviewed_commands",
        "source_ambiguous_commands",
        "source_verified_candidates",
        "source_ambiguous_candidates",
        "source_fact_groups",
        "source_candidate_references",
        "implemented_commands",
        "registered_commands"
      ],
      "properties": {
        "batches": {"const": 3},
        "commands": {"const": 263},
        "source_projected_commands": {"type": "integer", "minimum": 0, "maximum": 263},
        "source_reviewed_commands": {"type": "integer", "minimum": 0, "maximum": 263},
        "source_ambiguous_commands": {"type": "integer", "minimum": 0, "maximum": 263},
        "source_verified_candidates": {"type": "integer", "minimum": 0},
        "source_ambiguous_candidates": {"type": "integer", "minimum": 0},
        "source_fact_groups": {"type": "integer", "minimum": 0},
        "source_candidate_references": {"type": "integer", "minimum": 0},
        "implemented_commands": {"const": 23},
        "registered_commands": {"const": 23}
      }
    },
    "batches": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/batch"},
            {
              "properties": {
                "batch_id": {"const": "sources-a"},
                "ordinal_start": {"const": 1},
                "ordinal_end": {"const": 88},
                "command_count": {"const": 88},
                "commands": {"minItems": 88, "maxItems": 88}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/batch"},
            {
              "properties": {
                "batch_id": {"const": "sources-b"},
                "ordinal_start": {"const": 89},
                "ordinal_end": {"const": 176},
                "command_count": {"const": 88},
                "commands": {"minItems": 88, "maxItems": 88}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/batch"},
            {
              "properties": {
                "batch_id": {"const": "sources-c"},
                "ordinal_start": {"const": 177},
                "ordinal_end": {"const": 263},
                "command_count": {"const": 87},
                "commands": {"minItems": 87, "maxItems": 87}
              }
            }
          ]
        }
      ],
      "items": false
    },
    "contract_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "file-binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "file_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "review-binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256", "review_status"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "review_status": {
          "enum": [
            "auto-accepted",
            "auto-accepted-with-bounded-ambiguities",
            "blocked",
            "stale"
          ]
        }
      }
    },
    "source-input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection", "review"],
      "properties": {
        "projection": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/file-binding"}
          ]
        },
        "review": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/review-binding"}
          ]
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "candidate_ids"],
      "properties": {
        "value": {"type": "object", "minProperties": 1},
        "candidate_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^cics-[abc]-[0-9]{4}-[a-z-]+-[0-9a-f]{12}$"}
        }
      }
    },
    "source-dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source_projection_state",
        "verification_status",
        "facts",
        "issue_ids"
      ],
      "properties": {
        "name": {
          "enum": [
            "grammar",
            "option-legality",
            "operand-direction",
            "conditions",
            "context-applicability"
          ]
        },
        "source_projection_state": {
          "enum": [
            "not-projected",
            "projected",
            "declared-absent",
            "source-backed-not-applicable",
            "source-gap",
            "unmatched",
            "conflicting"
          ]
        },
        "verification_status": {
          "enum": [
            "not-projected",
            "verified",
            "verified-absent",
            "not-applicable",
            "verified-with-bounded-ambiguity",
            "projected-unverified",
            "projected-absent-unverified",
            "projected-not-applicable-unverified",
            "source-gap",
            "unmatched",
            "ambiguous"
          ]
        },
        "facts": {
          "type": "array",
          "items": {"$ref": "#/$defs/fact"}
        },
        "issue_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "official_row",
        "label",
        "eibfn",
        "source_status",
        "implementation_status",
        "registration_status",
        "existing_runtime_operation",
        "source_dimensions",
        "unresolved_dimensions",
        "source_issue_ids"
      ],
      "properties": {
        "official_row": {
          "type": "string",
          "pattern": "^ibm-cics-ts-6x-2026-08-31:api-commands:[0-9]{4}$"
        },
        "label": {"type": "string", "minLength": 2},
        "eibfn": {"type": "string", "pattern": "^[0-9A-F]{4}$"},
        "source_status": {
          "enum": [
            "not-projected",
            "projected-unreviewed",
            "stale-review",
            "blocked-review",
            "bounded-ambiguity",
            "verified"
          ]
        },
        "implementation_status": {"enum": ["existing-runtime", "unimplemented"]},
        "registration_status": {"enum": ["existing-runtime", "unregistered"]},
        "existing_runtime_operation": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$"}
          ]
        },
        "source_dimensions": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {"$ref": "#/$defs/source-dimension"}
        },
        "unresolved_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "grammar",
              "option-legality",
              "operand-direction",
              "option-bounds",
              "resource-key",
              "capability-intent",
              "eib-response",
              "conditions",
              "context-applicability",
              "effect-class",
              "cancellation",
              "audit",
              "recovery"
            ]
          }
        },
        "source_issue_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "ordinal_start",
        "ordinal_end",
        "command_count",
        "source_input",
        "commands"
      ],
      "properties": {
        "batch_id": {"enum": ["sources-a", "sources-b", "sources-c"]},
        "ordinal_start": {"type": "integer", "minimum": 1, "maximum": 263},
        "ordinal_end": {"type": "integer", "minimum": 1, "maximum": 263},
        "command_count": {"type": "integer", "minimum": 1, "maximum": 263},
        "source_input": {"$ref": "#/$defs/source-input"},
        "commands": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/command"}
        }
      }
    }
  }
}
