        "direction_status": {"enum": ["resolved", "bounded-ambiguity"]},
        "source_stacks": {"type": "array", "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}},
        "bound_status": {"enum": ["resolved", "not-applicable", "bounded-ambiguity"]},
        "source_max_value_bytes": {"$ref": "#/$defs/nullable-nonnegative-integer"},
        "host_max_value_bytes": {"type": "integer", "minimum": 0, "maximum": 1048576}
      }
    },
    "option-alternative": {
