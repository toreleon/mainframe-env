{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/mq-licensed-differential-receipt@1",
  "title": "External IBM MQ 9.4 licensed-differential receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_version",
    "work_package",
    "source_identity",
    "licensed_service",
    "authorization",
    "candidate",
    "contract",
    "runners",
    "observations",
    "attestation"
  ],
  "properties": {
    "schema_version": {"const": "mainframe-env.mq-licensed-differential-receipt@1"},
    "target_version": {"const": "0.15.0"},
    "work_package": {"const": "MQ-1506.licensed-harness-contract"},
    "source_identity": {"$ref": "#/$defs/sourceIdentity"},
    "licensed_service": {"$ref": "#/$defs/licensedService"},
    "authorization": {"$ref": "#/$defs/authorization"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "contract": {"$ref": "#/$defs/contract"},
    "runners": {"$ref": "#/$defs/runners"},
    "observations": {
      "type": "array",
      "minItems": 26,
      "maxItems": 26,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/caseObservation"}
    },
    "attestation": {"$ref": "#/$defs/attestation"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "gitIdentity": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_.:@+/-]+$"
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_id",
        "unit",
        "documentation_product",
        "official_catalog_sha256",
        "source_manifest_sha256",
        "topic_manifest_sha256",
        "toc_sha256",
        "source_call_list_sha256",
        "call_list_topic_sha256",
        "unique_call_count",
        "source_row_count"
      ],
      "properties": {
        "baseline_id": {"const": "ibm-mq-9.4-mqi-2026-08-31"},
        "unit": {"const": "mqi-calls-unique"},
        "documentation_product": {"const": "SSFKSJ_9.4.0"},
        "official_catalog_sha256": {"$ref": "#/$defs/digest"},
        "source_manifest_sha256": {"$ref": "#/$defs/digest"},
        "topic_manifest_sha256": {"$ref": "#/$defs/digest"},
        "toc_sha256": {"$ref": "#/$defs/digest"},
        "source_call_list_sha256": {"$ref": "#/$defs/digest"},
        "call_list_topic_sha256": {"$ref": "#/$defs/digest"},
        "unique_call_count": {"const": 26},
        "source_row_count": {"const": 27}
      }
    },
    "licensedService": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_name",
        "major_minor",
        "vrmf",
        "command_level",
        "build_id",
        "installation_digest"
      ],
      "properties": {
        "product_name": {"const": "IBM MQ"},
        "major_minor": {"const": "9.4"},
        "vrmf": {
          "type": "string",
          "pattern": "^9\\.4\\.[0-9]{1,3}\\.[0-9]{1,3}$",
          "maxLength": 16
        },
        "command_level": {"type": "integer", "minimum": 940, "maximum": 999},
        "build_id": {"$ref": "#/$defs/id"},
        "installation_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorized",
        "authority",
        "grant_id",
        "grant_digest",
        "environment_manifest_digest",
        "capabilities"
      ],
      "properties": {
        "authorized": {"const": true},
        "authority": {"const": "licensed-environment-controller"},
        "grant_id": {"$ref": "#/$defs/id"},
        "grant_digest": {"$ref": "#/$defs/digest"},
        "environment_manifest_digest": {"$ref": "#/$defs/digest"},
        "capabilities": {
          "type": "array",
          "minItems": 31,
          "maxItems": 31,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_sha", "tree_sha", "tracked_worktree_clean"],
      "properties": {
        "commit_sha": {"$ref": "#/$defs/gitIdentity"},
        "tree_sha": {"$ref": "#/$defs/gitIdentity"},
        "tracked_worktree_clean": {"const": true}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_digest",
        "verifier_digest",
        "fixture_contract_digest",
        "fixture_bundle_digest",
        "normalization_policy",
        "runner_protocol"
      ],
      "properties": {
        "spec_digest": {"$ref": "#/$defs/digest"},
        "verifier_digest": {"$ref": "#/$defs/digest"},
        "fixture_contract_digest": {"$ref": "#/$defs/digest"},
        "fixture_bundle_digest": {"$ref": "#/$defs/digest"},
        "normalization_policy": {"const": "mq-normalized-observation@1"},
        "runner_protocol": {"const": "mainframe-env.mq-licensed-runner@1"}
      }
    },
    "runners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "oracle"],
      "properties": {
        "product": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "route", "digest", "native_ibm_fallback"],
          "properties": {
            "kind": {"const": "mainframe-env-owned"},
            "route": {"const": "owned-mq-provider"},
            "digest": {"$ref": "#/$defs/digest"},
            "native_ibm_fallback": {"const": false}
          }
        },
        "oracle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "route", "digest"],
          "properties": {
            "kind": {"const": "licensed-ibm-mq"},
            "route": {"const": "licensed-mqi-adapter"},
            "digest": {"$ref": "#/$defs/digest"}
          }
        }
      }
    },
    "caseObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "row_id",
        "call",
        "source_topic_path",
        "input_profile",
        "fixture_bundle_member",
        "fixture_input_digest",
        "product",
        "oracle"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^mq\\.mqi\\.mq[a-z0-9_]+\\.licensed-differential$",
          "maxLength": 96
        },
        "row_id": {
          "type": "string",
          "pattern": "^ibm-mq-9\\.4-mqi-2026-08-31:mqi-calls-unique:[0-9]{4}$"
        },
        "call": {"type": "string", "pattern": "^MQ[A-Z0-9_]+$", "maxLength": 32},
        "source_topic_path": {
          "type": "string",
          "pattern": "^SSFKSJ_9\\.4\\.0/refdev/q[0-9]+_\\.html$",
          "maxLength": 64
        },
        "input_profile": {
          "type": "string",
          "pattern": "^independent-mqi\\.[a-z0-9-]+\\.v1$",
          "maxLength": 96
        },
        "fixture_bundle_member": {
          "type": "string",
          "pattern": "^mqi/mq[a-z0-9_]+\\.json$",
          "maxLength": 64
        },
        "fixture_input_digest": {"$ref": "#/$defs/digest"},
        "product": {"$ref": "#/$defs/normalizedObservation"},
        "oracle": {"$ref": "#/$defs/normalizedObservation"}
      }
    },
    "normalizedObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completion_code",
        "reason_code",
        "handle_state",
        "mutation_state",
        "state_digest",
        "effect_digest",
        "output_digest",
        "output_length",
        "output_encoding",
        "status_digest"
      ],
      "properties": {
        "completion_code": {"enum": ["MQCC_OK", "MQCC_WARNING", "MQCC_FAILED"]},
        "reason_code": {
          "type": "string",
          "pattern": "^MQRC_[A-Z0-9_]+$",
          "maxLength": 96
        },
        "handle_state": {
          "enum": ["none", "valid", "invalid", "unchanged", "released"]
        },
        "mutation_state": {
          "enum": ["no-mutation", "pending", "committed", "backed-out", "unknown"]
        },
        "state_digest": {"$ref": "#/$defs/digest"},
        "effect_digest": {"$ref": "#/$defs/digest"},
        "output_digest": {"$ref": "#/$defs/digest"},
        "output_length": {"type": "integer", "minimum": 0, "maximum": 16777216},
        "output_encoding": {
          "enum": ["no-output", "binary", "utf-8", "ebcdic-single-byte"]
        },
        "status_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "run_id",
        "issued_at",
        "licensed_execution",
        "independent_product_and_oracle_runs",
        "proprietary_bytes_retained_in_receipt",
        "credentials_retained_in_receipt",
        "raw_output_retained_in_receipt",
        "historical_result",
        "synthetic_or_model_result"
      ],
      "properties": {
        "receipt_id": {"$ref": "#/$defs/id"},
        "run_id": {"$ref": "#/$defs/id"},
        "issued_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "licensed_execution": {"const": true},
        "independent_product_and_oracle_runs": {"const": true},
        "proprietary_bytes_retained_in_receipt": {"const": false},
        "credentials_retained_in_receipt": {"const": false},
        "raw_output_retained_in_receipt": {"const": false},
        "historical_result": {"const": false},
        "synthetic_or_model_result": {"const": false}
      }
    }
  }
}
