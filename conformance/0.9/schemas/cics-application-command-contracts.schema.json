        "condition_stack": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "trigger_fragment_sha256s": {"type": "array", "items": {"$ref": "#/$defs/sha256"}},
        "trigger_predicate": {"type": ["object", "null"]},
        "trigger_status": {"enum": ["resolved", "not-applicable", "bounded-ambiguity"]},
