{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/jes-work-package-evidence.schema.json",
  "title": "JES work-package failure and behavior matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_version", "work_package", "status", "rows"],
  "properties": {
    "schema_version": {"const": "mainframe-env.jes-work-package-evidence@1"},
    "target_version": {"const": "0.8.0"},
    "work_package": {"type": "string", "pattern": "^JES-80[2-6]$"},
    "status": {"enum": ["pass", "pass-with-licensed-differential-pending"]},
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
          "result": {"enum": ["pass", "pending"]},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 1024}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"work_package": {"not": {"const": "JES-806"}}}},
      "then": {"properties": {"status": {"const": "pass"}}}
    }
  ]
}
