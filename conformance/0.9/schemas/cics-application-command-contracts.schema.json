        "source_scope": {"enum": ["syntax-diagram-only", "not-applicable"]},
        "required": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*$"}},
        "alternatives": {"type": "array", "items": {"$ref": "#/$defs/option-alternative"}},
        "dependencies": {"type": "array", "items": {"$ref": "#/$defs/option-dependency"}},
        "mutual_exclusions": {"type": "array", "items": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*$"}}}
      }
