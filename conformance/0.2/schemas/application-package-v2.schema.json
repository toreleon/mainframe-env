{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/application-package@2",
  "title": "mainframe-env signed versioned application package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generation", "base_manifest_identity", "sections", "signature"],
  "properties": {
    "schema_version": {"const": "mainframe-env.application-package@2"},
    "generation": {"type": "integer", "minimum": 1},
    "base_manifest_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "host_abi_libraries", "sql_tables", "sql_rows", "ims_definitions", "ims_rows", "mq_resources", "batch_controllers", "security_resources"],
      "properties": {
        "schema_version": {"const": "mainframe-env.application-package@2"},
        "host_abi_libraries": {"type": "array", "maxItems": 16384, "items": {"$ref": "#/$defs/abi_library"}},
        "sql_tables": {"type": "array", "maxItems": 16384, "items": {"$ref": "#/$defs/sql_table"}},
        "sql_rows": {"type": "array", "maxItems": 16384, "items": {"$ref": "#/$defs/record"}},
        "ims_definitions": {"type": "array", "maxItems": 16384, "items": {"$ref": "#/$defs/ims_definition"}},
        "ims_rows": {"type": "array", "maxItems": 16384, "items": {"$ref": "#/$defs/record"}},
        "ims_metadata": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["schema_version", "databases", "psbs"],
              "properties": {
                "schema_version": {"const": "mainframe-env.ims-metadata@1"},
                "databases": {"type": "array", "minItems": 1, "maxItems": 64},
                "psbs": {"type": "array", "maxItems": 256}
              }
            }
          ]
        },
        "ims_tm": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["transactions"],
              "properties": {
                "transactions": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/ims_tm_transaction"}}
              }
            }
          ]
        },
        "mq_resources": {"type": "array", "maxItems": 16384, "items": {"$ref": "#/$defs/named"}},
        "batch_controllers": {"type": "array", "maxItems": 16384, "items": {"$ref": "#/$defs/controller"}},
        "security_resources": {"type": "array", "maxItems": 16384, "items": {"type": "object", "maxProperties": 3}}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"type": "string", "minLength": 1},
        "key_id": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "named": {
      "type": "object",
      "required": ["name"],
      "properties": {"name": {"type": "string", "minLength": 1}}
    },
    "abi_library": {
      "type": "object",
      "required": ["id", "members"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "members": {"type": "array", "maxItems": 4096, "items": {"type": "object", "maxProperties": 2}}
      }
    },
    "sql_table": {
      "type": "object",
      "required": ["name", "columns", "primary_key"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "columns": {"type": "array", "maxItems": 1024, "items": {"type": "object", "maxProperties": 2}},
        "primary_key": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1}}
      }
    },
    "ims_definition": {
      "type": "object",
      "required": ["name", "segments"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "segments": {"type": "array", "maxItems": 4096, "items": {"type": "string", "minLength": 1}}
      }
    },
    "record": {
      "type": "object",
      "properties": {"values": {"type": "object", "maxProperties": 1024}}
    },
    "ims_tm_transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "psb", "program_selector", "artifact", "required_generation", "context", "priority", "timeout_ticks", "conversational", "spa_size", "alternate_pcbs"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 8},
        "psb": {"type": "string", "minLength": 1, "maxLength": 8},
        "program_selector": {"type": "string", "minLength": 1, "maxLength": 256},
        "artifact": {"type": "string", "minLength": 1, "maxLength": 256},
        "required_generation": {"type": "string", "minLength": 1, "maxLength": 256},
        "context": {"enum": ["message-processing", "message-driven-batch", "cpi-communications", "fast-path"]},
        "priority": {"type": "integer", "minimum": 0, "maximum": 255},
        "timeout_ticks": {"type": "integer", "minimum": 1, "maximum": 86400000},
        "conversational": {"type": "boolean"},
        "spa_size": {"type": "integer", "minimum": 0, "maximum": 32768},
        "alternate_pcbs": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/ims_tm_alternate_pcb"}}
      }
    },
    "ims_tm_alternate_pcb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "destination", "express"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 8},
        "destination": {
          "oneOf": [
            {"const": "modifiable"},
            {"type": "object", "additionalProperties": false, "required": ["fixed"], "properties": {"fixed": {"type": "string", "minLength": 1, "maxLength": 8}}}
          ]
        },
        "express": {"type": "boolean"}
      }
    },
    "controller": {
      "type": "object",
      "required": ["name", "program", "properties"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "program": {"type": "string", "minLength": 1},
        "properties": {"type": "object", "maxProperties": 1024}
      }
    }
  }
}
