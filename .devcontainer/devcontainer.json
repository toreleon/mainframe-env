{
  "name": "mainframe-env",
  "dockerComposeFile": [
    "../docker/compose.yaml",
    "compose.yaml"
  ],
  "service": "dev",
  "runServices": [
    "postgres"
  ],
  "workspaceFolder": "/workspace",
  "remoteUser": "developer",
  "updateRemoteUserUID": false,
  "overrideCommand": false,
  "shutdownAction": "none",
  "initializeCommand": "${localWorkspaceFolder}/docker/dev devcontainer-init",
  "remoteEnv": {
    "PATH": "/opt/mainframe-env/docker/dev-bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "openai.chatgpt",
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb"
      ],
      "settings": {
        "chatgpt.openOnStartup": true,
        "rust-analyzer.checkOnSave": false,
        "rust-analyzer.cargo.extraEnv": {
          "CARGO_HOME": "/cache",
          "CARGO_TARGET_DIR": "/target"
        },
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
