  "compatibility": {
    "additive": true,
    "existing_core_server_unchanged": true,
    "old_artifact_checkpoint_config_readers_preserved": true,
    "generic_success_for_missing_dependency": false,
    "native_oracle_binary_fallback": false,
    "inventory_only_pass_allowed": false
  },
  "profiles": [
    {
      "id": "carddemo-base-online",
      "requires": [],
      "includes": ["31-program base compiler corpus", "17 BMS maps", "base CSD program/transaction/file resources", "base VSAM seed data", "CICS session API", "TN3270 compatibility adapter"],
      "claim_gate": "Every base online user and administrator journey passes through installed public product routes."
    },
    {
      "id": "carddemo-base",
      "requires": ["carddemo-base-online"],
      "includes": ["38 base JCL files", "2 cataloged procedures", "base named COBOL batch programs", "selected utilities", "GDG/PDS/ESDS/RRDS behavior", "assembler and LE compatibility services"],
      "claim_gate": "Initialization and the declared operational batch cycle produce exact dataset and spool observations."
    },
    {
      "id": "carddemo-db2",
      "requires": ["carddemo-base"],
      "includes": ["transaction-type Db2 online programs", "Db2 batch maintenance", "Db2-to-VSAM extraction", "static SQL and cursor behavior"],
      "claim_gate": "Online and batch transaction-type CRUD, cursor, commit, rollback, and extraction journeys pass."
    },
    {
      "id": "carddemo-mq",
      "requires": ["carddemo-base"],
      "includes": ["VSAM/MQ date inquiry", "VSAM/MQ account inquiry", "MQ request/reply and correlation"],
      "claim_gate": "CDRD and CDRA request-response journeys pass through the selected MQ authority."
    },
    {
      "id": "carddemo-authorization",
      "requires": ["carddemo-base", "carddemo-db2", "carddemo-mq"],
      "includes": ["authorization MQ trigger", "IMS HIDAM hierarchy", "authorization screens", "fraud Db2 updates", "purge and checkpoint batch", "cross-resource commit and rollback"],
      "claim_gate": "Approval, decline, summary, details, fraud, rollback, restart, and purge journeys pass."
    },
    {
      "id": "carddemo-full",
      "requires": ["carddemo-base", "carddemo-db2", "carddemo-mq", "carddemo-authorization"],
      "includes": ["all repository application workloads", "owned operator commands", "selected FTP/JES compatibility", "full restart/security/resource certification"],
      "claim_gate": "Every included workload has derived application-run evidence and no unresolved required resource."
    }
  ],
  "oracle_only": [
    "samples/m2/mf/CardDemo_runtime.zip native modules and shared libraries",
    "samples/m2/unikix/UniKix_CardDemo_runtime_v1.zip migrated runtime objects",
    "external cloud POS client described by the authorization README"
  ],
  "unresolved_corpus_decisions": [],
