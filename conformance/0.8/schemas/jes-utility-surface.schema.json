{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/jes-utility-surface.schema.json",
  "title": "JES utility registration and behavior surface inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_version",
    "work_package",
    "registration_contract",
    "resolution",
    "handlers",
    "special_handlers",
    "fallback",
    "fail_closed",
    "non_claims"
  ],
  "properties": {
    "schema_version": {"const": "mainframe-env.jes-utility-inventory@1"},
    "target_version": {"const": "0.8.0"},
    "work_package": {"const": "JES-805"},
    "registration_contract": {"const": "mainframe-env.jes-utility-registry@1"},
    "resolution": {"type": "string", "minLength": 1, "maxLength": 256},
    "handlers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["program", "handler", "family", "effect"],
        "properties": {
          "program": {"$ref": "#/$defs/programName"},
          "handler": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "family": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "effect": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "special_handlers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["program", "handler"],
        "properties": {
          "program": {"$ref": "#/$defs/programName"},
          "handler": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
        }
      }
    },
    "fallback": {"type": "string", "minLength": 1, "maxLength": 256},
    "fail_closed": {"$ref": "#/$defs/boundedUniqueStrings"},
    "non_claims": {"$ref": "#/$defs/boundedUniqueStrings"}
  },
  "$defs": {
    "programName": {
      "type": "string",
      "pattern": "^[A-Z0-9$@#_-]{1,128}$"
    },
    "boundedUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    }
  }
}
