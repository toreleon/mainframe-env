    {"id": "PUT /zosmf/restfiles/ds/{dsn}", "handler": "dataset_write"},
    {"id": "POST /zosmf/restfiles/ds/{dsn}", "handler": "dataset_create"},
    {"id": "DELETE /zosmf/restfiles/ds/{dsn}", "handler": "dataset_delete"},
    {"id": "GET /zosmf/restfiles/ds/{dsn}/member", "handler": "member_list"},
    {"id": "GET /zosmf/restfiles/ds/{dsn}/search", "handler": "dataset_search"},
    {"id": "PUT /zosmf/restfiles/ams", "handler": "ams"},
