{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/dataset-certification.schema.json",
  "title": "Dataset VSAM AMS local certification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_version", "baseline_id", "completion_policy", "surface", "state", "reference_simulation", "matrices", "validation", "oracle"],
  "properties": {
    "schema_version": { "const": "mainframe-env.dataset-certification@2" },
    "target_version": { "const": "0.6.0" },
    "baseline_id": { "const": "ibm-zos-3.2-dfsms-ams-2026-06" },
    "completion_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "differential", "release_hard_gate"],
      "properties": {
        "status": { "const": "pass-with-licensed-differential-pending" },
        "differential": { "const": "pending" },
        "release_hard_gate": { "const": "0.17.0" }
      }
    },
    "surface": {
      "type": "object", "additionalProperties": false,
      "required": ["official_rows", "ams_commands", "organizations", "detailed_descriptors", "local_bindings", "detailed_surface_audit", "local_gates"],
      "properties": {
        "official_rows": { "const": 36 },
        "ams_commands": { "const": 31 },
        "organizations": { "const": 5 },
        "detailed_descriptors": { "const": 131 },
        "local_bindings": { "const": 180 },
        "detailed_surface_audit": {
          "type": "object", "additionalProperties": false,
          "required": ["receipt", "required_pass", "capability_pass", "capability_conditioned"],
          "properties": {
            "receipt": { "const": "conformance/0.6/evidence/dataset-surface-audit.json" },
            "required_pass": { "const": 97 },
            "capability_pass": { "const": 9 },
            "capability_conditioned": { "const": 25 }
          }
        },
        "local_gates": {
          "type": "object", "additionalProperties": false,
          "required": ["recognized", "validated", "executed", "conditioned", "recovered", "differential"],
          "properties": {
            "recognized": { "const": 36 },
            "validated": { "const": 36 },
            "executed": { "const": 36 },
            "conditioned": { "const": 36 },
            "recovered": { "const": 36 },
            "differential": { "const": 0 }
          }
        }
      }
    },
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["writer", "readers", "aix_writer", "migrations"],
      "properties": {
        "writer": { "const": "MEDS6" },
        "readers": { "const": ["MEDS1", "MEDS2", "MEDS3", "MEDS4", "MEDS5", "MEDS6"] },
        "aix_writer": { "const": "MEAIX4" },
        "migrations": { "const": ["2-to-3", "3-to-4", "4-to-5", "5-to-6"] }
      }
    },
    "reference_simulation": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "model_kind", "organizations", "commands", "properties", "observation_perturbations_rejected", "differential_credit"],
      "properties": {
        "status": { "const": "pass" },
        "model_kind": { "const": "independent-bounded-pure-state" },
        "organizations": { "const": 5 },
        "commands": { "const": 31 },
        "properties": { "const": 13 },
        "observation_perturbations_rejected": { "const": 8 },
        "differential_credit": { "const": 0 }
      }
    },
    "matrices": {
      "type": "object", "additionalProperties": { "const": "pass" },
      "required": ["base_aix_atomicity", "gdg_atomicity", "disp_cleanup", "locks", "rls_tvs", "restart", "unknown_outcome", "concurrent_mutation", "corruption", "backup_restore", "migration", "scale", "carddemo_exactness", "volume_vtoc", "owner_security", "operand_rejection", "lifecycle_invalidation", "snapshot_all_organizations", "detailed_surface_audit", "reference_simulation"]
    },
    "validation": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "oracle": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "required_environment", "receipt", "deferred_to"],
      "properties": {
        "status": { "const": "pending" },
        "required_environment": { "const": "licensed-zos-3.2" },
        "receipt": { "type": "null" },
        "deferred_to": { "const": "0.17.0" }
      }
    }
  }
}
