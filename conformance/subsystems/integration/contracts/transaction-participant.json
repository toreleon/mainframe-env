{
  "schema_version": "mainframe-env.transaction-participant-contract@1",
  "contract_id": "mainframe-env.transaction-participant@1",
  "contract_version": 1,
  "work_package": "INT-1601.participant-schema",
  "status": "early-additive-prerequisite",
  "authority": {
    "coordinator": "mainframe-env.execution-coordinator@1",
    "canonical_effect": "mainframe-env.effect-canonical@1",
    "store": "mainframe-env.store@2",
    "single_authority": true,
    "public_runtime_change": false,
    "universal_two_phase_commit": false,
    "exactly_once": false
  },
  "vocabulary": {
    "modes": [
      "local",
      "distributed-owned",
      "distributed-subordinate"
    ],
    "prepare": [
      "not-applicable",
      "durable-intent-only",
      "provider-prepare"
    ],
    "outcomes": [
      "committed",
      "rolled-back",
      "failed",
      "heuristic-commit",
      "heuristic-rollback",
      "heuristic-mixed",
      "in-doubt",
      "unknown-outcome"
    ]
  },
  "ordering": {
    "effect": [
      "observe-deadline-and-cancellation",
      "validate-request-capability-and-context",
      "persist-canonical-effect-intent",
      "authorize-typed-resource-and-intent",
      "apply-participant-mutation",
      "persist-audit-and-result-or-unknown"
    ],
    "locks": [
      "coordinator-intent-cas",
      "participant-state-fence",
      "canonical-resource-locks",
      "participant-uow-replay-publication",
      "coordinator-result-cas"
    ],
    "store_transaction_across_dispatch": false,
    "resource_lock_key": "provider-id/resource-identity",
    "late_owner_fenced": true
  },
  "obligations": [
    "INT-1601.owner",
    "INT-1601.modes",
    "INT-1601.prepare",
    "INT-1601.completion",
    "INT-1601.compensation",
    "INT-1601.outcomes",
    "INT-1601.idempotency",
    "INT-1601.ordering",
    "INT-1601.fencing",
    "INT-1601.deadline-cancellation",
    "INT-1601.security-audit",
    "INT-1601.recovery-schema",
    "INT-1601.retention",
    "INT-1601.compatibility"
  ],
  "compatibility": {
    "writer_version": 1,
    "read_versions": [1],
    "unknown_version": "reject",
    "change_policy": "additive-only-until-version-bump",
    "coordinator_schema_owner": "execution-and-store-maintainers",
    "participant_schema_owner": "owning-provider-maintainer"
  },
  "participants": [
    {
      "provider_id": "cics",
      "status": "accepted",
      "dependency": "accepted-v0.9-cics-boundary",
      "capabilities": {
        "transaction_owner": "cics-task-or-dpl-mirror",
        "supported_modes": [
          "local",
          "distributed-owned"
        ],
        "rejected_modes": [
          "distributed-subordinate"
        ],
        "contexts": [
          {
            "context_id": "local",
            "mode": "local",
            "syncpoint_owner": "participant",
            "explicit_syncpoint": "supported",
            "rejection": null
          },
          {
            "context_id": "dpl-synconreturn",
            "mode": "distributed-owned",
            "syncpoint_owner": "participant",
            "explicit_syncpoint": "supported",
            "rejection": null
          },
          {
            "context_id": "dpl-without-synconreturn",
            "mode": "distributed-subordinate",
            "syncpoint_owner": "upstream-host",
            "explicit_syncpoint": "rejected",
            "rejection": {
              "condition": "INVREQ",
              "response": 16,
              "response2": 200
            }
          },
          {
            "context_id": "dpl-executionset-subset",
            "mode": "distributed-subordinate",
            "syncpoint_owner": "upstream-host",
            "explicit_syncpoint": "rejected",
            "rejection": {
              "condition": "INVREQ",
              "response": 16,
              "response2": 200
            }
          }
        ],
        "prepare": "durable-intent-only",
        "provider_prepare": false,
        "commit": true,
        "rollback": true,
        "compensation": {
          "automatic": false,
          "after_commit": false,
          "scope": "service-specific-explicit-only"
        },
        "outcomes": {
          "reported": [
            "committed",
            "rolled-back",
            "failed",
            "unknown-outcome"
          ],
          "not_produced": [
            "heuristic-commit",
            "heuristic-rollback",
            "heuristic-mixed",
            "in-doubt"
          ],
          "collapse_to_success": false
        },
        "idempotency": {
          "scope": "execution-run-unit-effect-sequence",
          "lifetime": "retention-policy-idempotency-ticks",
          "replay": "exact-canonical-request-and-result",
          "reuse_after_prune": "new-operation",
          "exactly_once": false
        },
        "ordering": "shared-v1",
        "fencing": {
          "effect_lease_epoch": true,
          "participant_row_cas": true,
          "stale_owner_rejected": true
        },
        "deadline_cancellation": {
          "finite_deadline": true,
          "live_cancellation_probe": true,
          "pre_dispatch_stop": true,
          "post_dispatch_uncertainty": "unknown-outcome"
        },
        "security_audit": {
          "principal_and_delegation_propagated": true,
          "typed_resource_authorization_before_mutation": true,
          "deny_and_failure_audited": true,
          "shared_store_atomic_publication": true
        },
        "recovery": {
          "coordinator_owner": "execution-coordinator-effect-journal",
          "participant_owner": "cics-uow-and-replay-rows",
          "reconciliation": "service-specific-fenced-observation",
          "automatic_redispatch": false
        },
        "schemas": {
          "request": "mainframe-env.cics.request@1",
          "canonical_effect": "mainframe-env.effect-canonical@1",
          "uow_namespace": "cics-uow",
          "uow_write": "MECU2",
          "uow_frame_write": "MECU3",
          "uow_read": [
            "MECU1",
            "MECU2",
            "MECU3"
          ],
          "undo_namespace": "cics-uow-undo",
          "undo_read_write": "MECUNDO1",
          "replay_namespace": "cics-effect-replay-v1",
          "replay_write": "MECER003"
        },
        "retention": {
          "target": "cics-unit-of-work",
          "watermark": "idempotency",
          "protect_live_checkpoint_audit_replay": true,
          "deadline_is_lower_bound": true
        }
      }
    },
    {
      "provider_id": "db2",
      "status": "pending",
      "dependency": "v0.13-owned-participant-binding",
      "capabilities": null
    },
    {
      "provider_id": "ims",
      "status": "pending",
      "dependency": "v0.14-owned-participant-binding",
      "capabilities": null,
      "preparation": {
        "scope": "ims-local-database-provider-route",
        "contract_test": "crates/providers/mainframe-env-ims/tests/participant_contract.rs",
        "blocked_obligations": [
          "INT-1601.owner",
          "INT-1601.modes",
          "INT-1601.ordering",
          "INT-1601.fencing",
          "INT-1601.deadline-cancellation",
          "INT-1601.security-audit",
          "INT-1601.retention",
          "INT-1601.compatibility"
        ]
      }
    },
    {
      "provider_id": "mq",
      "status": "pending",
      "dependency": "v0.15-owned-participant-binding",
      "capabilities": null
    }
  ]
}
