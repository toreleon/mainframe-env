{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/cobol-language-v1.json",
  "title": "mainframe-env Enterprise COBOL 6.5 language catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_version", "baseline_id", "source", "compiler_directing_statements", "compiler_directive_groups", "procedure_statements", "file_description_clauses", "data_description_clauses", "intrinsic_functions", "special_registers"],
  "properties": {
    "schema_version": {"const": "mainframe-env.cobol-language@1"},
    "target_version": {"const": "0.3.0"},
    "baseline_id": {"const": "ibm-enterprise-cobol-6.5-2026-05-31"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["publication", "manifest", "sha256"],
      "properties": {
        "publication": {"const": "SC27-8713-04"},
        "manifest": {"const": "conformance/0.2/manifests/cobol-topics.json"},
        "sha256": {"const": "sha256:9b0291045414ca38d0e8138c7cc78d7321887a3fad6c27a433efd9e9ca7fd1ad"}
      }
    },
    "compiler_directing_statements": {"type": "array", "minItems": 15, "maxItems": 15, "items": {"$ref": "#/$defs/statement"}},
    "compiler_directive_groups": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/group"}},
    "procedure_statements": {"type": "array", "minItems": 44, "maxItems": 44, "items": {"$ref": "#/$defs/statement-family"}},
    "file_description_clauses": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/clause"}},
    "data_description_clauses": {"type": "array", "minItems": 17, "maxItems": 17, "items": {"$ref": "#/$defs/clause"}},
    "intrinsic_functions": {"type": "array", "minItems": 82, "maxItems": 82, "items": {"$ref": "#/$defs/intrinsic-function"}},
    "special_registers": {"type": "array", "minItems": 28, "maxItems": 28, "items": {"$ref": "#/$defs/special-register"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 64},
    "official_id": {"type": "string", "pattern": "^ibm-enterprise-cobol-6\\.5-2026-05-31:[a-z-]+:[0-9]{4}$"},
    "statement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "row_id", "label", "source_locator", "forms", "placement", "effect"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "row_id": {"$ref": "#/$defs/official_id"},
        "label": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_locator": {"type": "string", "pattern": "^topic:[^;]+;topic-id:[^;]+;heading:.+$", "maxLength": 256},
        "forms": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
        "placement": {"$ref": "#/$defs/id"}, "effect": {"$ref": "#/$defs/id"}
      }
    },
    "group": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "row_id", "label", "source_locator", "directives", "placement", "effect"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "row_id": {"$ref": "#/$defs/official_id"},
        "label": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_locator": {"type": "string", "pattern": "^topic:[^;]+;topic-id:[^;]+;heading:.+$", "maxLength": 256},
        "directives": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "placement": {"$ref": "#/$defs/id"}, "effect": {"$ref": "#/$defs/id"}
      }
    },
    "clause": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "row_id", "label", "source_locator", "forms", "placement"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "row_id": {"$ref": "#/$defs/official_id"},
        "label": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_locator": {"type": "string", "pattern": "^topic:[^;]+;topic-id:[^;]+;heading:.+$", "maxLength": 256},
        "forms": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
        "placement": {"$ref": "#/$defs/id"}
      }
    },
    "statement-family": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "row_id", "label", "source_locator", "forms"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "row_id": {"$ref": "#/$defs/official_id"},
        "label": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_locator": {"type": "string", "pattern": "^topic:[^;]+;topic-id:[^;]+;heading:.+$", "maxLength": 256},
        "forms": {
          "description": "Reviewed sketches of the statement's formats. Every all-uppercase word here is harvested into a global reserved-word set shared by all 44 rows, so a figurative constant is written as the publication's own operand name (fig-con-1, as SET Formats 5 to 7 publish it) and never as SPACES, ZEROS, LOW-VALUES or their siblings; see conformance/0.3/tools/AUTHORING.md.",
          "type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 1024}
        },
        "disposition": {
          "description": "Why this row's forms are deliberately sufficient, for rows where the publication publishes more statement formats than the row records. Optional; absent means the forms are the whole story.",
          "type": "object", "additionalProperties": false,
          "required": ["rationale"],
          "properties": {
            "rationale": {"type": "string", "minLength": 16, "maxLength": 512},
            "source_formats": {"type": "integer", "minimum": 1, "maximum": 32}
          }
        }
      }
    },
    "argument-class": {"enum": ["alphabetic", "alphanumeric", "dbcs", "integer", "numeric", "national", "utf8", "other", "keyword"]},
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["arguments", "variadic", "homogeneous", "result"],
      "properties": {
        "arguments": {"type": "array", "maxItems": 4, "items": {"type": "array", "minItems": 1, "maxItems": 9, "uniqueItems": true, "items": {"$ref": "#/$defs/argument-class"}}},
        "variadic": {"type": "boolean"},
        "homogeneous": {"type": "boolean"},
        "result": {"enum": ["integer", "numeric", "alphanumeric", "national", "utf8", "preserve-numeric", "content", "string-first", "comparable", "range-sum"]}
      }
    },
    "intrinsic-function": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "row_id", "name", "source_locator", "signatures", "literal_arguments", "fixed_length", "runtime_supported"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "row_id": {"$ref": "#/$defs/official_id"},
        "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*$", "maxLength": 64},
        "source_locator": {"type": "string", "pattern": "^topic:[^;]+;topic-id:[^;]+;heading:.+$", "maxLength": 256},
        "signatures": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/signature"}},
        "literal_arguments": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 3}},
        "fixed_length": {"anyOf": [{"type": "integer", "minimum": 1, "maximum": 1024}, {"type": "null"}]},
        "runtime_supported": {"type": "boolean"}
      }
    },
    "special-register": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "source_locator", "value_type", "usage", "length_kind", "writable", "operand", "runtime_supported"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9 -]*$", "maxLength": 64},
        "source_locator": {"type": "string", "pattern": "^topic:[^;]+;topic-id:[^;]+;heading:.+$", "maxLength": 256},
        "value_type": {"enum": ["alphanumeric", "integer", "national", "other", "group"]},
        "usage": {"enum": ["display", "binary", "native-binary", "national", "pointer", "group"]},
        "length_kind": {"enum": ["fixed", "lp", "dynamic", "dependent"]},
        "fixed_length": {"type": "integer", "minimum": 1, "maximum": 1024},
        "writable": {"type": "boolean"},
        "operand": {"enum": ["none", "data-item", "file", "debug-context"]},
        "runtime_supported": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"properties": {"length_kind": {"const": "fixed"}}}, "then": {"required": ["fixed_length"]}},
        {"if": {"properties": {"length_kind": {"enum": ["lp", "dynamic", "dependent"]}}}, "then": {"not": {"required": ["fixed_length"]}}}
      ]
    }
  }
}
