{
  "schema_version": "mainframe-env.carddemo-profile@1",
  "status": "specified",
  "objective": "Exercise pinned CardDemo workloads through subsystem-owned profiles and fresh application checks.",
  "corpus": {
    "repository": "https://github.com/aws-samples/aws-mainframe-modernization-carddemo.git",
