{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/jes-spool-migration.schema.json",
  "title": "JES embedded-spool artifact migration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_version", "from", "to", "authority", "strategy", "rollback", "invariants"],
  "properties": {
    "schema_version": {"const": "mainframe-env.jes-spool-migration@1"},
    "target_version": {"const": "0.8.0"},
    "from": {"const": "mainframe-env.jes-durable-job@2/spool"},
    "to": {"const": "mainframe-env.spool-state@1+mainframe-env.jes-durable-job@2/spool_files"},
    "authority": {"const": "mainframe-env-store-api.ProviderStateStore+ArtifactStore"},
    "strategy": {"const": "authorized-lazy-idempotent-append-then-job-cas"},
    "rollback": {"const": "retain-embedded-records-until-job-cas"},
    "invariants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    }
  }
}
