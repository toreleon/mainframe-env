{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/ims-licensed-differential-fixtures@1",
  "title": "IBM IMS 15.6 independent licensed fixture index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_subsystem",
    "work_package",
    "baseline_id",
    "unit",
    "independent_fixture_authority",
    "case_count",
    "cases_per_family",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "mainframe-env.ims-licensed-differential-fixtures@1"
    },
    "target_subsystem": {
      "const": "ims.programming"
    },
    "work_package": {
      "const": "IMS-1406.licensed-harness-contract"
    },
    "baseline_id": {
      "const": "ibm-ims-15.6-dli-2026-08-31"
    },
    "unit": {
      "const": "dli-call-families"
    },
    "independent_fixture_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "product_output_derived",
        "oracle_output_embedded",
        "raw_fixture_bytes_retained",
        "external_bundle_digest_required"
      ],
      "properties": {
        "kind": {
          "const": "reviewed-external-fixture-bundle"
        },
        "product_output_derived": {
          "const": false
        },
        "oracle_output_embedded": {
          "const": false
        },
        "raw_fixture_bytes_retained": {
          "const": false
        },
        "external_bundle_digest_required": {
          "const": true
        }
      }
    },
    "case_count": {
      "const": 25
    },
    "cases_per_family": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "row_id",
          "call_family",
          "source_locator",
          "source_topic_path",
          "source_topic_sha256",
          "applicability_profiles",
          "input_profile",
          "scenario_class",
          "fixture_bundle_member",
          "observation_profile"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^ims\\.dli\\.[0-9]{4}\\.licensed-differential$",
            "maxLength": 64
          },
          "row_id": {
            "type": "string",
            "pattern": "^ibm-ims-15\\.6-dli-2026-08-31:dli-call-families:[0-9]{4}$",
            "maxLength": 90
          },
          "call_family": {
            "type": "string",
            "maxLength": 96
          },
          "source_locator": {
            "type": "string",
            "maxLength": 160
          },
          "source_topic_path": {
            "type": "string",
            "pattern": "^SSEPH2_15\\.6\\.0/.+\\.htm$",
            "maxLength": 160
          },
          "source_topic_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "maxLength": 71
          },
          "applicability_profiles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:@+/-]{1,160}$",
              "maxLength": 160
            }
          },
          "input_profile": {
            "type": "string",
            "pattern": "^independent-ims\\.[a-z0-9-]+\\.v1$",
            "maxLength": 96
          },
          "scenario_class": {
            "enum": [
              "completed",
              "condition",
              "rejected"
            ]
          },
          "fixture_bundle_member": {
            "type": "string",
            "pattern": "^dli/[0-9]{4}\\.json$",
            "maxLength": 32
          },
          "observation_profile": {
            "const": "ims-normalized-observation@1"
          }
        }
      }
    }
  }
}
