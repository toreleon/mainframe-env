        "eib_response": {"type": "object", "additionalProperties": false, "required": ["status", "response_authority", "eibfn", "eibfn_bytes", "normal_return", "conditions", "symbolic_fragments", "condition_policy"], "properties": {"status": {"$ref": "#/$defs/dimension-status"}, "response_authority": {"const": "SSJL4D_6.x/reference-diagnostics/eib/dfha8me.html"}, "eibfn": {"type": "string", "pattern": "^[0-9A-F]{4}$"}, "eibfn_bytes": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0, "maximum": 255}}, "normal_return": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["condition", "resp", "resp2"], "properties": {"condition": {"const": "NORMAL"}, "resp": {"const": 0}, "resp2": {"const": 0}}}]}, "conditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}}, "symbolic_fragments": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}, "condition_policy": {"type": "object", "additionalProperties": false, "required": ["authority", "default", "nohandle", "resp", "resp2", "resp2_requires_resp"], "properties": {"authority": {"const": "global-command-format"}, "default": {"const": true}, "nohandle": {"type": "boolean"}, "resp": {"type": "boolean"}, "resp2": {"type": "boolean"}, "resp2_requires_resp": {"const": true}}}}},
        "applicability": {"type": "object", "additionalProperties": false, "required": ["status", "local_task", "dpl_server", "threadsafe", "cobol", "dpl_restriction", "language_restriction", "threadsafe_condition", "context_predicates", "source_selectors"], "properties": {"status": {"$ref": "#/$defs/dimension-status"}, "local_task": {"$ref": "#/$defs/text"}, "dpl_server": {"$ref": "#/$defs/text"}, "threadsafe": {"$ref": "#/$defs/text"}, "cobol": {"enum": ["allowed", "not-applicable", "conditional", "bounded-ambiguity"]}, "dpl_restriction": {"type": "object", "additionalProperties": false, "required": ["kind", "source_kind", "table_command", "prohibited_options", "requirement", "restriction_predicates", "restriction_match", "condition", "resp2"], "properties": {"kind": {"enum": ["allowed", "not-applicable", "prohibited", "option-restricted", "conditional", "bounded-ambiguity"]}, "source_kind": {"type": ["string", "null"], "enum": ["table", "prose", null]}, "table_command": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[A-Z][A-Z0-9 ]*$"}]}, "prohibited_options": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*(?:\\([A-Z0-9]+\\))?$"}}, "requirement": {"enum": ["none", "synconreturn-required", "termid-not-intersystem-session"]}, "restriction_predicates": {"type": "array", "uniqueItems": true, "items": {"enum": ["principal-facility", "connect-process-principal-facility-error-is-dpl"]}}, "restriction_match": {"type": ["string", "null"], "enum": ["any-of", null]}, "condition": {"type": ["string", "null"], "enum": ["INVREQ", null]}, "resp2": {"type": ["integer", "null"], "enum": [1, 5, 200, null]}}}, "language_restriction": {"type": "object", "minProperties": 1}, "threadsafe_condition": {"type": ["object", "null"]}, "context_predicates": {"type": "array", "items": {"type": "object", "minProperties": 1}}, "source_selectors": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}}},
        "resource": {"type": "object", "additionalProperties": false, "required": ["status", "scope", "selectors", "ambiguous_selectors", "excluded_output_options", "selector_authority", "selector_completeness", "fallback_selector", "access_intent", "authorization"], "properties": {"status": {"$ref": "#/$defs/dimension-status"}, "scope": {"$ref": "#/$defs/text"}, "selectors": {"type": "array", "items": {"$ref": "#/$defs/resource-selector"}}, "ambiguous_selectors": {"type": "array", "items": {"$ref": "#/$defs/resource-selector"}}, "excluded_output_options": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*$"}}, "selector_authority": {"enum": ["source-candidate-only", "source-bound-runtime", "not-applicable"]}, "selector_completeness": {"enum": ["resolved", "bounded-ambiguity", "not-applicable"]}, "fallback_selector": {"$ref": "#/$defs/nullable-text"}, "access_intent": {"enum": ["read", "update", "execute", "bounded-ambiguity", "not-applicable"]}, "authorization": {"enum": ["typed-saf-before-dispatch", "not-applicable"]}}},
        "capability": {"type": "object", "additionalProperties": false, "required": ["status", "route", "required"], "properties": {"status": {"$ref": "#/$defs/dimension-status"}, "route": {"oneOf": [{"type": "null"}, {"const": "host.cics.execute"}]}, "required": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^host\\.[a-z]+(?:\\.[a-z]+)*$"}}}},
