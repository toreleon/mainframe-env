{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/ams-grammar.schema.json",
  "title": "Generated AMS command grammar inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_subsystem", "commands"],
  "properties": {
    "schema_version": { "const": "mainframe-env.ams-grammar@1" },
    "target_subsystem": { "const": "dataset.data" },
    "commands": {
      "type": "array",
      "minItems": 31,
      "maxItems": 31,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "keywords", "implementation", "capability"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 64 },
          "keywords": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*$" }
          },
          "implementation": { "enum": ["required", "capability-gated"] },
          "capability": { "type": ["string", "null"], "minLength": 1, "maxLength": 64 }
        }
      }
    }
  }
}
