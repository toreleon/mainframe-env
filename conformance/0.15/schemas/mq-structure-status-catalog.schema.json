{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/mq-structure-status-catalog.schema.json",
  "title": "mainframe-env IBM MQ MQI structure and status identity catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_version",
    "work_package",
    "baseline_id",
    "topic_manifest",
    "source_call_list",
    "unique_call_count",
    "verified_call_topic_count",
    "missing_call_topic_count",
    "identity_authority",
    "behavioral_coverage_credit",
    "licensed_execution_credit",
    "calls"
  ],
  "properties": {
    "schema_version": {"const": "mainframe-env.mq-structure-status-catalog@1"},
    "target_version": {"const": "0.15.0"},
    "work_package": {"const": "MQ-1501.structure-status-catalog"},
    "baseline_id": {"const": "ibm-mq-9.4-mqi-2026-08-31"},
    "topic_manifest": {"$ref": "#/$defs/file-binding"},
    "source_call_list": {"$ref": "#/$defs/file-binding"},
    "unique_call_count": {"const": 26},
    "verified_call_topic_count": {"const": 26},
    "missing_call_topic_count": {"const": 0},
    "identity_authority": {"const": true},
    "behavioral_coverage_credit": {"const": 0},
    "licensed_execution_credit": {"const": 0},
    "calls": {
      "type": "array",
      "minItems": 26,
      "maxItems": 26,
      "items": {"$ref": "#/$defs/call"}
    }
  },
  "$defs": {
    "file-binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 256},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "official_row",
        "label",
        "topic_path",
        "topic_sha256",
        "source_status",
        "signature_status",
        "parameters"
      ],
      "properties": {
        "official_row": {
          "type": "string",
          "pattern": "^ibm-mq-9\\.4-mqi-2026-08-31:mqi-calls-unique:[0-9]{4}$"
        },
        "label": {"type": "string", "pattern": "^MQ[A-Z0-9_]+$"},
        "topic_path": {
          "type": "string",
          "pattern": "^SSFKSJ_9\\.4\\.0/refdev/q[0-9]+_\\.html$"
        },
        "topic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_status": {"enum": ["verified", "missing"]},
        "signature_status": {"enum": ["source-verified", "pending-source"]},
        "parameters": {
          "type": "array",
          "maxItems": 16,
          "items": {"$ref": "#/$defs/parameter"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"source_status": {"const": "verified"}}},
          "then": {
            "properties": {
              "signature_status": {"const": "source-verified"},
              "parameters": {"minItems": 3}
            }
          }
        },
        {
          "if": {"properties": {"source_status": {"const": "missing"}}},
          "then": {
            "properties": {
              "signature_status": {"const": "pending-source"},
              "parameters": {"maxItems": 0}
            }
          }
        }
      ]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "name",
        "data_type",
        "direction",
        "roles"
      ],
      "properties": {
        "position": {"type": "integer", "minimum": 1, "maximum": 16},
        "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$"},
        "data_type": {"type": "string", "minLength": 2, "maxLength": 64},
        "direction": {"enum": ["input", "output", "input-output"]},
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "scalar",
              "name",
              "length",
              "data",
              "handle",
              "structure",
              "options",
              "selector",
              "completion",
              "reason"
            ]
          }
        },
        "symbolic_identities": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^MQ[A-Z0-9_]+$"}
        },
        "handle_role": {
          "type": ["string", "null"],
          "enum": ["connection", "object", "subscription", "message", null]
        },
        "handle_action": {
          "type": ["string", "null"],
          "enum": ["use", "create", "release", "use-or-create", null]
        },
        "structure_version_identity": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^MQ[A-Z0-9_]+_VERSION$"}
          ]
        },
        "source_spelling_anomaly": {
          "$ref": "#/$defs/source-spelling-anomaly"
        }
      }
    },
    "source-spelling-anomaly": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_topic_path",
        "source_topic_sha256",
        "source_line",
        "literal_data_type",
        "canonical_topic_path",
        "canonical_topic_sha256",
        "canonical_first_line",
        "canonical_last_line"
      ],
      "properties": {
        "source_topic_path": {"const": "SSFKSJ_9.4.0/refdev/q101710_.html"},
        "source_topic_sha256": {"const": "8a94879a9c9f2e18ddb2171b0dd5ea477ebaf26684a760c9e1e31931f2084156"},
        "source_line": {"const": 13},
        "literal_data_type": {"const": "MQHMQSG"},
        "canonical_topic_path": {"const": "SSFKSJ_9.4.0/refdev/q101780_.html"},
        "canonical_topic_sha256": {"const": "66cf482573408e227aec23ec2219cd52bf7bf879591f33acb04dc3f33fb386db"},
        "canonical_first_line": {"const": 37},
        "canonical_last_line": {"const": 49}
      }
    }
  }
}
