{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/jes-dd-surface.schema.json",
  "title": "JES DD allocation and disposition surface inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_version",
    "plan_authority",
    "dataset_authority",
    "allocation_contract",
    "sources",
    "status_dispositions",
    "terminal_dispositions",
    "invariants"
  ],
  "properties": {
    "schema_version": {"const": "mainframe-env.jes-dd-surface@1"},
    "target_version": {"const": "0.8.0"},
    "plan_authority": {"const": "mainframe-env.jcl-plan@1"},
    "dataset_authority": {"const": "mainframe-env.dataset-request@2"},
    "allocation_contract": {"const": "mainframe-env.jes-dd-allocation@1"},
    "sources": {"$ref": "#/$defs/boundedUniqueStrings"},
    "status_dispositions": {"$ref": "#/$defs/boundedUniqueStrings"},
    "terminal_dispositions": {"$ref": "#/$defs/boundedUniqueStrings"},
    "invariants": {"$ref": "#/$defs/boundedUniqueStrings"}
  },
  "$defs": {
    "boundedUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    }
  }
}
