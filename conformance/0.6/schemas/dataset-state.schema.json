{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/dataset-state.schema.json",
  "title": "Portable dataset state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "state_schema_version", "dataset", "version", "definition",
    "pdse_directory", "allocated_bytes", "used_bytes", "content_digest"
  ],
  "properties": {
    "schema_version": { "const": "mainframe-env.dataset-state@5" },
    "state_schema_version": { "const": 5 },
    "dataset": { "$ref": "#/$defs/name" },
    "version": { "type": "integer", "minimum": 1 },
    "allocated_bytes": { "type": "integer", "minimum": 0 },
    "used_bytes": { "type": "integer", "minimum": 0 },
    "content_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "definition": { "$ref": "#/$defs/definition" },
    "pdse_directory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["members", "aliases"],
      "properties": {
        "members": {
          "type": "array", "maxItems": 4096,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "generations"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Z$#@][A-Z0-9$#@]{0,7}$" },
              "generations": {
                "type": "array", "minItems": 1, "maxItems": 65536,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["generation", "program_object", "record_count", "content_digest"],
                  "properties": {
                    "generation": { "type": "integer", "minimum": 1 },
                    "program_object": { "type": "boolean" },
                    "record_count": { "type": "integer", "minimum": 0 },
                    "content_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
                  }
                }
              }
            }
          }
        },
        "aliases": {
          "type": "object",
          "maxProperties": 4096,
          "propertyNames": { "pattern": "^[A-Z$#@][A-Z0-9$#@]{0,7}$" },
          "additionalProperties": { "type": "string", "pattern": "^[A-Z$#@][A-Z0-9$#@]{0,7}$" }
        }
      }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[A-Z$#@][A-Z0-9$#@.-]{0,127}$" },
    "optionalName": { "oneOf": [{ "$ref": "#/$defs/name" }, { "type": "null" }] },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attributes", "dcb", "allocation", "volumes", "sms", "vsam", "security", "catalog", "lifecycle"],
      "properties": {
        "attributes": {
          "type": "object", "additionalProperties": false,
          "required": ["organization", "record_format", "logical_record_length", "key_offset", "key_length", "ccsid"],
          "properties": {
            "organization": { "enum": ["sequential", "partitioned", "partitioned-extended", "key-sequenced", "entry-sequenced", "relative", "variable-relative", "linear"] },
            "record_format": { "enum": ["fixed", "fixed-blocked", "fixed-blocked-standard", "variable", "variable-blocked", "variable-spanned", "variable-blocked-spanned", "undefined", "line"] },
            "logical_record_length": { "type": "integer", "minimum": 1, "maximum": 1048576 },
            "key_offset": { "type": ["integer", "null"], "minimum": 0, "maximum": 1048575 },
            "key_length": { "type": ["integer", "null"], "minimum": 1, "maximum": 1048576 },
            "ccsid": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 }
          }
        },
        "dcb": {
          "type": "object", "additionalProperties": false,
          "required": ["block_size", "buffer_count", "buffer_size"],
          "properties": {
            "block_size": { "type": "integer", "minimum": 0, "maximum": 1048576 },
            "buffer_count": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "buffer_size": { "type": ["integer", "null"], "minimum": 1, "maximum": 1048576 }
          }
        },
        "allocation": {
          "type": "object", "additionalProperties": false,
          "required": ["unit", "primary", "secondary", "directory_blocks", "release_unused", "contiguous", "round_to_cylinder"],
          "properties": {
            "unit": { "enum": ["tracks", "cylinders", "blocks", "kilobytes", "megabytes", "records"] },
            "primary": { "type": "integer", "minimum": 1 },
            "secondary": { "type": "integer", "minimum": 0 },
            "directory_blocks": { "type": "integer", "minimum": 0 },
            "release_unused": { "type": "boolean" },
            "contiguous": { "type": "boolean" },
            "round_to_cylinder": { "type": "boolean" }
          }
        },
        "volumes": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "volume_ids", "device_type", "unit_count"],
          "properties": {
            "kind": { "enum": ["abstract", "physical-disk", "tape"] },
            "volume_ids": { "type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": { "$ref": "#/$defs/name" } },
            "device_type": { "type": ["string", "null"], "maxLength": 128 },
            "unit_count": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "sms": {
          "type": "object", "additionalProperties": false,
          "required": ["data_class", "management_class", "storage_class", "acs_routine", "guaranteed_space", "extended_format", "extended_addressable"],
          "properties": {
            "data_class": { "type": ["string", "null"], "maxLength": 128 },
            "management_class": { "type": ["string", "null"], "maxLength": 128 },
            "storage_class": { "type": ["string", "null"], "maxLength": 128 },
            "acs_routine": { "type": ["string", "null"], "maxLength": 128 },
            "guaranteed_space": { "type": "boolean" },
            "extended_format": { "type": "boolean" },
            "extended_addressable": { "type": "boolean" }
          }
        },
        "vsam": {
          "type": "object", "additionalProperties": false,
          "required": ["control_interval_size", "control_area_size", "share_options", "access_mode", "spanned", "reuse", "speed", "write_check", "erase_on_delete", "buffering", "stripe_count"],
          "properties": {
            "control_interval_size": { "type": ["integer", "null"], "minimum": 512, "maximum": 32768, "multipleOf": 512 },
            "control_area_size": { "type": ["integer", "null"], "minimum": 1 },
            "share_options": {
              "type": "object", "additionalProperties": false,
              "required": ["cross_region", "cross_system"],
              "properties": {
                "cross_region": { "type": "integer", "minimum": 1, "maximum": 4 },
                "cross_system": { "type": "integer", "minimum": 3, "maximum": 4 }
              }
            },
            "access_mode": { "enum": ["non-rls", "rls", "tvs"] },
            "spanned": { "type": "boolean" },
            "reuse": { "type": "boolean" },
            "speed": { "type": "boolean" },
            "write_check": { "type": "boolean" },
            "erase_on_delete": { "type": "boolean" },
            "buffering": { "enum": ["system", "nonshared-resources", "local-shared-resources", "global-shared-resources"] },
            "stripe_count": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "security": {
          "type": "object", "additionalProperties": false,
          "required": ["encryption_key_label", "compression"],
          "properties": {
            "encryption_key_label": { "type": ["string", "null"], "maxLength": 128 },
            "compression": { "enum": ["none", "generic", "tailored"] }
          }
        },
        "catalog": {
          "type": "object", "additionalProperties": false,
          "required": ["entry_kind", "catalog", "owner", "expiration_date", "retention_days"],
          "properties": {
            "entry_kind": { "enum": ["dataset", "alternate-index", "path", "alias", "generation-data-group", "user-catalog", "master-catalog", "library", "volume", "page-space"] },
            "catalog": { "$ref": "#/$defs/optionalName" },
            "owner": { "type": ["string", "null"], "maxLength": 128 },
            "expiration_date": { "type": ["integer", "null"], "minimum": 1900001, "maximum": 9999366 },
            "retention_days": { "type": ["integer", "null"], "minimum": 0, "maximum": 65535 }
          }
        },
        "lifecycle": {
          "type": "object", "additionalProperties": false,
          "required": ["state", "migration_level", "backup_generation"],
          "properties": {
            "state": { "enum": ["allocated", "cataloged", "open", "closed", "migrated", "recall-pending", "recovery-required"] },
            "migration_level": { "type": "integer", "minimum": 0, "maximum": 255 },
            "backup_generation": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
