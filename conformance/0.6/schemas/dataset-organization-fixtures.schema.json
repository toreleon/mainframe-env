{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/dataset-organization-fixtures.schema.json",
  "title": "Dataset organization conformance fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": { "const": "mainframe-env.dataset-organization-fixtures@1" },
    "cases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "organization", "class", "expected"],
        "properties": {
          "id": { "type": "string", "pattern": "^dataset\\.(ksds|esds|lds|rrds|vrrds)\\.(valid|invalid)$" },
          "organization": { "enum": ["ksds", "esds", "lds", "rrds", "vrrds"] },
          "class": { "enum": ["valid", "invalid"] },
          "expected": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    }
  }
}
