{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/oracle-harness-registry@1",
  "title": "CER-1701 shared licensed-oracle harness registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_version", "environment_contract", "receipt_contract", "credit_policy", "candidate_binding", "slots"],
  "properties": {
    "schema_version": {"const": "mainframe-env.oracle-harness-registry@1"},
    "target_version": {"const": "0.17.0"},
    "environment_contract": {"const": "mainframe-env.licensed-environment-manifest@1"},
    "receipt_contract": {"const": "mainframe-env.oracle-harness-receipt@1"},
    "credit_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cer1701_licensed_differential_credit", "subsystem_validator_remains_authority", "local_or_synthetic_credit", "empty_or_pending_credit"],
      "properties": {
        "cer1701_licensed_differential_credit": {"const": 0},
        "subsystem_validator_remains_authority": {"const": true},
        "local_or_synthetic_credit": {"const": 0},
        "empty_or_pending_credit": {"const": 0}
      }
    },
    "candidate_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "required_components", "change_policy"],
      "properties": {
        "contract": {"const": "mainframe-env.oracle-candidate-binding@1"},
        "required_components": {
          "const": ["source-commit", "source-tree", "artifacts", "catalogs", "conformance-spec", "fixture", "oracle-adapter", "normalization-policy", "environment-manifest", "harness-registry"]
        },
        "change_policy": {"const": "invalidate-affected-receipts-unless-explicit-identity-compatibility-proof"}
      }
    },
    "slots": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/slot_entry"}
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9_.:/@+-]+$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "slot": {"enum": ["cobol", "racf-saf", "dataset-vsam-ams", "jes2", "cics", "db2", "ims", "mq", "zosmf", "cross-resource"]},
    "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(conformance|docs)/[A-Za-z0-9._/@+-]+$"},
    "slot_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_id", "campaign_state", "required_baselines", "fixture", "adapter", "capture", "normalization", "bounds", "blockers"],
      "properties": {
        "slot_id": {"$ref": "#/$defs/slot"},
        "campaign_state": {"const": "pending"},
        "required_baselines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "fixture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "authority", "path", "digest", "digest_rule"],
          "properties": {
            "state": {"enum": ["ready", "pending"]},
            "authority": {"const": "independent-from-candidate-handler"},
            "path": {"type": ["string", "null"], "maxLength": 512, "pattern": "^conformance/[A-Za-z0-9._/@+-]+$"},
            "digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
            "digest_rule": {"enum": ["file-bytes-sha256", "cobol-four-fixture-length-prefix-sha256", "pending"]}
          }
        },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "policy_path", "accepted_read_versions", "read_rule", "validator_argv", "subsystem_validator_required"],
          "properties": {
            "state": {"enum": ["ready", "pending"]},
            "policy_path": {"type": ["string", "null"], "maxLength": 512, "pattern": "^conformance/[A-Za-z0-9._/@+-]+$"},
            "accepted_read_versions": {
              "type": "array",
              "maxItems": 8,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/id"}
            },
            "read_rule": {"enum": ["exact-v1-plus-cer1701-envelope", "pending-no-reader"]},
            "validator_argv": {
              "type": "array",
              "maxItems": 16,
              "items": {"type": "string", "minLength": 1, "maxLength": 256}
            },
            "subsystem_validator_required": {"const": true}
          }
        },
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol", "raw_outputs_outside_git", "protected_attestation_required", "required_environment_variables"],
          "properties": {
            "protocol": {"enum": ["legacy-receipt", "signed-capture", "pending"]},
            "raw_outputs_outside_git": {"const": true},
            "protected_attestation_required": {"type": "boolean"},
            "required_environment_variables": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$"}
            }
          }
        },
        "normalization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "policy_id", "policy_digest", "rules"],
          "properties": {
            "state": {"enum": ["reviewed", "pending-review"]},
            "policy_id": {"$ref": "#/$defs/id"},
            "policy_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
            "rules": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["field", "operation", "reason"],
                "properties": {
                  "field": {"type": "string", "minLength": 1, "maxLength": 256},
                  "operation": {"enum": ["exact", "stable-order", "crlf-to-lf", "documented-field-elision"]},
                  "reason": {"type": "string", "minLength": 1, "maxLength": 512}
                }
              }
            }
          }
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expected_cases", "max_raw_capture_bytes", "max_normalized_bytes", "timeout_seconds"],
          "properties": {
            "expected_cases": {"type": ["integer", "null"], "minimum": 1, "maximum": 100000},
            "max_raw_capture_bytes": {"type": "integer", "minimum": 1024, "maximum": 1073741824},
            "max_normalized_bytes": {"type": "integer", "minimum": 1024, "maximum": 67108864},
            "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 604800}
          }
        },
        "blockers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"adapter": {"properties": {"state": {"const": "ready"}}}}},
          "then": {
            "properties": {
              "adapter": {
                "properties": {
                  "policy_path": {"type": "string"},
                  "accepted_read_versions": {"minItems": 1},
                  "read_rule": {"const": "exact-v1-plus-cer1701-envelope"},
                  "validator_argv": {"minItems": 3}
                }
              }
            }
          },
          "else": {
            "properties": {
              "adapter": {
                "properties": {
                  "policy_path": {"type": "null"},
                  "accepted_read_versions": {"maxItems": 0},
                  "read_rule": {"const": "pending-no-reader"},
                  "validator_argv": {"maxItems": 0}
                }
              }
            }
          }
        }
      ]
    }
  }
}
