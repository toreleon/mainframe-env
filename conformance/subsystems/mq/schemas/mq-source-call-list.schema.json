{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/mq-source-call-list.schema.json",
  "title": "mainframe-env MQ source call-list provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_subsystem",
    "work_package",
    "baseline_id",
    "official_catalog",
    "source",
    "source_row_count",
    "unique_call_count",
    "semantic_authority",
    "coverage_credit",
    "rows"
  ],
  "properties": {
    "schema_version": {"const": "mainframe-env.mq-source-call-list@1"},
    "target_subsystem": {"const": "mq.programming"},
    "work_package": {"const": "MQ-1501.call-denominator"},
    "baseline_id": {"const": "ibm-mq-9.4-mqi-2026-08-31"},
    "official_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "unit"],
      "properties": {
        "path": {"const": "conformance/subsystems/coverage/catalogs/mq.json"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "unit": {"const": "mqi-calls-unique"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic_path", "sha256", "first_line", "last_line"],
      "properties": {
        "topic_path": {"const": "SSFKSJ_9.4.0/refdev/q101650_.html"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "first_line": {"const": 4},
        "last_line": {"const": 30}
      }
    },
    "source_row_count": {"const": 27},
    "unique_call_count": {"const": 26},
    "semantic_authority": {"const": false},
    "coverage_credit": {"const": 0},
    "rows": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_position",
          "label",
          "official_row",
          "duplicate_of_source_position"
        ],
        "properties": {
          "source_position": {"type": "integer", "minimum": 1, "maximum": 27},
          "label": {"type": "string", "pattern": "^MQ[A-Z0-9_]+$"},
          "official_row": {
            "type": "string",
            "pattern": "^ibm-mq-9\\.4-mqi-2026-08-31:mqi-calls-unique:[0-9]{4}$"
          },
          "duplicate_of_source_position": {
            "oneOf": [
              {"type": "null"},
              {"type": "integer", "minimum": 1, "maximum": 26}
            ]
          }
        }
      }
    }
  }
}
