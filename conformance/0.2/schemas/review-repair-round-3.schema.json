{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/review-repair-round-3@1",
  "title": "mainframe-env 0.2 third independent review repair evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "derived", "status", "evidence_digest", "receipt"],
  "properties": {
    "schema_version": {"const": "mainframe-env.review-repair-round-3@1"},
    "derived": {"const": true},
    "status": {"const": "pass"},
    "evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_version",
        "source_identity",
        "prerequisite_source",
        "prerequisite_commit",
        "candidate_source_digest",
        "historical_repairs",
        "findings",
        "commands",
        "toolchains",
        "pull_request",
        "artifacts",
        "remote_actions"
      ],
      "properties": {
        "target_version": {"const": "0.2.0"},
        "source_identity": {"const": "2513e9e56f330369e4a5f4e9a06c043ca99a024a"},
        "prerequisite_source": {"const": "d4b94362af56f2847bbd62d106867e6f0bb0648a"},
        "prerequisite_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "candidate_source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "historical_repairs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["round", "completion_commit", "evidence_path", "evidence_digest", "validation"],
            "properties": {
              "round": {"type": "integer", "minimum": 1, "maximum": 2},
              "completion_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "evidence_path": {"type": "string", "pattern": "^conformance/0\\.2/evidence/review-repair(-round-2)?\\.json$"},
              "evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "validation": {"const": "commit-bound"}
            }
          }
        },
        "findings": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "state", "repair", "regression"],
            "properties": {
              "id": {"type": "integer", "minimum": 1, "maximum": 11},
              "state": {"const": "closed"},
              "repair": {"type": "string", "minLength": 1},
              "regression": {"type": "string", "minLength": 1}
            }
          }
        },
        "commands": {
          "type": "array",
          "minItems": 25,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "exit_code", "result"],
            "properties": {
              "command": {"type": "string", "minLength": 1},
              "exit_code": {"const": 0},
              "result": {"type": "string", "minLength": 1}
            }
          }
        },
        "toolchains": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rust", "cargo", "msrv", "zowe_cli", "postgresql", "targets"],
          "properties": {
            "rust": {"const": "1.98.0"},
            "cargo": {"const": "1.98.0"},
            "msrv": {"const": "1.95.0"},
            "zowe_cli": {"const": "8.36.0"},
            "postgresql": {"const": "18"},
            "targets": {
              "type": "array",
              "prefixItems": [
                {"const": "aarch64-apple-darwin"},
                {"const": "x86_64-unknown-linux-gnu"}
              ],
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "pull_request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["number", "head", "base", "check_identities"],
          "properties": {
            "number": {"const": 1},
            "head": {"const": "impl/0.2.0"},
            "base": {"const": "main"},
            "check_identities": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["workflow", "job", "source_run_id", "source_check_run_id", "source_conclusion"],
                "properties": {
                  "workflow": {"const": "mainframe-env"},
                  "job": {"enum": ["v0-foundation", "contract-msrv"]},
                  "source_run_id": {"type": "integer", "minimum": 1},
                  "source_check_run_id": {"type": "integer", "minimum": 1},
                  "source_conclusion": {"const": "SUCCESS"}
                }
              }
            }
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          }
        },
        "remote_actions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tagged", "published", "deployed", "merged"],
          "properties": {
            "tagged": {"const": false},
            "published": {"const": false},
            "deployed": {"const": false},
            "merged": {"const": false}
          }
        }
      }
    }
  }
}
