{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/ims-call-applicability@1",
  "title": "Reviewed IMS call-family applicability rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_version", "baseline_id", "source_topics", "organization_classes", "context_classes", "ssa_classes", "option_classes", "profiles", "families", "diagnostics"],
  "properties": {
    "schema_version": {"const": "mainframe-env.ims-call-applicability@1"},
    "target_version": {"const": "0.14.0"},
    "baseline_id": {"const": "ibm-ims-15.6-dli-2026-08-31"},
    "source_topics": {
      "type": "object", "minProperties": 11, "maxProperties": 11,
      "additionalProperties": {"type": "string", "pattern": "^SSEPH2_15\\.6\\.0/.*\\.htm$"}
    },
    "organization_classes": {"$ref": "#/$defs/classes"},
    "context_classes": {"$ref": "#/$defs/classes"},
    "ssa_classes": {"$ref": "#/$defs/classes"},
    "option_classes": {"$ref": "#/$defs/classes"},
    "profiles": {
      "type": "object", "minProperties": 25, "maxProperties": 25,
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["contexts", "pcb", "organizations", "options", "ssa", "sources"],
        "properties": {
          "contexts": {"type": "string"},
          "pcb": {"enum": ["none", "database", "gsam", "io", "alternate"]},
          "organizations": {"type": "string"},
          "options": {"type": "string"},
          "ssa": {"type": "string"},
          "names": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z0-9]{1,8}$"}, "uniqueItems": true},
          "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "families": {
      "type": "array", "minItems": 25, "maxItems": 25,
      "items": {
        "type": "array", "prefixItems": [
          {"type": "integer", "minimum": 1, "maximum": 25},
          {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        ], "items": false, "minItems": 2, "maxItems": 2
      }
    },
    "diagnostics": {
      "type": "array", "minItems": 9, "maxItems": 9,
      "items": {
        "type": "array", "prefixItems": [
          {"type": "string", "pattern": "^[A-Z][A-Za-z]+$"},
          {"type": "string", "pattern": "^IMS1401-[0-9]{3}$"},
          {"type": "string", "minLength": 1, "maxLength": 128}
        ], "items": false, "minItems": 3, "maxItems": 3
      }
    }
  },
  "$defs": {
    "classes": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
    }
  }
}
