{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/common-program-catalog@1",
  "title": "mainframe-env generated common program catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_version", "generated_coverage_credit", "programs"],
  "properties": {
    "schema_version": {"const": "mainframe-env.common-program-catalog@1"},
    "target_version": {"const": "0.2.0"},
    "generated_coverage_credit": {"const": 0},
    "programs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "disposition", "execution", "builtin", "tso_action", "system_service"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Z0-9$@#_-]{1,128}$"},
          "disposition": {"type": ["string", "null"], "enum": ["implemented", "cics-file-control", "network-ftp", "report-rexx", "db2-tso", "ims-controller", null]},
          "execution": {"enum": ["program-service", "idcams", "sdsf", "db2-tso", "ims-controller", "unsupported"]},
          "builtin": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]*$"},
          "tso_action": {"type": ["string", "null"], "enum": ["execute-script", "extract", null]},
          "system_service": {"type": ["string", "null"], "enum": ["cee3abd", "ceedays", "cobdatft", "mvswait", null]}
        }
      }
    }
  }
}
