{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/mq-structure-status-catalog.schema.json",
  "title": "mainframe-env IBM MQ MQI structure and status identity catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_version",
    "work_package",
    "baseline_id",
    "topic_manifest",
    "source_call_list",
    "unique_call_count",
    "verified_call_topic_count",
    "missing_call_topic_count",
    "identity_authority",
    "behavioral_coverage_credit",
    "licensed_execution_credit",
    "calls",
    "wire_options",
    "raw_layout",
    "property_profile"
  ],
  "properties": {
    "schema_version": {"const": "mainframe-env.mq-structure-status-catalog@2"},
    "target_version": {"const": "0.15.0"},
    "work_package": {"const": "MQ-1501.structure-status-catalog"},
    "baseline_id": {"const": "ibm-mq-9.4-mqi-2026-08-31"},
    "topic_manifest": {"$ref": "#/$defs/file-binding"},
    "source_call_list": {"$ref": "#/$defs/file-binding"},
    "unique_call_count": {"const": 26},
    "verified_call_topic_count": {"const": 26},
    "missing_call_topic_count": {"const": 0},
    "identity_authority": {"const": true},
    "behavioral_coverage_credit": {"const": 0},
    "licensed_execution_credit": {"const": 0},
    "wire_options": {"$ref": "#/$defs/wire-options"},
    "raw_layout": {"$ref": "#/$defs/raw-layout"},
    "property_profile": {"$ref": "#/$defs/property-profile"},
    "rfh2_profile": {"$ref": "#/$defs/rfh2-profile"},
    "calls": {
      "type": "array",
      "minItems": 26,
      "maxItems": 26,
      "items": {"$ref": "#/$defs/call"}
    }
  },
  "$defs": {
    "rfh2-profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "semantic_execution_credit",
        "property_projection_sha256",
        "sources",
        "facts",
        "identifiers",
        "fields",
        "types",
        "formatter",
        "reserved_names",
        "reserved_prefixes",
        "semantics",
        "pending_source_conflicts"
      ],
      "properties": {
        "schema_version": {
          "const": "mainframe-env.mq-rfh2-profile@1"
        },
        "semantic_execution_credit": {
          "const": 0
        },
        "property_projection_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sources": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope_id",
              "baseline_id",
              "topic_manifest"
            ],
            "properties": {
              "scope_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "baseline_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "topic_manifest": {
                "$ref": "#/$defs/file-binding"
              }
            }
          }
        },
        "facts": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "symbol",
              "decimal",
              "hexadecimal",
              "source"
            ],
            "properties": {
              "symbol": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "decimal": {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              "hexadecimal": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "source": {
                "$ref": "#/$defs/property-locator"
              }
            }
          }
        },
        "identifiers": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "symbol",
              "value",
              "source"
            ],
            "properties": {
              "symbol": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "source": {
                "$ref": "#/$defs/property-locator"
              }
            }
          }
        },
        "fields": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "offset",
              "width",
              "kind",
              "source"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "offset": {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              "width": {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "source": {
                "$ref": "#/$defs/property-locator"
              }
            }
          }
        },
        "types": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "lexical",
              "source"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "lexical": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "source": {
                "$ref": "#/$defs/property-locator"
              }
            }
          }
        },
        "formatter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inherited_ccsid",
            "name_value_ccsid"
          ],
          "properties": {
            "inherited_ccsid": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "symbol",
                "decimal",
                "source"
              ],
              "properties": {
                "symbol": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "decimal": {
                  "type": "integer",
                  "minimum": -2147483648,
                  "maximum": 2147483647
                },
                "source": {
                  "$ref": "#/$defs/property-locator"
                }
              }
            },
            "name_value_ccsid": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "decimal",
                "source"
              ],
              "properties": {
                "decimal": {
                  "type": "integer",
                  "minimum": -2147483648,
                  "maximum": 2147483647
                },
                "source": {
                  "$ref": "#/$defs/property-locator"
                }
              }
            }
          }
        },
        "reserved_names": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "names",
            "source"
          ],
          "properties": {
            "names": {
              "type": "array",
              "minItems": 17,
              "maxItems": 17,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "source": {
              "$ref": "#/$defs/property-locator"
            }
          }
        },
        "reserved_prefixes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "names",
            "source"
          ],
          "properties": {
            "names": {
              "type": "array",
              "minItems": 13,
              "maxItems": 13,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "source": {
              "$ref": "#/$defs/property-locator"
            }
          }
        },
        "semantics": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "items": {
            "$ref": "#/$defs/property-locator"
          }
        },
        "pending_source_conflicts": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "property-locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic_path",
        "topic_sha256",
        "first_line",
        "last_line",
        "fragment_sha256"
      ],
      "properties": {
        "topic_path": {
          "type": "string",
          "pattern": "^SSFKSJ_9\\.4\\.0/(refdev|develop)/q[0-9]+_\\.html$"
        },
        "topic_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "first_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000
        },
        "last_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000
        },
        "fragment_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "property-profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "semantic_execution_credit",
        "historical_catalog_sha256",
        "raw_layout_projection_sha256",
        "sources",
        "facts",
        "identifiers",
        "semantics",
        "descriptor_layout",
        "descriptor_excluded_fields",
        "default_symbol_conflict",
        "explicit_string_ccsid",
        "value_widths"
      ],
      "properties": {
        "schema_version": {
          "const": "mainframe-env.mq-property-profile@1"
        },
        "semantic_execution_credit": {
          "const": 0
        },
        "historical_catalog_sha256": {
          "const": "3dc77d004bd79ad7f6daa99ffb4a3fb958ff1d816cb6c33bc4b6bac794a23448"
        },
        "raw_layout_projection_sha256": {
          "const": "2f6d7c679543891ccc768f099963813d981871d2abd35fa7b49aa4e70732ae6a"
        },
        "sources": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope_id",
              "baseline_id",
              "topic_manifest"
            ],
            "properties": {
              "scope_id": {
                "enum": [
                  "mq-property-sources",
                  "mq-programming-supplements",
                  "ibm-mq-9.4-mqi-2026-08-31"
                ]
              },
              "baseline_id": {
                "type": "string",
                "maxLength": 100
              },
              "topic_manifest": {
                "$ref": "#/$defs/file-binding"
              }
            }
          }
        },
        "facts": {
          "type": "array",
          "minItems": 77,
          "maxItems": 77,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "symbol",
              "decimal",
              "hexadecimal",
              "source"
            ],
            "properties": {
              "symbol": {
                "type": "string",
                "pattern": "^MQ[A-Z0-9_]+$"
              },
              "decimal": {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              "hexadecimal": {
                "type": "string",
                "pattern": "^[0-9A-F]{8}$"
              },
              "source": {
                "$ref": "#/$defs/property-locator"
              },
              "platform": {
                "const": "z/OS"
              }
            }
          }
        },
        "identifiers": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "symbol",
              "value",
              "source"
            ],
            "properties": {
              "symbol": {
                "type": "string",
                "pattern": "^MQ[A-Z0-9_]+$"
              },
              "value": {
                "type": "string",
                "minLength": 4,
                "maxLength": 4
              },
              "source": {
                "$ref": "#/$defs/property-locator"
              }
            }
          }
        },
        "semantics": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "purpose",
              "source"
            ],
            "properties": {
              "purpose": {
                "type": "string",
                "maxLength": 80
              },
              "source": {
                "$ref": "#/$defs/property-locator"
              }
            }
          }
        },
        "descriptor_layout": {
          "const": "Md1"
        },
        "descriptor_excluded_fields": {
          "const": [
            "StrucId",
            "Version"
          ]
        },
        "default_symbol_conflict": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "structure_table",
            "numeric_authority",
            "disposition"
          ],
          "properties": {
            "structure_table": {
              "$ref": "#/$defs/property-locator"
            },
            "numeric_authority": {
              "const": [
                "MQPD_SUPPORT_OPTIONAL",
                "MQCOPY_DEFAULT"
              ]
            },
            "disposition": {
              "const": "explicit-constants-define-symbol-values-structure-table-numeric-columns-conflict"
            }
          }
        },
        "value_widths": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "bytes",
              "source"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "Boolean",
                  "ByteString",
                  "Int8",
                  "Int16",
                  "Int32",
                  "Int64",
                  "Float32",
                  "Float64",
                  "String",
                  "Null"
                ]
              },
              "bytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 8
              },
              "source": {
                "$ref": "#/$defs/property-locator"
              }
            }
          }
        },
        "explicit_string_ccsid": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decimal",
            "source"
          ],
          "properties": {
            "decimal": {
              "const": 1208
            },
            "source": {
              "$ref": "#/$defs/property-locator"
            }
          }
        }
      }
    },
    "raw-locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic_path",
        "topic_sha256",
        "first_line",
        "last_line",
        "fragment_sha256"
      ],
      "properties": {
        "topic_path": {
          "type": "string",
          "pattern": "^SSFKSJ_9\\.4\\.0/refdev/q[0-9]+_\\.html$"
        },
        "topic_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "first_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000
        },
        "last_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000
        },
        "fragment_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "raw-initial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value",
        "source"
      ],
      "properties": {
        "kind": {
          "enum": [
            "long",
            "identifier",
            "blanks",
            "nulls",
            "environment"
          ]
        },
        "value": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "source": {
          "$ref": "#/$defs/raw-locator"
        }
      }
    },
    "raw-field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "width",
        "offset",
        "c_line",
        "cobol_line",
        "initial",
        "writeback",
        "writeback_source"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]+$"
        },
        "kind": {
          "enum": [
            "long",
            "characters",
            "bytes",
            "alias",
            "signal-slot"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 48
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 364
        },
        "c_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000
        },
        "cobol_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000
        },
        "initial": {
          "$ref": "#/$defs/raw-initial"
        },
        "writeback": {
          "enum": [
            "input",
            "get",
            "get-put",
            "dynamic-open",
            "put-count-other",
            "single-queue-put",
            "pending-output"
          ]
        },
        "writeback_source": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/raw-locator"
            }
          ]
        }
      }
    },
    "raw-layout-descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "family",
        "version",
        "identifier",
        "prefix_bytes",
        "c_declaration",
        "cobol_declaration",
        "fields"
      ],
      "properties": {
        "kind": {
          "enum": [
            "Od1",
            "Md1",
            "Md2",
            "Gmo1",
            "Pmo1",
            "Cno1"
          ]
        },
        "family": {
          "enum": [
            "MQOD",
            "MQMD",
            "MQGMO",
            "MQPMO",
            "MQCNO"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "identifier": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4
        },
        "prefix_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 364
        },
        "c_declaration": {
          "$ref": "#/$defs/raw-locator"
        },
        "cobol_declaration": {
          "$ref": "#/$defs/raw-locator"
        },
        "fields": {
          "type": "array",
          "minItems": 3,
          "maxItems": 29,
          "items": {
            "$ref": "#/$defs/raw-field"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "Cno1"
              }
            }
          },
          "then": {
            "properties": {
              "family": {
                "const": "MQCNO"
              },
              "version": {
                "const": 1
              },
              "identifier": {
                "const": "CNO "
              },
              "prefix_bytes": {
                "const": 12
              },
              "fields": {
                "minItems": 3,
                "maxItems": 3
              }
            }
          },
          "else": {
            "properties": {
              "fields": {
                "minItems": 7
              }
            }
          }
        }
      ]
    },
