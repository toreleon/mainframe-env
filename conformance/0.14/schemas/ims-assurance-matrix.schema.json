{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/ims-assurance-matrix.schema.json",
  "title": "Bounded IMS local assurance matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_version", "coverage_credit", "cases", "pending"],
  "properties": {
    "schema_version": { "const": "mainframe-env.ims-assurance-matrix@1" },
    "target_version": { "const": "0.14.0" },
    "coverage_credit": { "const": 0 },
    "cases": {
      "type": "array",
      "minItems": 16,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/case" }
    },
    "pending": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/pending" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "foundation", "property", "backend", "test_file", "test_name", "expected", "source_scope", "source_topic", "catalog_rows"],
      "properties": {
        "id": { "type": "string", "pattern": "^IMS-A-[0-9]{3}$" },
        "foundation": { "enum": ["host", "database", "tm", "recovery", "metadata", "utility"] },
        "property": { "enum": ["saf", "malformed-limit", "cas-conflict", "replay", "reopen-corruption", "scale", "compatibility-rollback", "unknown-outcome"] },
        "backend": { "enum": ["memory", "sqlite", "deterministic-engine", "memory-and-sqlite"] },
        "test_file": { "type": "string", "pattern": "^crates/(providers/mainframe-env-ims|apps/mainframe-env-server)/.+\\.rs$" },
        "test_name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{4,120}$" },
        "expected": { "type": "string", "minLength": 20, "maxLength": 240 },
        "source_scope": { "enum": ["ims-programming-contracts", "ims-database-contracts", "ims-tm-contracts", "ims-metadata-contracts", "ims-recovery-utilities-contracts"] },
        "source_topic": { "type": "string", "pattern": "^SSEPH2_15\\.6\\.0/.+\\.htm$" },
        "catalog_rows": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^ibm-ims-15\\.6-dli-2026-08-31:dli-call-families:[0-9]{4}$" }
        }
      }
    },
    "pending": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason"],
      "properties": {
        "id": { "enum": ["public-database-engine-route", "full-25-family-gates", "licensed-ims-15.6-differential", "mixed-resource-syncpoint"] },
        "reason": { "type": "string", "minLength": 20, "maxLength": 240 }
      }
    }
  }
}
