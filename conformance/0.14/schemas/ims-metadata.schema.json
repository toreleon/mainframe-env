        "secondary_indexes": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/secondary_index"
          }
        },
        "logical_relationships": {
          "type": "array",
          "maxItems": 255,
          "items": {
            "$ref": "#/$defs/logical_relationship"
          }
        }
