{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/review-repair-round-4-inputs@1",
  "title": "Round-four evidence sealing inputs",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_version", "accepted_parent", "branch", "base", "pull_request", "github_actions_source", "findings", "commands", "workspace", "toolchains", "artifact_paths", "remote_actions"],
  "properties": {
    "schema_version": {"const": "mainframe-env.review-repair-round-4-inputs@1"},
    "target_version": {"const": "0.2.0"},
    "accepted_parent": {"const": "b61d604fbdf4867154f235d45fd4453ef7e3b79d"},
    "branch": {"const": "impl/0.2.0"},
    "base": {"const": "main"},
    "pull_request": {"const": 1},
    "github_actions_source": {"const": "conformance/0.2/evidence/sources/round-3-ci-runs.json"},
    "findings": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "state", "repair", "regression"],
        "properties": {
          "id": {"type": "integer", "minimum": 1, "maximum": 3},
          "state": {"const": "closed"},
          "repair": {"type": "string", "minLength": 1},
          "regression": {"type": "string", "minLength": 1}
        }
      }
    },
    "commands": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["command", "exit_code", "result"],
        "properties": {"command": {"type": "string", "minLength": 1}, "exit_code": {"const": 0}, "result": {"type": "string", "minLength": 1}}
      }
    },
    "workspace": {
      "type": "object", "additionalProperties": false,
      "required": ["tests_passed", "tests_ignored", "failures"],
      "properties": {"tests_passed": {"type": "integer", "minimum": 260}, "tests_ignored": {"type": "integer", "minimum": 0}, "failures": {"const": 0}}
    },
    "toolchains": {"type": "object"},
    "artifact_paths": {"type": "array", "minItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "remote_actions": {
      "type": "object", "additionalProperties": false,
      "required": ["tagged", "published", "deployed", "merged"],
      "properties": {"tagged": {"const": false}, "published": {"const": false}, "deployed": {"const": false}, "merged": {"const": false}}
    }
  }
}
