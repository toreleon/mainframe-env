        "audit": {"$ref": "#/$defs/policy-binding"},
        "canonical_effect": {"$ref": "#/$defs/policy-binding"},
        "execution": {"$ref": "#/$defs/policy-binding"},
        "persistence": {"$ref": "#/$defs/policy-binding"},
        "storage": {"$ref": "#/$defs/policy-binding"}
      }
    },
    "condition_name_authority": {"$ref": "#/$defs/condition-name-authority"},
    "participant_contract": {"$ref": "#/$defs/participant-contract"},
    "registry": {"$ref": "#/$defs/registry-summary"},
    "counts": {"$ref": "#/$defs/counts"},
    "batches": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/batch"}, {"properties": {"batch_id": {"const": "sources-a"}, "ordinal_start": {"const": 1}, "ordinal_end": {"const": 88}, "command_count": {"const": 88}, "commands": {"minItems": 88, "maxItems": 88}}}]},
        {"allOf": [{"$ref": "#/$defs/batch"}, {"properties": {"batch_id": {"const": "sources-b"}, "ordinal_start": {"const": 89}, "ordinal_end": {"const": 176}, "command_count": {"const": 88}, "commands": {"minItems": 88, "maxItems": 88}}}]},
        {"allOf": [{"$ref": "#/$defs/batch"}, {"properties": {"batch_id": {"const": "sources-c"}, "ordinal_start": {"const": 177}, "ordinal_end": {"const": 263}, "command_count": {"const": 87}, "commands": {"minItems": 87, "maxItems": 87}}}]}
      ],
      "items": false
    },
    "contract_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "source-pending"}}},
      "then": {"properties": {"semantic_authority": {"const": false}, "participant_contract": {"properties": {"status": {"const": "source-pending"}}}, "counts": {"properties": {"closed_contract_commands": {"const": 0}}}}},
      "else": {"properties": {"semantic_authority": {"const": true}, "participant_contract": {"properties": {"status": {"enum": ["frozen", "bounded-ambiguity"]}}}, "counts": {"properties": {"source_projected_commands": {"const": 263}, "source_reviewed_commands": {"const": 263}, "closed_contract_commands": {"const": 263}}}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "text": {"type": "string", "minLength": 1},
    "nullable-text": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]},
    "nullable-boolean": {"type": ["boolean", "null"]},
    "nullable-nonnegative-integer": {"type": ["integer", "null"], "minimum": 0},
    "dimension-name": {"enum": ["grammar", "option-legality", "operand-direction", "option-bounds", "resource-key", "capability-intent", "eib-response", "conditions", "context-applicability", "effect-class", "cancellation", "audit", "recovery"]},
    "exact-dimensions": {"const": ["grammar", "option-legality", "operand-direction", "option-bounds", "resource-key", "capability-intent", "eib-response", "conditions", "context-applicability", "effect-class", "cancellation", "audit", "recovery"]},
    "dimension-status": {"enum": ["resolved", "not-applicable", "bounded-ambiguity", "pending"]},
    "condition-name-authority": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "topic_path", "topic_sha256", "table_id", "allowed_names", "conditions", "allowed_names_digest_definition", "allowed_names_sha256", "conditions_digest_definition", "conditions_sha256"],
      "properties": {
        "profile": {"const": "cics-eibresp-condition-name@1"},
        "topic_path": {"const": "SSJL4D_6.x/reference-diagnostics/eib/dfhp4_eibfields.html"},
        "topic_sha256": {"$ref": "#/$defs/sha256"},
        "table_id": {"const": "dfhp4au__table_nt5_kw4_b1c"},
        "allowed_names": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{0,31}$"}},
        "conditions": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["name", "code"], "properties": {"name": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{0,31}$"}, "code": {"type": "integer", "minimum": 0, "maximum": 255}}}},
        "allowed_names_digest_definition": {"type": "string", "minLength": 1},
        "allowed_names_sha256": {"$ref": "#/$defs/sha256"},
        "conditions_digest_definition": {"type": "string", "minLength": 1},
        "conditions_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "condition-clauses": {
      "oneOf": [
