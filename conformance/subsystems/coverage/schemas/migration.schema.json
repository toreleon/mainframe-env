{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/migration@1",
  "title": "mainframe-env 0.2 migration contracts",
  "type": "object",
  "required": ["schema_version", "id", "target_subsystem", "destructive", "rollback"],
  "properties": {
    "schema_version": {
      "enum": [
        "mainframe-env.application-package-migration@1",
        "mainframe-env.batch-controller-migration@1",
        "mainframe-env.db2-catalog-migration@1",
        "mainframe-env.host-abi-migration@1",
        "mainframe-env.registry-migration@1"
      ]
    },
    "id": {"type": "string", "minLength": 1},
    "target_subsystem": {"const": "coverage.foundation"},
    "destructive": {"const": false},
    "rollback": {
      "type": "object",
      "required": ["supported"],
      "properties": {"supported": {"const": true}}
    }
  }
}
