      }
    },
    "source-input": {
      "type": "object", "additionalProperties": false, "required": ["projection", "review"],
      "properties": {"projection": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/file-binding"}]}, "review": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/review-binding"}]}}
    },
    "fact": {
      "type": "object", "additionalProperties": false, "required": ["value", "candidate_ids"],
      "properties": {
        "value": {"type": "object", "minProperties": 1},
        "candidate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^cics-[abc]-[0-9]{4}-[a-z-]+-[0-9a-f]{12}$"}}
      }
    },
    "source-dimension": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "source_projection_state", "verification_status", "facts", "issue_ids"],
      "properties": {
        "name": {"enum": ["grammar", "option-legality", "operand-direction", "conditions", "context-applicability"]},
        "source_projection_state": {"enum": ["not-projected", "projected", "declared-absent", "source-backed-not-applicable", "source-gap", "unmatched", "conflicting"]},
        "verification_status": {"enum": ["not-projected", "verified", "verified-absent", "not-applicable", "verified-with-bounded-ambiguity", "projected-unverified", "projected-absent-unverified", "projected-not-applicable-unverified", "source-gap", "unmatched", "ambiguous"]},
        "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
        "issue_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
