{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/route-registry@1",
  "title": "mainframe-env route registry binding catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "namespace", "routes"],
  "properties": {
    "schema_version": {"enum": ["mainframe-env.zosmf-official-route-bindings@1", "mainframe-env.custom-route-catalog@1"]},
    "namespace": {"enum": ["official-zosmf", "mainframe-env-custom"]},
    "catalog": {"type": "string"},
    "generated_coverage_credit": {"const": 0},
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "handler"],
        "properties": {
          "id": {"type": "string", "pattern": "^(GET|POST|PUT|DELETE) /"},
          "handler": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        }
      }
    }
  }
}
