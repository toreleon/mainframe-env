{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/cics-spi-fepi-source-authority-v1.json",
  "title": "mainframe-env CICS SPI and FEPI source authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_subsystem",
    "work_package",
    "status",
    "baseline",
    "topic",
    "tables",
    "projection_boundary",
    "source_gaps",
    "shared_authorities",
    "coverage_credit"
  ],
  "properties": {
    "schema_version": {"const": "mainframe-env.cics-spi-fepi-source-authority@1"},
    "target_subsystem": {"const": "cics.system-api"},
    "work_package": {"const": "SPI-1001.source-authority"},
    "status": {"const": "reviewed-identity-only"},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "catalog", "catalog_sha256", "manifest", "toc_url", "toc_sha256"],
      "properties": {
        "id": {"const": "ibm-cics-ts-6x-2026-08-31"},
        "catalog": {"const": "conformance/subsystems/coverage/catalogs/cics.json"},
        "catalog_sha256": {"const": "sha256:fccd2a8e5cc24dd08aeb32754daf14ed80e9f1b20b5d9e762a1b0cfe429ceeba"},
        "manifest": {"const": "conformance/subsystems/coverage/manifests/cics-topics.json"},
        "toc_url": {"const": "https://www.ibm.com/docs/api/v1/toc/cics-ts/6.x?lang=en"},
        "toc_sha256": {"const": "sha256:f65c51e52facc390c05f084e1d249ff19e68bf2d7f8d3f32d4d745faf622681a"}
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic_path",
        "sha256",
        "bytes",
        "last_modified",
        "retained_archive_locator"
      ],
      "properties": {
        "topic_path": {"const": "SSJL4D_6.x/reference-diagnostics/eib/dfha8mf.html"},
        "sha256": {"const": "sha256:78f90b09987b1a56da7cd9f0a2a36fa43a549966fa7dbeff2ad9608106ef7c25"},
        "bytes": {"const": 265761},
        "last_modified": {"const": "2026-07-23"},
        "retained_archive_locator": {
          "const": "raw/html/sha256/78/78f90b09987b1a56da7cd9f0a2a36fa43a549966fa7dbeff2ad9608106ef7c25.html"
        }
      }
    },
    "tables": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spi", "fepi"],
      "properties": {
        "spi": {"$ref": "#/$defs/spiTable"},
        "fepi": {"$ref": "#/$defs/fepiTable"}
      }
    },
    "projection_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_facts", "blocked_facts", "semantic_authority", "automatic_registration"],
      "properties": {
        "allowed_facts": {
          "const": ["official_row", "command_label", "interface", "eibfn_identity"]
        },
        "blocked_facts": {
          "const": [
            "grammar",
            "options",
            "resource_schema",
            "conditions",
            "execution_context",
            "authorized_intent",
            "audit_effect",
            "concurrency",
            "lock_order",
            "implicit_syncpoint",
            "quiesce_drain",
            "lifecycle",
            "restart",
            "recovery"
          ]
        },
        "semantic_authority": {"const": false},
        "automatic_registration": {"const": false}
      }
    },
    "source_gaps": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"$ref": "#/$defs/spiGap"},
        {"$ref": "#/$defs/fepiGap"}
      ],
      "items": false
    },
    "shared_authorities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "security", "effect", "execution", "persistence", "storage"],
      "properties": {
        "condition": {"const": "cics-eibresp-condition-name@1"},
        "security": {"const": "docs/architecture/PLUGIN-AND-SECURITY.md"},
        "effect": {"const": "mainframe-env.effect-canonical@1"},
        "execution": {"const": "docs/architecture/EXECUTION-AND-DURABILITY.md"},
        "persistence": {"const": "docs/contracts/PROVIDER-ROW-PERSISTENCE-V1.md"},
        "storage": {"const": "docs/contracts/DURABLE-STORAGE-PROFILE.md"}
      }
    },
    "coverage_credit": {"const": 0}
  },
  "$defs": {
    "duplicateLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "catalog_eibfn", "additional_source_eibfn"],
      "properties": {
        "label": {"type": "string", "minLength": 2},
        "catalog_eibfn": {"type": "string", "pattern": "^[0-9A-F]{4}$"},
        "additional_source_eibfn": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[0-9A-F]{4}$"}
        }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["official_row", "source_eibfn", "catalog_eibfn", "rule"],
      "properties": {
        "official_row": {"const": "ibm-cics-ts-6x-2026-08-31:spi-commands-unique:0192"},
        "source_eibfn": {"const": "70 32"},
        "catalog_eibfn": {"const": "7032"},
        "rule": {"const": "remove-source-whitespace"}
      }
    },
    "spiTable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_id",
        "interface",
        "raw_rows",
        "unique_command_labels",
        "official_denominator",
        "deduplication_key",
        "duplicate_labels",
        "normalizations"
      ],
      "properties": {
        "table_id": {"const": "dfha8mf__eibfn_table_cmds_spi"},
        "interface": {"const": "SPI"},
        "raw_rows": {"const": 273},
        "unique_command_labels": {"const": 269},
        "official_denominator": {"const": 269},
        "deduplication_key": {"const": "normalized-command-label"},
        "duplicate_labels": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/duplicateLabel"}
        },
        "normalizations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/normalization"}
        }
      }
    },
    "fepiTable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_id",
        "interface",
        "raw_rows",
        "unique_command_labels",
        "official_denominator",
        "deduplication_key",
        "duplicate_labels",
        "normalizations"
      ],
      "properties": {
        "table_id": {"const": "dfha8mf__eibfn_table_cmds_fepi"},
        "interface": {"const": "FEPI"},
        "raw_rows": {"const": 39},
        "unique_command_labels": {"const": 39},
        "official_denominator": {"const": 39},
        "deduplication_key": {"const": "normalized-command-label"},
        "duplicate_labels": {"const": []},
        "normalizations": {"const": []}
      }
    },
    "gapBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "interface",
        "affected_rows",
        "required_topic_path",
        "required_topic_sha256",
        "state",
        "reason",
        "dependent_facts",
        "resolution"
      ],
      "properties": {
        "id": {"type": "string"},
        "interface": {"enum": ["SPI", "FEPI"]},
        "affected_rows": {"type": "integer", "minimum": 1},
        "required_topic_path": {"type": "null"},
        "required_topic_sha256": {"type": "null"},
        "state": {"const": "blocked-unmapped-unpinned-command-bodies"},
        "reason": {"type": "string", "minLength": 40},
        "dependent_facts": {
          "const": [
            "grammar",
            "options",
            "resource_schema",
            "conditions",
            "execution_context",
            "authorized_intent",
            "audit_effect",
            "concurrency",
            "lock_order",
            "implicit_syncpoint",
            "quiesce_drain",
            "lifecycle",
            "restart",
            "recovery"
          ]
        },
        "resolution": {"type": "string", "minLength": 40}
      }
    },
    "spiGap": {
      "allOf": [
        {"$ref": "#/$defs/gapBase"},
        {
          "properties": {
            "id": {"const": "SPI-1001.source-gap.spi-command-bodies"},
            "interface": {"const": "SPI"},
            "affected_rows": {"const": 269}
          }
        }
      ]
    },
    "fepiGap": {
      "allOf": [
        {"$ref": "#/$defs/gapBase"},
        {
          "properties": {
            "id": {"const": "SPI-1001.source-gap.fepi-command-bodies"},
            "interface": {"const": "FEPI"},
            "affected_rows": {"const": 39}
          }
        }
      ]
    }
  }
}
