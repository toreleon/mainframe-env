{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/cobol-function-runtime-fixtures-v1.json",
  "title": "mainframe-env COBOL intrinsic runtime fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_version", "fixtures"],
  "properties": {
    "schema_version": {"const": "mainframe-env.cobol-function-runtime-fixtures@1"},
    "target_version": {"const": "0.4.0"},
    "fixtures": {"type": "array", "minItems": 82, "maxItems": 82, "items": {"$ref": "#/$defs/fixture"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9_.:+@/-]+$"},
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "row_id", "name", "expression", "setup"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "row_id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 64},
        "expression": {"type": "string", "minLength": 1, "maxLength": 1024},
        "setup": {"type": "string", "maxLength": 2048}
      }
    }
  }
}
