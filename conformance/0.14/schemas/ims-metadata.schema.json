        {
          "$ref": "#/$defs/alternate_terminal_pcb"
        }
      ],
      "x-ims-source-topics": [
        {
          "topic_path": "SSEPH2_15.6.0/com.ibm.ims156.doc.sur/ims_psbgendlipcbstmt.htm",
          "sha256": "0dad54edd1a9940ca9a6988e06412836ff35a706cc2e1f7fbd36eb14fa02cfba"
        },
        {
          "topic_path": "SSEPH2_15.6.0/com.ibm.ims156.doc.sur/ims_psbgenaltpcbstmt.htm",
          "sha256": "89b117adcbc8ee2c9c114ce98258df1068548b3b88e0fac1e19892ffa8aba2a1"
        }
      ]
