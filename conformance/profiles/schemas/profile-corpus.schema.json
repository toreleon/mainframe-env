{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External profile corpus pin and layout",
  "type": "object",
  "required": ["schema_version", "origin", "commit", "license_id", "license_file", "layout"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "mainframe-env.profile-corpus@1"},
    "origin": {"type": "string", "minLength": 1},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "license_id": {"type": "string", "minLength": 1},
    "license_file": {"type": "string", "minLength": 1},
    "layout": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["glob", "kind"], "additionalProperties": false,
        "properties": {
          "glob": {"type": "string", "minLength": 1},
          "kind": {"enum": ["cobol", "copybook", "jcl", "bms", "ignore", "other"]}
        }
      }
    }
  }
}
