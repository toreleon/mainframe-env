{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/dataset-state-v4-migration.schema.json",
  "title": "Dataset provider state version 4 migration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "migration_id", "from_version", "to_version", "reader_versions", "writer_version", "destructive", "steps", "failure_policy", "rollback"],
  "properties": {
    "schema_version": { "const": "mainframe-env.dataset-state-v4-migration@1" },
    "migration_id": { "const": "dataset-state-v3-to-v4" },
    "from_version": { "const": 3 },
    "to_version": { "const": 4 },
    "reader_versions": { "const": [1, 2, 3, 4] },
    "writer_version": { "const": 4 },
    "destructive": { "const": false },
    "steps": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "failure_policy": { "const": "reject-before-publication" },
    "rollback": {
      "type": "object", "additionalProperties": false,
      "required": ["supported", "method", "requires_backup", "partial_state_selected"],
      "properties": {
        "supported": { "const": true },
        "method": { "const": "restore-verified-pre-migration-provider-snapshot" },
        "requires_backup": { "const": true },
        "partial_state_selected": { "const": false }
      }
    }
  }
}
