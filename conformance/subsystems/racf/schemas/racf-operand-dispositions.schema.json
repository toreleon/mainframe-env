{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/racf-operand-dispositions-v2.json",
  "title": "mainframe-env RACF operand dispositions v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline_id",
    "coverage_credit",
    "description",
    "baseline_catalog_only_names",
    "baseline_catalog_only_families",
    "applied_names",
    "remaining_catalog_only_names",
    "remaining_catalog_only_families",
    "reviewed_catalog_only_names",
    "implemented_catalog_only_names",
    "opaque_catalog_only_names",
    "unsupported_catalog_only_names",
    "source_only_names",
    "source_only_families",
    "implemented_source_only_names",
    "unsupported_source_only_names",
    "catalog_gap_source_only_names",
    "syntax_only_names",
    "syntax_only_families",
    "implemented_syntax_only_names",
    "unsupported_syntax_only_names",
    "context_only_syntax_only_names",
    "catalog_gap_syntax_only_names",
    "dispositions",
    "publication_dispositions"
  ],
  "properties": {
    "schema_version": {"const": "mainframe-env.racf-operand-dispositions@2"},
    "baseline_id": {"const": "ibm-zos-3.2-racf-saf-2026"},
    "coverage_credit": {"const": 0},
    "description": {"type": "string", "minLength": 32, "maxLength": 1024},
    "baseline_catalog_only_names": {"type": "integer", "minimum": 0},
    "baseline_catalog_only_families": {"type": "integer", "minimum": 0},
    "applied_names": {"type": "integer", "minimum": 0},
    "remaining_catalog_only_names": {"type": "integer", "minimum": 0},
    "remaining_catalog_only_families": {"type": "integer", "minimum": 0},
    "reviewed_catalog_only_names": {"type": "integer", "minimum": 0},
    "implemented_catalog_only_names": {"type": "integer", "minimum": 0},
    "opaque_catalog_only_names": {"type": "integer", "minimum": 0},
    "unsupported_catalog_only_names": {"type": "integer", "minimum": 0},
    "source_only_names": {"type": "integer", "minimum": 0},
    "source_only_families": {"type": "integer", "minimum": 0},
    "implemented_source_only_names": {"type": "integer", "minimum": 0},
    "unsupported_source_only_names": {"type": "integer", "minimum": 0},
    "catalog_gap_source_only_names": {"type": "integer", "minimum": 0},
    "syntax_only_names": {"type": "integer", "minimum": 0},
    "syntax_only_families": {"type": "integer", "minimum": 0},
    "implemented_syntax_only_names": {"type": "integer", "minimum": 0},
    "unsupported_syntax_only_names": {"type": "integer", "minimum": 0},
    "context_only_syntax_only_names": {"type": "integer", "minimum": 0},
    "catalog_gap_syntax_only_names": {"type": "integer", "minimum": 0},
    "dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row_id",
          "keyword",
          "operand_name",
          "topic_id",
          "topic_path",
          "topic_sha256",
          "applied",
          "reason",
          "note"
        ],
        "properties": {
          "row_id": {"type": "string", "pattern": "^ibm-zos-3\\.2-racf-saf-2026:racf-command-families:[0-9]{4}$"},
          "keyword": {"type": "string", "pattern": "^[A-Z]+$", "maxLength": 16},
          "operand_name": {"type": "string", "pattern": "^[A-Z][A-Z0-9]+$", "maxLength": 32},
          "topic_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "topic_path": {"type": "string", "minLength": 1, "maxLength": 256},
          "topic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "applied": {"type": "boolean"},
          "reason": {
            "enum": [
              "renamed-to-published-operand",
              "published-as-a-value-or-subordinate-term",
              "catalog-fuses-operand-and-value",
              "named-only-in-prose-not-in-the-syntax",
              "not-published-for-this-command"
            ]
          },
          "published_operand": {"type": "string", "pattern": "^[A-Z][A-Z0-9]+$", "maxLength": 32},
          "published_form": {"type": "string", "minLength": 1, "maxLength": 128},
          "published_under": {"type": "string", "minLength": 1, "maxLength": 64},
          "review_status": {"const": "reviewed-and-intended"},
          "reviewed_by": {"type": "string", "minLength": 3, "maxLength": 128},
          "review_basis": {"type": "string", "minLength": 32, "maxLength": 512},
          "emulator_classification": {
            "enum": [
              "implemented",
              "opaque-profile-field",
              "deliberately-unimplemented"
            ]
          },
          "emulator_behavior": {"type": "string", "minLength": 24, "maxLength": 512},
          "note": {"type": "string", "minLength": 16, "maxLength": 512}
        },
        "allOf": [
          {
            "if": {"properties": {"applied": {"const": true}}},
            "then": {"required": ["published_operand", "published_form"]}
          },
          {
            "if": {"properties": {"reason": {"const": "renamed-to-published-operand"}}},
            "then": {"properties": {"applied": {"const": true}}}
          },
          {
            "if": {"properties": {"reason": {"const": "published-as-a-value-or-subordinate-term"}}},
            "then": {"required": ["published_under"]}
          },
          {
            "if": {"properties": {"applied": {"const": false}}},
            "then": {
              "required": [
                "review_status",
                "reviewed_by",
                "review_basis",
                "emulator_classification",
                "emulator_behavior"
              ]
            }
          }
        ]
      }
    },
    "publication_dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["row_id", "keyword", "source_only", "syntax_only", "syntax_contexts", "flat_value_roles", "emulator_behavior"],
        "properties": {
          "row_id": {"type": "string", "pattern": "^ibm-zos-3\\.2-racf-saf-2026:racf-command-families:[0-9]{4}$"},
          "keyword": {"type": "string", "pattern": "^[A-Z]+$", "maxLength": 16},
          "source_only": {"$ref": "#/$defs/source_classification"},
          "syntax_only": {"$ref": "#/$defs/syntax_classification"},
          "syntax_contexts": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/syntax_context"}
          },
          "flat_value_roles": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/flat_value_roles"}
          },
          "emulator_behavior": {"type": "string", "minLength": 32, "maxLength": 512}
        }
      }
    }
  },
  "$defs": {
    "source_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implemented", "deliberately_unimplemented", "catalog_gaps"],
      "properties": {
        "implemented": {"$ref": "#/$defs/names"},
        "deliberately_unimplemented": {"$ref": "#/$defs/names"},
        "catalog_gaps": {"$ref": "#/$defs/names"}
      }
    },
    "syntax_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implemented", "deliberately_unimplemented", "context_only", "catalog_gaps"],
      "properties": {
        "implemented": {"$ref": "#/$defs/names"},
        "deliberately_unimplemented": {"$ref": "#/$defs/names"},
        "context_only": {"$ref": "#/$defs/names"},
        "catalog_gaps": {"$ref": "#/$defs/names"}
      }
    },
    "syntax_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "runtime_behavior", "command_level", "within_paths", "note"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*$", "maxLength": 32},
        "runtime_behavior": {
          "enum": ["implemented", "unsupported-capability", "analysis-only"]
        },
        "command_level": {"type": "boolean"},
        "within_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*$", "maxLength": 32}
          }
        },
        "note": {"type": "string", "minLength": 24, "maxLength": 512}
      }
    },
    "flat_value_roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["within_path", "roles", "note"],
      "properties": {
        "within_path": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*$", "maxLength": 32}
        },
        "roles": {"$ref": "#/$defs/names"},
        "note": {"type": "string", "minLength": 24, "maxLength": 512}
      }
    },
    "names": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9-]*$",
        "maxLength": 32
      }
    }
  }
}
