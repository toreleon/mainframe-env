{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/conformance-ledger-v1.json",
  "title": "mainframe-env verdict-derived conformance ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "spec_version", "catalog_digest", "spec_digest", "counts", "rows"],
  "properties": {
    "schema_version": {"const": "mainframe-env.conformance-ledger@1"},
    "spec_version": {"const": "mainframe-env.conformance-ir@1"},
    "catalog_digest": {"$ref": "#/$defs/digest"},
    "spec_digest": {"$ref": "#/$defs/digest"},
    "counts": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/count"}},
    "rows": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9_.:/@+\\-]+$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "gate": {"enum": ["recognized", "validated", "executed", "conditioned", "recovered", "differential"]},
    "state": {"enum": ["not-applicable", "pending", "failed", "passed"]},
    "count": {
      "type": "object", "additionalProperties": false,
      "required": ["gate", "pass", "fail", "pending", "non_applicable"],
      "properties": {
        "gate": {"$ref": "#/$defs/gate"},
        "pass": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "pending": {"type": "integer", "minimum": 0},
        "non_applicable": {"type": "integer", "minimum": 0}
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["obligation_id", "test_id", "verdict", "observation_digest"],
      "properties": {
        "obligation_id": {"$ref": "#/$defs/id"},
        "test_id": {"$ref": "#/$defs/id"},
        "verdict": {"enum": ["pass", "fail"]},
        "observation_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "gate_result": {
      "type": "object", "additionalProperties": false,
      "required": ["gate", "state", "mandatory_obligations", "passed_obligations", "bindings"],
      "properties": {
        "gate": {"$ref": "#/$defs/gate"},
        "state": {"$ref": "#/$defs/state"},
        "mandatory_obligations": {"type": "integer", "minimum": 0},
        "passed_obligations": {"type": "integer", "minimum": 0},
        "bindings": {"type": "array", "maxItems": 1000000, "items": {"$ref": "#/$defs/binding"}}
      }
    },
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["row_id", "subsystem", "family", "source_locator", "gates"],
      "properties": {
        "row_id": {"$ref": "#/$defs/id"},
        "subsystem": {"$ref": "#/$defs/id"},
        "family": {"$ref": "#/$defs/id"},
        "source_locator": {"type": "string", "minLength": 1, "maxLength": 2048},
        "gates": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/gate_result"}}
      }
    }
  }
}
