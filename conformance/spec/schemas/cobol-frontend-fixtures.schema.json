{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/cobol-frontend-fixtures-v1.json",
  "title": "mainframe-env COBOL frontend conformance fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_version", "fixtures"],
  "properties": {
    "schema_version": {"const": "mainframe-env.cobol-frontend-fixtures@1"},
    "target_version": {"const": "0.3.0"},
    "fixtures": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/fixture"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 64},
    "row_id": {"type": "string", "pattern": "^ibm-enterprise-cobol-6\\.5-2026-05-31:[a-z-]+:[0-9]{4}$"},
    "format": {"enum": ["fixed", "free", "variable"]},
    "library": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "source", "format"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 512},
        "source": {"type": "string", "maxLength": 65536},
        "format": {"$ref": "#/$defs/format"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "format", "options", "libraries"],
      "properties": {
        "source": {"type": "string", "minLength": 1, "maxLength": 65536},
        "format": {"$ref": "#/$defs/format"},
        "options": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {"type": "string", "maxLength": 1024}
        },
        "libraries": {
          "type": "array",
          "maxItems": 16,
          "items": {"$ref": "#/$defs/library"}
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "row_id", "target_kind", "target_id", "valid", "invalid"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "row_id": {"$ref": "#/$defs/row_id"},
        "target_kind": {"enum": ["directing", "directive-group"]},
        "target_id": {"$ref": "#/$defs/id"},
        "valid": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/case"}},
        "invalid": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/case"}}
      }
    }
  }
}
