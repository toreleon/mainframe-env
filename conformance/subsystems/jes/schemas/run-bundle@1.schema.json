{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/run-bundle@1.schema.json",
  "title": "CardDemo logical run bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provenance", "authority", "logical", "replay_digest", "wall_clock"],
  "properties": {
    "schema_version": {"const": "mainframe-env.run-bundle@1"},
    "provenance": {"const": "self-recorded"},
    "authority": {"const": "development-only"},
    "replay_digest": {"$ref": "#/$defs/digest"},
    "logical": {
      "type": "object", "additionalProperties": false,
      "required": ["corpus", "sources", "compiler", "deterministic_inputs", "initial_state", "effects", "job", "spool", "outputs", "final_catalog"],
      "properties": {
        "corpus": {"type": "object", "required": ["commit", "tree"], "properties": {"commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
        "sources": {"type": "object", "required": ["jcl", "bundle_files", "helper_sources"], "properties": {
          "jcl": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"const": "app/jcl/READACCT.jcl"}, "sha256": {"$ref": "#/$defs/digest"}}},
          "bundle_files": {"$ref": "#/$defs/digestMap"}, "helper_sources": {"$ref": "#/$defs/digestMap"}}},
        "compiler": {"type": "object", "required": ["target", "mode", "options", "toolchain", "toolchain_file_digest", "installed_artifacts"], "properties": {
          "target": {"type": "string"}, "mode": {"type": "string"}, "options": {"type": "object"}, "toolchain": {"type": "string"},
          "toolchain_file_digest": {"$ref": "#/$defs/digest"}, "installed_artifacts": {"type": "array", "minItems": 1,
            "items": {"type": "object", "required": ["name", "artifact", "semantic_identity"], "properties": {"name": {"type": "string"}, "artifact": {"$ref": "#/$defs/digest"}, "semantic_identity": {"type": "string"}}}}}},
        "deterministic_inputs": {"type": "object", "required": ["cobol_current_date", "display_ccsid", "locale", "timezone", "random_seed", "limits"], "properties": {
          "cobol_current_date": {"type": "string"}, "display_ccsid": {"type": "integer"}, "locale": {"type": "string"}, "timezone": {"type": "string"}, "random_seed": {"type": ["integer", "null"]}, "limits": {"type": "object"}}},
        "initial_state": {"$ref": "#/$defs/dataset"},
        "effects": {"type": "object", "required": ["capture_level", "not_captured", "observations"], "properties": {"capture_level": {"type": "string"}, "not_captured": {"type": "array", "items": {"type": "string"}}, "observations": {"type": "array", "items": {"type": "object", "required": ["kind"], "properties": {"kind": {"type": "string"}}}}}},
        "job": {"type": "object", "required": ["name", "state", "return_code", "abend_code", "steps"], "properties": {"name": {"const": "READACCT"}, "state": {"const": "completed"}, "return_code": {"const": 0}, "abend_code": {"type": "null"}, "steps": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "required": ["name", "state", "termination"]}}}},
        "spool": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "record_count", "records_digest", "records", "records_base64"], "properties": {"name": {"type": "string"}, "record_count": {"type": "integer", "minimum": 0}, "records_digest": {"$ref": "#/$defs/digest"}, "records": {"type": "array", "items": {"type": "string"}}, "records_base64": {"type": "array", "items": {"type": "string"}}}}},
        "outputs": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/dataset"}},
        "final_catalog": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string"}}
      }
    },
    "wall_clock": {"type": "object", "additionalProperties": false, "required": ["started_epoch_micros", "finished_epoch_micros", "duration_micros"], "properties": {"started_epoch_micros": {"type": "integer", "minimum": 0}, "finished_epoch_micros": {"type": "integer", "minimum": 0}, "duration_micros": {"type": "integer", "minimum": 0}}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "digestMap": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/digest"}},
    "dataset": {"type": "object", "required": ["attributes", "record_count", "records_digest", "records_base64"], "anyOf": [{"required": ["dataset"]}, {"required": ["name"]}], "properties": {
      "dataset": {"type": "string"}, "name": {"type": "string"}, "catalog": {"type": "array", "items": {"type": "string"}}, "source": {"type": "string"}, "source_digest": {"$ref": "#/$defs/digest"},
      "attributes": {"type": "object", "required": ["organization", "record_format", "logical_record_length", "key_offset", "key_length", "ccsid"]},
      "record_count": {"type": "integer", "minimum": 1}, "records_digest": {"$ref": "#/$defs/digest"}, "records_base64": {"type": "array", "items": {"type": "string"}}
    }}
  }
}
