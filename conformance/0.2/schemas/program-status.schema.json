{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/coverage-program-status@1",
  "title": "mainframe-env 0.2 coverage implementation program status",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_version", "implementation_status", "source_identity", "dependency_receipts", "baseline_inventory", "current_work_package", "work_packages", "commands", "evidence_paths", "dirty_tree_identity", "open_decisions", "blockers", "next_smallest_executable_step"],
  "properties": {
    "schema_version": {"const": "mainframe-env.coverage-program-status@1"},
    "target_version": {"const": "0.2.0"},
    "implementation_status": {"enum": ["in-progress", "complete", "blocked"]},
    "source_identity": {"type": "object"},
    "dependency_receipts": {"type": "array"},
    "baseline_inventory": {"type": "object"},
    "current_work_package": {"type": ["string", "null"]},
    "work_packages": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "state", "evidence"],
        "properties": {
          "id": {"pattern": "^CV-20[1-9]$"},
          "state": {"enum": ["pending", "in-progress", "pass", "blocked"]},
          "evidence": {"type": ["string", "null"]}
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["command", "exit_code", "result"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "exit_code": {"type": "integer"},
          "result": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence_paths": {"type": "array", "items": {"type": "string"}},
    "dirty_tree_identity": {"type": "object"},
    "open_decisions": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "next_smallest_executable_step": {"type": "string", "minLength": 1}
  }
}
