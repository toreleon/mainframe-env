{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/zosmf-generated-contracts@1",
  "title": "Generated z/OSMF route operation schema error and backend contracts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_subsystem", "normalization", "generated_coverage_credit", "counts", "routes", "operations", "schemas", "errors", "backend_ownership", "legacy_official_routes", "custom_namespace"],
  "properties": {
    "schema_version": {"const": "mainframe-env.zosmf-generated-contracts@1"},
    "target_subsystem": {"const": "zosmf.rest"},
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "conformance/subsystems/zosmf/catalogs/zosmf-normalization.json"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "generated_coverage_credit": {"const": 0},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["families", "headings", "operations", "routes", "schemas", "errors", "backend_families", "obligations"],
      "properties": {
        "families": {"const": 27},
        "headings": {"const": 189},
        "operations": {"const": 278},
        "routes": {"const": 352},
        "schemas": {"const": 583},
        "errors": {"const": 27},
        "backend_families": {"const": 27},
        "obligations": {"const": 1727}
      }
    },
    "routes": {"type": "array", "minItems": 352, "maxItems": 352, "items": {"$ref": "#/$defs/route"}},
    "operations": {"type": "array", "minItems": 278, "maxItems": 278, "items": {"$ref": "#/$defs/operation"}},
    "schemas": {"type": "array", "minItems": 583, "maxItems": 583, "items": {"$ref": "#/$defs/schema"}},
    "errors": {"type": "array", "minItems": 27, "maxItems": 27, "items": {"$ref": "#/$defs/error"}},
    "backend_ownership": {"type": "array", "minItems": 27, "maxItems": 27, "items": {"$ref": "#/$defs/backend"}},
    "legacy_official_routes": {"type": "array", "minItems": 23, "maxItems": 23, "items": {"$ref": "#/$defs/legacy_route"}},
    "custom_namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog", "route_count", "official_coverage_credit"],
      "properties": {
        "catalog": {"const": "conformance/subsystems/coverage/routes/custom-routes.json"},
        "route_count": {"const": 7},
        "official_coverage_credit": {"const": 0}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "id": {"type": "string", "minLength": 1, "maxLength": 300},
    "string_array": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operation_id", "method", "path", "source_uri", "query_contract", "source_evidence", "publication_state", "existing_route_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "operation_id": {"$ref": "#/$defs/id"},
        "method": {"enum": ["GET", "POST", "PUT", "DELETE", "PATCH"]},
        "path": {"type": "string", "pattern": "^/zosmf/"},
        "source_uri": {"type": "string", "pattern": "^/zosmf/"},
        "query_contract": {"type": "string", "minLength": 1},
        "source_evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "publication_state": {"enum": ["legacy-accepted-route", "withheld"]},
        "existing_route_ids": {"$ref": "#/$defs/string_array"}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "family_id", "source_row_ids", "route_ids", "authorization", "state_model", "failure_model", "backend", "schemas", "publication", "mandatory_obligations"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1},
        "family_id": {"$ref": "#/$defs/id"},
        "source_row_ids": {"$ref": "#/$defs/string_array"},
        "route_ids": {"$ref": "#/$defs/string_array"},
        "authorization": {"type": "object"},
        "state_model": {"$ref": "#/$defs/id"},
        "failure_model": {"$ref": "#/$defs/id"},
        "backend": {"type": "object"},
        "schemas": {"type": "object"},
        "publication": {"type": "object"},
        "mandatory_obligations": {"type": "array", "minItems": 5, "items": {"type": "object"}}
      }
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "resolution", "operation_ids", "source_row_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "role": {"enum": ["request", "response", "error"]},
        "resolution": {"enum": ["existing-gateway-dto", "identity-only-pending-detail", "operation-source-status-only", "family-error-reference-pinned"]},
        "operation_ids": {"$ref": "#/$defs/string_array"},
        "source_row_ids": {"$ref": "#/$defs/string_array"}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family_id", "source_error_rows", "operation_ids", "resolution"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "family_id": {"$ref": "#/$defs/id"},
        "source_error_rows": {"$ref": "#/$defs/string_array"},
        "operation_ids": {"$ref": "#/$defs/string_array"},
        "resolution": {"enum": ["operation-source-status-only", "family-error-reference-pinned"]}
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_id", "owner", "capability_version", "acceptance", "prerequisite_slice", "operation_counts"],
      "properties": {
        "family_id": {"$ref": "#/$defs/id"},
        "owner": {"type": "string", "minLength": 1},
        "capability_version": {"$ref": "#/$defs/id"},
        "acceptance": {"enum": ["accepted", "partial", "missing", "unresolved"]},
        "prerequisite_slice": {"$ref": "#/$defs/id"},
        "operation_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}
      }
    },
    "legacy_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "handler", "normalized_operation_ids", "disposition", "official_coverage_credit_added"],
      "properties": {
        "id": {"type": "string", "pattern": "^(GET|POST|PUT|DELETE) /zosmf/"},
        "handler": {"type": "string"},
        "normalized_operation_ids": {"$ref": "#/$defs/string_array"},
        "disposition": {"enum": ["mapped-existing-operation", "preserved-prior-contract-unmapped-to-0.11-source"]},
        "official_coverage_credit_added": {"const": 0}
      }
    }
  }
}
