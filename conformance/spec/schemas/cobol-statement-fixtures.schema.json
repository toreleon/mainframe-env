{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/cobol-statement-fixtures-v2.json",
  "title": "mainframe-env COBOL statement conformance fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_subsystem", "fixtures"],
  "properties": {
    "schema_version": {"const": "mainframe-env.cobol-statement-fixtures@2"},
    "target_subsystem": {"const": "cobol.structure"},
    "fixtures": {"type": "array", "minItems": 44, "maxItems": 44, "items": {"$ref": "#/$defs/fixture"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 64},
    "row_id": {"type": "string", "pattern": "^ibm-enterprise-cobol-6\\.5-2026-05-31:procedure-statements:[0-9]{4}$"},
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "class"],
      "properties": {
        "source": {"type": "string", "minLength": 1, "maxLength": 8192},
        "class": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 64},
        "format": {"enum": ["fixed", "free", "variable"]},
        "expected_targets": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "row_id", "target_id", "valid", "invalid"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "row_id": {"$ref": "#/$defs/row_id"}, "target_id": {"$ref": "#/$defs/id"},
        "valid": {"type": "array", "minItems": 2, "maxItems": 16, "items": {"$ref": "#/$defs/case"}},
        "invalid": {"type": "array", "minItems": 4, "maxItems": 16, "items": {"$ref": "#/$defs/case"}}
      }
    }
  }
}
