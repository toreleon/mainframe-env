{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/spool-request@2",
  "title": "mainframe-env spool provider request",
  "oneOf": [
    {"$ref": "#/$defs/append"},
    {"$ref": "#/$defs/list"},
    {"$ref": "#/$defs/read"},
    {"$ref": "#/$defs/seal"},
    {"$ref": "#/$defs/purge"}
  ],
  "$defs": {
    "job": {"type": "string", "pattern": "^JOB[0-9]{5,8}$"},
    "file": {"type": "string", "minLength": 1, "maxLength": 128},
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "idempotency_key", "transaction"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128},
        "transaction": {"type": ["string", "null"], "minLength": 1, "maxLength": 128}
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 262144,
      "items": {
        "type": "array",
        "maxItems": 1048576,
        "items": {"type": "integer", "minimum": 0, "maximum": 255}
      }
    },
    "append": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "job", "file", "records", "mutation"],
      "properties": {
        "kind": {"const": "append"},
        "job": {"$ref": "#/$defs/job"},
        "file": {"$ref": "#/$defs/file"},
        "records": {"$ref": "#/$defs/records"},
        "mutation": {"$ref": "#/$defs/mutation"}
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "job"],
      "properties": {"kind": {"const": "list"}, "job": {"$ref": "#/$defs/job"}}
    },
    "read": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "job", "file", "start", "max_records"],
      "properties": {
        "kind": {"const": "read"},
        "job": {"$ref": "#/$defs/job"},
        "file": {"$ref": "#/$defs/file"},
        "start": {"type": "integer", "minimum": 0},
        "max_records": {"type": "integer", "minimum": 1, "maximum": 262144}
      }
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "job", "file", "mutation"],
      "properties": {
        "kind": {"const": "seal"},
        "job": {"$ref": "#/$defs/job"},
        "file": {"$ref": "#/$defs/file"},
        "mutation": {"$ref": "#/$defs/mutation"}
      }
    },
    "purge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "job", "mutation"],
      "properties": {
        "kind": {"const": "purge"},
        "job": {"$ref": "#/$defs/job"},
        "mutation": {"$ref": "#/$defs/mutation"}
      }
    }
  }
}
