{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.example/schemas/cobol-function-boundary-runtime-fixtures.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_subsystem", "fixtures"],
  "properties": {
    "schema_version": { "const": "mainframe-env.cobol-function-boundary-runtime-fixtures@1" },
    "target_subsystem": { "const": "cobol.execution" },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "row_id", "obligation_id", "source", "expected_output"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128 },
          "row_id": { "type": "string", "pattern": "^ibm-enterprise-cobol-6\\.5-2026-05-31:intrinsic-functions:[0-9]{4}$" },
          "obligation_id": { "type": "string", "pattern": "^boundary-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128 },
          "source": { "type": "string", "minLength": 1, "maxLength": 16384 },
          "expected_output": { "type": "string", "maxLength": 16384 }
        }
      }
    }
  }
}
