{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/application-publication@1",
  "title": "Generation-bound durable subsystem publication recovery state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package", "generation", "identity", "action", "controllers", "db2", "complete"],
  "properties": {
    "schema_version": {"const": "mainframe-env.application-publication@1"},
    "package": {"type": "string", "minLength": 1, "maxLength": 256},
    "generation": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "action": {"enum": ["install", "rollback"]},
    "controllers": {"enum": ["not-applicable", "pending", "applying", "applied", "failed"]},
    "db2": {"enum": ["not-applicable", "pending", "applying", "applied", "failed"]},
    "ims": {"enum": ["not-applicable", "pending", "applying", "applied", "failed"]},
    "complete": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"complete": {"const": true}}},
      "then": {
        "properties": {
          "controllers": {"enum": ["not-applicable", "applied"]},
          "db2": {"enum": ["not-applicable", "applied"]},
          "ims": {"enum": ["not-applicable", "applied"]}
        }
      }
    }
  ]
}
