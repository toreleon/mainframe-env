{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/cics-source-corpus@1",
  "title": "CIC-901 zero-credit IBM HTML source corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_version",
    "work_package",
    "status",
    "semantic_authority",
    "automatic_registration",
    "coverage_credit",
    "differential_credit",
    "mapping",
    "topic_manifest",
    "counts",
    "mapped_command_topics",
    "linked_context_topics",
    "manual_topics",
    "excluded_navigation",
    "corpus_digest_definition",
    "corpus_sha256"
  ],
  "properties": {
    "schema_version": {"const": "mainframe-env.cics-source-corpus@1"},
    "target_version": {"const": "0.9.0"},
    "work_package": {"pattern": "^CIC-901\\.sources-[abc]-corpus$"},
    "status": {"const": "candidate"},
    "semantic_authority": {"const": false},
    "automatic_registration": {"const": false},
    "coverage_credit": {"const": 0},
    "differential_credit": {"const": 0},
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"pattern": "^conformance/0\\.9/cics/application-api-sources-[abc]-map\\.json$"},
        "sha256": {"$ref": "#/$defs/prefixedSha256"}
      }
    },
    "topic_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256", "topic_manifest_sha256", "topic_count", "total_bytes"],
      "properties": {
        "path": {"pattern": "^conformance/0\\.9/manifests/cics-application-api-sources-[abc]-topics\\.json$"},
        "file_sha256": {"$ref": "#/$defs/prefixedSha256"},
        "topic_manifest_sha256": {"$ref": "#/$defs/prefixedSha256"},
        "topic_count": {"type": "integer", "minimum": 1, "maximum": 512},
        "total_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "counts": {
      "oneOf": [
        {"$ref": "#/$defs/sourcesACounts"},
        {"$ref": "#/$defs/laterCounts"}
      ]
    },
    "mapped_command_topics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/targetTopicPath"}
    },
    "linked_context_topics": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/linkedTopic"}
    },
    "manual_topics": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/manualTopic"}
    },
    "excluded_navigation": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/excludedNavigation"}
    },
    "source_gaps": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/sourceGap"}
    },
    "supplemental_topics": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/supplementalTopic"}
    },
    "source_resolutions": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sourceResolution"}
    },
    "corpus_digest_definition": {
      "enum": [
        "SHA-256 over ASCII domain mainframe-env.cics-source-corpus@1, one NUL byte (0x00), then UTF-8 JSON with ensure_ascii=true, sort_keys=true and separators=(',', ':') of mapping, topic_manifest, counts, mapped topics, linked topics, manual topics, excluded navigation, and source gaps",
        "SHA-256 over ASCII domain mainframe-env.cics-source-corpus@1, one NUL byte (0x00), then UTF-8 JSON with ensure_ascii=true, sort_keys=true and separators=(',', ':') of mapping, topic_manifest, counts, mapped topics, linked topics, manual topics, excluded navigation, supplemental topics, and source resolutions"
      ]
    },
    "corpus_sha256": {"$ref": "#/$defs/prefixedSha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"work_package": {"const": "CIC-901.sources-a-corpus"}}},
      "then": {"required": ["source_gaps"]},
      "else": {"required": ["supplemental_topics", "source_resolutions"]}
    }
  ],
  "$defs": {
    "prefixedSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "bareSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "officialRow": {"type": "string", "pattern": "^ibm-cics-ts-6x-2026-08-31:api-commands:[0-9]{4}$"},
    "targetTopicPath": {"type": "string", "pattern": "^SSJL4D_6\\.x/(?:[A-Za-z0-9_][A-Za-z0-9_.-]*/)*[A-Za-z0-9_][A-Za-z0-9_-]*\\.html$"},
    "topicPath": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*\\.html$"},
    "sourcesACounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapping_rows", "mapped_command_topics", "linked_context_topics", "manual_topics", "html_topics", "source_gaps_pending_review"],
      "properties": {
        "mapping_rows": {"const": 88},
        "mapped_command_topics": {"const": 109},
        "linked_context_topics": {"const": 58},
        "manual_topics": {"const": 6},
        "html_topics": {"const": 173},
        "source_gaps_pending_review": {"const": 3}
      }
    },
    "laterCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapping_rows", "mapped_command_topics", "linked_context_topics", "manual_topics", "html_topics", "mapping_source_gaps", "source_gaps_unresolved", "supplemental_topics"],
      "properties": {
        "mapping_rows": {"enum": [87, 88]},
        "mapped_command_topics": {"type": "integer", "minimum": 1},
        "linked_context_topics": {"type": "integer", "minimum": 0},
        "manual_topics": {"type": "integer", "minimum": 1},
        "html_topics": {"type": "integer", "minimum": 1},
        "mapping_source_gaps": {"type": "integer", "minimum": 0},
        "source_gaps_unresolved": {"const": 0},
        "supplemental_topics": {"type": "integer", "minimum": 0}
      }
    },
    "linkedTopic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic_path", "role", "referenced_by_command_topics"],
      "properties": {
        "topic_path": {"$ref": "#/$defs/targetTopicPath"},
        "role": {"const": "one-hop-context-candidate"},
        "referenced_by_command_topics": {"type": "integer", "minimum": 1, "maximum": 512}
      }
    },
    "manualTopic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic_path", "role", "reason"],
      "properties": {
        "topic_path": {"$ref": "#/$defs/targetTopicPath"},
        "role": {"enum": ["execution-context-candidate", "operand-contract-candidate", "condition-contract-candidate", "compatibility-context-candidate", "target-command-source", "gap-classification-candidate", "gap-identity-candidate"]},
        "reason": {"enum": ["argument-value-direction-rules", "exec-command-format-local-task", "dpl-command-restrictions", "threadsafe-command-list", "response-code-table", "legacy-monitoring-successor", "legacy-monitoring-module-context", "target-command-outside-summary-tree", "exec-interface-identity-and-availability", "pinned-eibfn-command-table"]},
        "applies_to": {"enum": ["all-sources-a-rows", "all-batch-rows"]},
        "applies_to_rows": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/officialRow"}}
      },
      "oneOf": [
        {"required": ["applies_to"]},
        {"required": ["applies_to_rows"]}
      ]
    },
    "excludedNavigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic_path", "role", "referenced_by_command_topics", "reason"],
      "properties": {
        "topic_path": {"const": "SSJL4D_6.x/reference-applications/commands-api/dfhp4_commandsummary.html"},
        "role": {"const": "navigation-index"},
        "referenced_by_command_topics": {"type": "integer", "minimum": 1, "maximum": 512},
        "reason": {"const": "pinned-toc-is-navigation-authority"}
      }
    },
    "sourceGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["official_row", "label", "state", "topic_sources"],
      "properties": {
        "official_row": {"$ref": "#/$defs/officialRow"},
        "label": {"enum": ["CICSMESSAGE", "DUMP", "ENTER TRACEID"]},
        "state": {"const": "pending-review"},
        "topic_sources": {"type": "array", "minItems": 2, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/targetTopicPath"}}
      }
    },
    "supplementalTopic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic_path", "public_url", "content_url", "source_product", "product_key", "heading", "last_modified", "bytes", "sha256", "cache_key", "source_role", "target_authority_boundary", "target_product_authority", "semantic_authority", "coverage_credit", "applies_to_rows", "allowed_evidence_dimensions", "limitations"],
      "properties": {
        "topic_path": {"$ref": "#/$defs/topicPath"},
        "public_url": {"type": "string", "pattern": "^https://www\\.ibm\\.com/docs/en/"},
        "content_url": {"type": "string", "pattern": "^https://www\\.ibm\\.com/docs/api/v1/content/"},
        "source_product": {"type": "string", "minLength": 1},
        "product_key": {"type": "string", "minLength": 1},
        "heading": {"type": "string", "minLength": 1},
        "last_modified": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 2097152},
        "sha256": {"$ref": "#/$defs/bareSha256"},
        "cache_key": {"pattern": "^topic-[0-9a-f]{64}-sha256-[0-9a-f]{64}\\.html$"},
        "source_role": {"const": "cross-product-command-reference"},
        "target_authority_boundary": {"const": "cross-product-not-target-authority"},
        "target_product_authority": {"const": false},
        "semantic_authority": {"const": false},
        "coverage_credit": {"const": 0},
        "applies_to_rows": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/officialRow"}},
        "allowed_evidence_dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["syntax", "options", "operand-directions", "conditions", "execution-context"]}},
        "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}}
      }
    },
    "sourceResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["official_row", "label", "eibfn", "state", "target_topic_sources", "supplemental_topic_sources"],
      "properties": {
        "official_row": {"$ref": "#/$defs/officialRow"},
        "label": {"type": "string", "minLength": 1},
        "eibfn": {"type": "string", "pattern": "^[0-9A-F]{4}$"},
        "state": {"enum": ["target-product-authority", "cross-product-evidence"]},
        "target_topic_sources": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/targetTopicPath"}},
        "supplemental_topic_sources": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/topicPath"}}
      }
    }
  }
}
