{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/jes-state-migration@1",
  "title": "mainframe-env JES durable-state migration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_subsystem", "from", "to", "authority", "strategy", "rollback", "invariants"],
  "properties": {
    "schema_version": {"const": "mainframe-env.jes-state-migration@1"},
    "target_subsystem": {"const": "jes.execution"},
    "from": {"const": "mainframe-env.jes-durable-job@1"},
    "to": {"const": "mainframe-env.jes-durable-job@2"},
    "authority": {"const": "mainframe-env-store-api.ProviderStateStore/jes-job"},
    "strategy": {"const": "read-old-write-new-cas"},
    "rollback": {"const": "retain-v1-compatible-fields"},
    "invariants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    }
  }
}
