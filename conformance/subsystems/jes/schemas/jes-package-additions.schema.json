{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/jes-package-additions.schema.json",
  "title": "JES coverage package additions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_subsystem",
    "packages",
    "dependency_edges",
    "production_profile_membership"
  ],
  "properties": {
    "schema_version": {"const": "mainframe-env.coverage-package-additions@1"},
    "target_subsystem": {"const": "jes.execution"},
    "packages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "layer", "work_package", "justification"],
        "properties": {
          "name": {"type": "string", "pattern": "^mainframe-env-[a-z0-9-]+$"},
          "layer": {
            "enum": [
              "adapter",
              "application",
              "contracts",
              "foundation",
              "gateway",
              "kernel",
              "provider",
              "tooling"
            ]
          },
          "work_package": {"type": "string", "pattern": "^JES-[0-9]{3}$"},
          "justification": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "dependency_edges": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "array",
        "prefixItems": [
          {"type": "string", "pattern": "^mainframe-env-[a-z0-9-]+$"},
          {"type": "string", "pattern": "^mainframe-env-[a-z0-9-]+$"}
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    },
    "production_profile_membership": {"type": "boolean"}
  }
}
