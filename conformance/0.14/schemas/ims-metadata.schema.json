            {
              "type": "null"
            }
          ]
        },
        "processing_options": {
          "type": "string",
          "pattern": "^[A-Z]{1,4}$"
        },
        "sensitive_segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30000,
          "items": {
            "$ref": "#/$defs/sensitive_segment"
