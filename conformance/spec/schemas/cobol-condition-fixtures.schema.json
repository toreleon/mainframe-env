{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mainframe-env.example/schemas/cobol-condition-fixtures.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","target_subsystem","fixtures"],
  "properties":{
    "schema_version":{"const":"mainframe-env.cobol-condition-fixtures@1"},
    "target_subsystem":{"const":"cobol.execution"},
    "fixtures":{"type":"array","minItems":10,"maxItems":512,"items":{
      "type":"object","additionalProperties":false,
      "required":["id","row_id","source","host_behavior","expected_output","expected_terminal"],
      "properties":{
        "id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$","maxLength":64},
        "row_id":{"type":"string","minLength":1,"maxLength":256},
        "source":{"type":"string","minLength":1,"maxLength":16384},
        "host_behavior":{"enum":["none","read-eof","call-failure","start-not-found"]},
        "expected_output":{"type":"string","maxLength":8192},
        "expected_terminal":{"enum":["completed","condition","failed-malformed"]}
      }
    }}
  }
}
