{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/cics-source-review.schema.json",
  "title": "CICS sources-a compact automatic verification receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_version",
    "work_package",
    "review_status",
    "review_authority",
    "semantic_authority",
    "execution_authority",
    "automatic_registration",
    "coverage_credit",
    "semantic_credit",
    "differential_credit",
    "inputs",
    "review_contract",
    "independent_verification_sha256",
    "counts",
    "structural_coverage",
    "candidate_dispositions",
    "issue_dispositions",
    "blocker_ids",
    "review_sha256"
  ],
  "properties": {
    "schema_version": {"const": "mainframe-env.cics-source-review@2"},
    "target_version": {"const": "0.9.0"},
    "work_package": {"const": "CIC-901.sources-a-review"},
    "review_status": {
      "enum": ["auto-accepted", "auto-accepted-with-bounded-ambiguities", "blocked"]
    },
    "review_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "automatic_acceptance",
        "manual_approval",
        "source_derived_before_projection"
      ],
      "properties": {
        "kind": {"const": "independent-deterministic-verifier"},
        "automatic_acceptance": {"const": true},
        "manual_approval": {"const": false},
        "source_derived_before_projection": {"const": true}
      }
    },
    "semantic_authority": {"const": false},
    "execution_authority": {"const": false},
    "automatic_registration": {"const": false},
    "coverage_credit": {"const": 0},
    "semantic_credit": {"const": 0},
    "differential_credit": {"const": 0},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_map_sha256",
        "topic_manifest_sha256",
        "extraction_plan_sha256",
        "candidate_projection_sha256",
        "source_supplements_sha256"
      ],
      "properties": {
        "source_map_sha256": {"$ref": "#/$defs/sha256"},
        "topic_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "extraction_plan_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_projection_sha256": {"$ref": "#/$defs/sha256"},
        "source_supplements_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "review_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "checker", "independent_verifier"],
      "properties": {
        "schema": {"$ref": "#/$defs/file-binding"},
        "checker": {
          "allOf": [
            {"$ref": "#/$defs/tool-binding"},
            {
              "properties": {
                "path": {"const": "conformance/0.9/tools/review_cics_application_sources.py"},
                "version": {"const": "cics-source-auto-review-checker@2"}
              }
            }
          ]
        },
        "independent_verifier": {
          "allOf": [
            {"$ref": "#/$defs/tool-binding"},
            {
              "properties": {
                "path": {"const": "conformance/0.9/tools/verify_cics_application_sources.py"},
                "version": {"const": "cics-source-independent-verifier@1"}
              }
            }
          ]
        }
      }
    },
    "independent_verification_sha256": {"$ref": "#/$defs/sha256"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topics",
        "rows",
        "candidates",
        "issues",
        "unique_evidence_fragments",
        "candidate_kinds",
        "blocking_findings"
      ],
      "properties": {
        "topics": {"type": "integer", "minimum": 1},
        "rows": {"type": "integer", "minimum": 1},
        "candidates": {"type": "integer", "minimum": 1},
        "issues": {"type": "integer", "minimum": 0},
        "unique_evidence_fragments": {"type": "integer", "minimum": 1},
        "candidate_kinds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source-condition",
            "source-context",
            "source-operand-direction",
            "source-option",
            "source-syntax"
          ],
          "properties": {
            "source-condition": {"type": "integer", "minimum": 0},
            "source-context": {"type": "integer", "minimum": 0},
            "source-operand-direction": {"type": "integer", "minimum": 0},
            "source-option": {"type": "integer", "minimum": 0},
            "source-syntax": {"type": "integer", "minimum": 0}
          }
        },
        "blocking_findings": {"type": "integer", "minimum": 0}
      }
    },
    "structural_coverage": {"$ref": "#/$defs/structural-coverage"},
    "candidate_dispositions": {"$ref": "#/$defs/candidate-categories"},
    "issue_dispositions": {"$ref": "#/$defs/issue-categories"},
    "blocker_ids": {
      "type": "array",
      "maxItems": 20000,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 160}
    },
    "review_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"review_status": {"const": "auto-accepted"}}},
      "then": {
        "properties": {
          "blocker_ids": {"maxItems": 0},
          "counts": {"properties": {"blocking_findings": {"const": 0}}},
          "structural_coverage": {
            "properties": {"missing": {"const": 0}, "extra": {"const": 0}}
          }
        }
      }
    },
    {
      "if": {"properties": {"review_status": {"const": "blocked"}}},
      "then": {
        "properties": {
          "counts": {"properties": {"blocking_findings": {"minimum": 1}}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_status": {"const": "auto-accepted-with-bounded-ambiguities"}
        }
      },
      "then": {
        "properties": {
          "blocker_ids": {"minItems": 1},
          "counts": {"properties": {"blocking_findings": {"const": 0}}},
          "structural_coverage": {
            "properties": {"missing": {"const": 0}, "extra": {"const": 0}}
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "file-binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256"],
      "properties": {
        "path": {
          "const": "conformance/0.9/schemas/cics-source-review.schema.json"
        },
        "file_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "tool-binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "file_sha256"],
      "properties": {
        "path": {"type": "string"},
        "version": {"type": "string"},
        "file_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "kind-counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source-condition", "source-option", "source-syntax"],
      "properties": {
        "source-condition": {"type": "integer", "minimum": 0},
        "source-option": {"type": "integer", "minimum": 0},
        "source-syntax": {"type": "integer", "minimum": 0}
      }
    },
    "structural-coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected",
        "projected",
        "missing",
        "extra",
        "expected_by_kind",
        "projected_by_kind"
      ],
      "properties": {
        "expected": {"type": "integer", "minimum": 0},
        "projected": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0},
        "extra": {"type": "integer", "minimum": 0},
        "expected_by_kind": {"$ref": "#/$defs/kind-counts"},
        "projected_by_kind": {"$ref": "#/$defs/kind-counts"}
      }
    },
    "candidate-category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "candidate_ids_sha256"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "candidate_ids_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "issue-category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "issue_ids_sha256"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "issue_ids_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidate-categories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "requires-reprojection", "product-ambiguity", "mismatch"],
      "properties": {
        "verified": {"$ref": "#/$defs/candidate-category"},
        "requires-reprojection": {"$ref": "#/$defs/candidate-category"},
        "product-ambiguity": {"$ref": "#/$defs/candidate-category"},
        "mismatch": {"$ref": "#/$defs/candidate-category"}
      }
    },
    "issue-categories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "requires-reprojection", "product-ambiguity", "mismatch"],
      "properties": {
        "verified": {"$ref": "#/$defs/issue-category"},
        "requires-reprojection": {"$ref": "#/$defs/issue-category"},
        "product-ambiguity": {"$ref": "#/$defs/issue-category"},
        "mismatch": {"$ref": "#/$defs/issue-category"}
      }
    }
  }
}
