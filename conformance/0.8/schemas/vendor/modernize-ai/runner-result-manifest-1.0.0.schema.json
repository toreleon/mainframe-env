{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.modernize.ai/runner-result-manifest/1.0.0",
  "title":"RunnerResultManifest 1.0.0","type":"object","additionalProperties":false,
  "required":["resultVersion","executionManifest","observation","runnerBuild","executable","runtime","runtimeContract","shim","stateSnapshot","policy","comparatorRegistry","authority","logicalResultDigest","sideEffectSetDigest","termination","attemptReceipt"],
  "properties": {
    "resultVersion":{"const":"1.0.0"},"executionManifest":{"$ref":"https://schemas.modernize.ai/p5-common/1.0.0#/$defs/artifactRef"},"observation":{"$ref":"https://schemas.modernize.ai/p5-common/1.0.0#/$defs/artifactRef"},"runnerBuild":{"$ref":"https://schemas.modernize.ai/p5-common/1.0.0#/$defs/artifactRef"},"executable":{"$ref":"https://schemas.modernize.ai/p5-common/1.0.0#/$defs/digestRef"},"runtime":{"$ref":"https://schemas.modernize.ai/p5-common/1.0.0#/$defs/digestRef"},"runtimeContract":{"$ref":"https://schemas.modernize.ai/p5-common/1.0.0#/$defs/artifactRef"},"shim":{"$ref":"https://schemas.modernize.ai/p5-common/1.0.0#/$defs/artifactRef"},"stateSnapshot":{"$ref":"https://schemas.modernize.ai/p5-common/1.0.0#/$defs/artifactRef"},"policy":{"$ref":"https://schemas.modernize.ai/p5-common/1.0.0#/$defs/artifactRef"},"comparatorRegistry":{"$ref":"https://schemas.modernize.ai/p5-common/1.0.0#/$defs/digestRef"},"authority":{"$ref":"https://schemas.modernize.ai/p5-common/1.0.0#/$defs/p5Authority"},"logicalResultDigest":{"$ref":"https://schemas.modernize.ai/p5-common/1.0.0#/$defs/sha256"},"sideEffectSetDigest":{"$ref":"https://schemas.modernize.ai/p5-common/1.0.0#/$defs/sha256"},
    "termination":{"type":"object","additionalProperties":false,"required":["kind","code","abendCode","failurePoint"],"properties":{"kind":{"enum":["return-code","abend","infrastructure-failure"]},"code":{"type":["integer","null"],"minimum":0,"maximum":4095},"abendCode":{"type":["integer","null"],"minimum":0,"maximum":4095},"failurePoint":{"type":["string","null"],"maxLength":160}}},
    "attemptReceipt":{"type":"object","additionalProperties":false,"required":["attemptId","processIdentity","attempt","exitCode","cleanupStatus","stdoutBytes","stderrBytes","resultBytes","pidObserved"],"properties":{"attemptId":{"type":"string","pattern":"^attempt_[0-9a-f]{64}$"},"processIdentity":{"type":"string","pattern":"^process_[0-9a-f]{64}$"},"attempt":{"type":"integer","minimum":1,"maximum":100},"exitCode":{"type":["integer","null"],"minimum":0,"maximum":255},"cleanupStatus":{"enum":["clean","failed"]},"stdoutBytes":{"type":"integer","minimum":0,"maximum":10485760},"stderrBytes":{"type":"integer","minimum":0,"maximum":10485760},"resultBytes":{"type":"integer","minimum":0,"maximum":10485760},"pidObserved":{"type":"boolean"}}}
  }
