      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "parent",
        "min_length",
        "max_length",
        "fields"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "parent": {
          "oneOf": [
