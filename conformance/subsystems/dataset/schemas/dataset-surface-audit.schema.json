{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/dataset-surface-audit.schema.json",
  "title": "Dataset programming surface evidence audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_subsystem", "inventory_sha256", "summary", "bindings"],
  "properties": {
    "schema_version": { "const": "mainframe-env.dataset-surface-audit@1" },
    "target_subsystem": { "const": "dataset.data" },
    "inventory_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["descriptors", "required_pass", "capability_pass", "capability_conditioned"],
      "properties": {
        "descriptors": { "const": 131 },
        "required_pass": { "const": 97 },
        "capability_pass": { "const": 9 },
        "capability_conditioned": { "const": 25 }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "disposition", "descriptors", "tests"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 96 },
          "disposition": {
            "enum": ["required-pass", "capability-pass", "capability-conditioned"]
          },
          "descriptors": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+:[a-z0-9-]+$",
              "maxLength": 128
            }
          },
          "tests": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+(?:::[a-zA-Z0-9_]+)+$",
              "maxLength": 256
            }
          }
        }
      }
    }
  }
}
