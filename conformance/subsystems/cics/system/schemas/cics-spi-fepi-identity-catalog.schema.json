{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/cics-spi-fepi-identity-catalog-v1.json",
  "title": "mainframe-env CICS SPI and FEPI identity catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_subsystem",
    "work_package",
    "status",
    "inputs",
    "counts",
    "projection_boundary",
    "shared_authorities",
    "commands",
    "identity_sha256",
    "coverage_credit"
  ],
  "properties": {
    "schema_version": {"const": "mainframe-env.cics-spi-fepi-identity-catalog@1"},
    "target_subsystem": {"const": "cics.system-api"},
    "work_package": {"const": "SPI-1001.catalog"},
    "status": {"const": "identity-only-source-gapped"},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["official_catalog", "official_catalog_sha256", "source_authority", "source_authority_sha256"],
      "properties": {
        "official_catalog": {"const": "conformance/subsystems/coverage/catalogs/cics.json"},
        "official_catalog_sha256": {"pattern": "^sha256:[0-9a-f]{64}$"},
        "source_authority": {"const": "conformance/subsystems/cics/system/cics/spi-fepi-source-authority.json"},
        "source_authority_sha256": {"pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spi", "fepi", "total", "raw_source_rows", "deduplicated_source_rows"],
      "properties": {
        "spi": {"const": 269},
        "fepi": {"const": 39},
        "total": {"const": 308},
        "raw_source_rows": {"const": 312},
        "deduplicated_source_rows": {"const": 4}
      }
    },
    "projection_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_authority", "automatic_registration", "public_routes", "runtime_handlers"],
      "properties": {
        "semantic_authority": {"const": false},
        "automatic_registration": {"const": false},
        "public_routes": {"const": false},
        "runtime_handlers": {"const": 0}
      }
    },
    "shared_authorities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "security", "effect", "execution", "persistence", "storage"],
      "properties": {
        "condition": {"const": "cics-eibresp-condition-name@1"},
        "security": {"const": "docs/architecture/PLUGIN-AND-SECURITY.md"},
        "effect": {"const": "mainframe-env.effect-canonical@1"},
        "execution": {"const": "docs/architecture/EXECUTION-AND-DURABILITY.md"},
        "persistence": {"const": "docs/contracts/PROVIDER-ROW-PERSISTENCE-V1.md"},
        "storage": {"const": "docs/contracts/DURABLE-STORAGE-PROFILE.md"}
      }
    },
    "commands": {
      "type": "array",
      "minItems": 308,
      "maxItems": 308,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/command"}
    },
    "identity_sha256": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "coverage_credit": {"const": 0}
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "official_row",
        "interface",
        "label",
        "label_tokens",
        "source_label_aliases",
        "eibfn",
        "additional_eibfn_codes",
        "shared_eibfn_rows",
        "source",
        "semantic_contract",
        "runtime",
        "coverage_credit"
      ],
      "properties": {
        "official_row": {
          "type": "string",
          "pattern": "^ibm-cics-ts-6x-2026-08-31:(?:spi-commands-unique:(?:000[1-9]|00[1-9][0-9]|01[0-9]{2}|02[0-5][0-9]|026[0-9])|fepi-commands:(?:000[1-9]|00[1-3][0-9]))$"
        },
        "interface": {"enum": ["SPI", "FEPI"]},
        "label": {"type": "string", "minLength": 2, "maxLength": 128},
        "label_tokens": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^\\S+$"}
        },
        "source_label_aliases": {"const": []},
        "eibfn": {"type": "string", "pattern": "^[0-9A-F]{4}$"},
        "additional_eibfn_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[0-9A-F]{4}$"}
        },
        "shared_eibfn_rows": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ibm-cics-ts-6x-2026-08-31:(?:spi-commands-unique|fepi-commands):[0-9]{4}$"
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["topic_path", "topic_sha256", "table_id", "source_locator"],
          "properties": {
            "topic_path": {"const": "SSJL4D_6.x/reference-diagnostics/eib/dfha8mf.html"},
            "topic_sha256": {"const": "sha256:78f90b09987b1a56da7cd9f0a2a36fa43a549966fa7dbeff2ad9608106ef7c25"},
            "table_id": {"enum": ["dfha8mf__eibfn_table_cmds_spi", "dfha8mf__eibfn_table_cmds_fepi"]},
            "source_locator": {"type": "string", "minLength": 40}
          }
        },
        "semantic_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "source_gap", "blocked_facts"],
          "properties": {
            "state": {"const": "blocked-source-gap"},
            "source_gap": {
              "enum": [
                "SPI-1001.source-gap.spi-command-bodies",
                "SPI-1001.source-gap.fepi-command-bodies"
              ]
            },
            "blocked_facts": {
              "const": [
                "grammar",
                "options",
                "resource_schema",
                "conditions",
                "execution_context",
                "authorized_intent",
                "audit_effect",
                "concurrency",
                "lock_order",
                "implicit_syncpoint",
                "quiesce_drain",
                "lifecycle",
                "restart",
                "recovery"
              ]
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["handler", "advertised", "automatically_registered"],
          "properties": {
            "handler": {"type": "null"},
            "advertised": {"const": false},
            "automatically_registered": {"const": false}
          }
        },
        "coverage_credit": {"const": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"interface": {"const": "SPI"}}},
          "then": {
            "properties": {
              "official_row": {"pattern": ":spi-commands-unique:"},
              "semantic_contract": {
                "properties": {
                  "source_gap": {"const": "SPI-1001.source-gap.spi-command-bodies"}
                }
              }
            }
          },
          "else": {
            "properties": {
              "official_row": {"pattern": ":fepi-commands:"},
              "semantic_contract": {
                "properties": {
                  "source_gap": {"const": "SPI-1001.source-gap.fepi-command-bodies"}
                }
              }
            }
          }
        }
      ]
    }
  }
}
