{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/cics-application-command-contracts@2",
  "title": "Frozen CICS application command contract and registry shape",
  "description": "Source-bound, non-executable 263-row CIC-901 contract. Only existing API handlers are advertised; no conformance credit is granted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "target_version", "work_package", "status",
    "automatic_registration", "semantic_authority", "execution_authority",
    "coverage_credit", "semantic_credit", "differential_credit", "inputs",
    "contract_dimensions", "host_limits", "policy_bindings", "condition_name_authority", "participant_contract", "registry",
    "counts", "batches", "contract_sha256"
  ],
  "properties": {
    "schema_version": {"const": "mainframe-env.cics-application-command-contracts@2"},
    "target_version": {"const": "0.9.0"},
    "work_package": {"const": "CIC-901.command-contract"},
    "status": {"enum": ["source-pending", "frozen", "frozen-with-bounded-ambiguities"]},
    "automatic_registration": {"const": false},
    "semantic_authority": {"type": "boolean"},
    "execution_authority": {"const": false},
    "coverage_credit": {"const": 0},
    "semantic_credit": {"const": 0},
    "differential_credit": {"const": 0},
    "inputs": {
      "type": "object", "additionalProperties": false,
      "required": ["command_descriptors"],
      "properties": {
        "command_descriptors": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "file_sha256", "application_identity_set_sha256"],
          "properties": {
            "path": {"const": "conformance/0.9/cics/command-descriptors.json"},
            "file_sha256": {"$ref": "#/$defs/sha256"},
            "application_identity_set_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "contract_dimensions": {"$ref": "#/$defs/exact-dimensions"},
    "host_limits": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "max_argument_count", "max_argument_name_bytes", "max_argument_value_bytes", "max_request_bytes"],
      "properties": {
        "profile": {"const": "mainframe-env.host-cics-bounds@1"},
        "max_argument_count": {"const": 512},
        "max_argument_name_bytes": {"const": 128},
        "max_argument_value_bytes": {"const": 1048576},
        "max_request_bytes": {"const": 4194304}
      }
    },
    "policy_bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["authorization", "audit", "canonical_effect", "execution", "persistence", "storage"],
