            "options": {"const": ["TOKEN", "UPDATE"]},
            "predicate": {"const": "presence-selects-read-for-update-or-lock-token"},
            "affected_dimensions": {"const": ["resource-key", "capability-intent", "effect-class", "cancellation", "audit", "recovery"]},
            "status": {"const": "bounded-ambiguity"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["options", "predicate", "affected_dimensions", "status"],
          "properties": {
            "options": {"const": ["ROLLBACK"]},
            "predicate": {"const": "presence-selects-rollback-otherwise-commit"},
            "affected_dimensions": {"const": ["recovery"]},
            "status": {"const": "resolved"}
          }
        }
      ]
    },
    "policy-binding": {"type": "object", "minProperties": 2, "required": ["contract"], "additionalProperties": {"$ref": "#/$defs/text"}},
    "file-binding": {
