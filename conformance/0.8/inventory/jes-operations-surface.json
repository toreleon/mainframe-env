{
  "schema_version": "mainframe-env.jes-operations-inventory@1",
  "target_version": "0.8.0",
  "work_package": "JES-804",
  "submission_kinds": {
    "batch": ["external", "internal-reader"],
    "started-task": ["started-task"]
  },
  "durable_authorities": {
    "jobs": "mainframe-env-store-api.ProviderStateStore/jes-job",
    "scheduler": "mainframe-env-store-api.ProviderStateStore/jes-scheduler",
    "topology": "mainframe-env-store-api.ProviderStateStore/jes-topology",
    "claims_and_leases": "mainframe-env-store-api.WorkStore"
  },
  "authorization": {
    "submission_selection_and_job_controls": "JESJOBS",
    "started_task_start_stop": "STARTED",
    "initiator_and_topology_controls": "OPERCMDS",
    "spool_and_output_access": "JESJOBS"
  },
  "job_controls": [
    "hold-job",
    "release-job",
    "cancel-job",
    "purge-job",
    "change-class",
    "change-priority",
    "route-job"
  ],
  "output_controls": [
    "hold-output",
    "release-output",
    "route-output",
    "select-output",
    "complete-output",
    "purge-output"
  ],
  "operator_controls": [
    "start-initiator",
    "stop-initiator",
    "start-task",
    "stop-task",
    "install-topology"
  ],
  "nje_projection": ["origin_node", "execution_node", "output_node"],
  "mas_projection": ["member", "node", "enabled", "max_active", "job_owner_member"],
  "bounds": {"nodes": 256, "members": 4096, "node_name_bytes": 16},
  "non_claims": [
    "physical JES2 multi-access spool",
    "SNA or NJE transport protocol",
    "sysplex data-sharing or cross-system lease implementation"
  ]
}
