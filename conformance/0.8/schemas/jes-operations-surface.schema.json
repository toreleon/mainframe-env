{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/jes-operations-surface.schema.json",
  "title": "JES operation and topology surface inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_version",
    "work_package",
    "submission_kinds",
    "durable_authorities",
    "authorization",
    "job_controls",
    "output_controls",
    "operator_controls",
    "nje_projection",
    "mas_projection",
    "bounds",
    "non_claims"
  ],
  "properties": {
    "schema_version": {"const": "mainframe-env.jes-operations-inventory@1"},
    "target_version": {"const": "0.8.0"},
    "work_package": {"const": "JES-804"},
    "submission_kinds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch", "started-task"],
      "properties": {
        "batch": {"$ref": "#/$defs/boundedUniqueStrings"},
        "started-task": {"$ref": "#/$defs/boundedUniqueStrings"}
      }
    },
    "durable_authorities": {"$ref": "#/$defs/nonEmptyStringMap"},
    "authorization": {"$ref": "#/$defs/nonEmptyStringMap"},
    "job_controls": {"$ref": "#/$defs/boundedUniqueStrings"},
    "output_controls": {"$ref": "#/$defs/boundedUniqueStrings"},
    "operator_controls": {"$ref": "#/$defs/boundedUniqueStrings"},
    "nje_projection": {"$ref": "#/$defs/boundedUniqueStrings"},
    "mas_projection": {"$ref": "#/$defs/boundedUniqueStrings"},
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "members", "node_name_bytes"],
      "properties": {
        "nodes": {"type": "integer", "minimum": 1},
        "members": {"type": "integer", "minimum": 1},
        "node_name_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "non_claims": {"$ref": "#/$defs/boundedUniqueStrings"}
  },
  "$defs": {
    "boundedUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "nonEmptyStringMap": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 256}
    }
  }
}
