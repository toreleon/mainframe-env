{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/ims-licensed-differential-receipt@1",
  "title": "External IBM IMS 15.6 licensed differential receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_subsystem",
    "work_package",
    "source_identity",
    "licensed_service",
    "authorization",
    "candidate",
    "contract",
    "runners",
    "observations",
    "attestation"
  ],
  "properties": {
    "schema_version": {
      "const": "mainframe-env.ims-licensed-differential-receipt@1"
    },
    "target_subsystem": {
      "const": "ims.programming"
    },
    "work_package": {
      "const": "IMS-1406.licensed-harness-contract"
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_id",
        "unit",
        "documentation_product",
        "official_catalog_sha256",
        "applicability_rules_sha256",
        "source_manifests",
        "comparison_topic_path",
        "comparison_topic_sha256",
        "family_count",
        "comparison_manifest_sha256",
        "comparison_topic_set_sha256",
        "comparison_toc_sha256"
      ],
      "properties": {
        "baseline_id": {
          "const": "ibm-ims-15.6-dli-2026-08-31"
        },
        "unit": {
          "const": "dli-call-families"
        },
        "documentation_product": {
          "const": "SSEPH2_15.6.0"
        },
        "official_catalog_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "maxLength": 71
        },
        "applicability_rules_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "maxLength": 71
        },
        "source_manifests": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "baseline_id",
              "topic_set_sha256",
              "toc_sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:@+/-]{1,160}$",
                "maxLength": 160
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "maxLength": 71
              },
              "baseline_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:@+/-]{1,160}$",
                "maxLength": 160
              },
              "topic_set_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "maxLength": 71
              },
              "toc_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "maxLength": 71
              }
            }
          }
        },
        "comparison_topic_path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:@+/-]{1,160}$",
          "maxLength": 160
        },
        "comparison_topic_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "maxLength": 71
        },
        "family_count": {
          "const": 25
        },
        "comparison_manifest_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "maxLength": 71
        },
        "comparison_topic_set_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "maxLength": 71
        },
        "comparison_toc_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "maxLength": 71
        }
      }
    },
    "licensed_service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_name",
        "major_minor",
        "release",
        "service_level",
        "build_id",
        "installation_digest"
      ],
      "properties": {
        "product_name": {
          "const": "IBM IMS"
        },
        "major_minor": {
          "const": "15.6"
        },
        "release": {
          "type": "string",
          "pattern": "^15\\.6\\.[0-9]{1,3}$",
          "maxLength": 9
        },
        "service_level": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:@+/-]{1,160}$",
          "maxLength": 160
        },
        "build_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:@+/-]{1,160}$",
          "maxLength": 160
        },
        "installation_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "maxLength": 71
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorized",
        "authority",
        "grant_id",
        "grant_digest",
        "environment_manifest_digest",
        "capabilities"
      ],
      "properties": {
        "authorized": {
          "const": true
        },
        "authority": {
          "const": "licensed-environment-controller"
        },
        "grant_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:@+/-]{1,160}$",
          "maxLength": 160
        },
        "grant_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "maxLength": 71
        },
        "environment_manifest_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "maxLength": 71
        },
        "capabilities": {
          "type": "array",
          "minItems": 30,
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:@+/-]{1,160}$",
            "maxLength": 160
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_sha",
        "tree_sha",
        "tracked_worktree_clean"
      ],
      "properties": {
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "maxLength": 40
        },
        "tree_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "maxLength": 40
        },
        "tracked_worktree_clean": {
          "const": true
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_digest",
        "verifier_digest",
        "fixture_contract_digest",
        "fixture_bundle_digest",
        "normalization_policy",
        "runner_protocol"
      ],
      "properties": {
        "spec_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "maxLength": 71
        },
        "verifier_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "maxLength": 71
        },
        "fixture_contract_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "maxLength": 71
        },
        "fixture_bundle_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "maxLength": 71
        },
        "normalization_policy": {
          "const": "ims-normalized-observation@1"
        },
        "runner_protocol": {
          "const": "mainframe-env.ims-licensed-runner@1"
        }
      }
    },
    "runners": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "oracle"
      ],
      "properties": {
        "product": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "route",
            "digest",
            "native_ibm_fallback"
          ],
          "properties": {
            "kind": {
              "const": "mainframe-env-owned"
            },
            "route": {
              "const": "owned-ims-provider"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$",
              "maxLength": 71
            },
            "native_ibm_fallback": {
              "const": false
            }
          }
        },
        "oracle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "route",
            "digest"
          ],
          "properties": {
            "kind": {
              "const": "licensed-ibm-ims"
            },
            "route": {
              "const": "licensed-dli-adapter"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$",
              "maxLength": 71
            }
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "row_id",
          "call_family",
          "source_locator",
          "source_topic_path",
          "source_topic_sha256",
          "applicability_profiles",
          "input_profile",
          "scenario_class",
          "fixture_bundle_member",
          "fixture_input_digest",
          "product",
          "oracle"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^ims\\.dli\\.[0-9]{4}\\.licensed-differential$",
            "maxLength": 64
          },
          "row_id": {
            "type": "string",
            "pattern": "^ibm-ims-15\\.6-dli-2026-08-31:dli-call-families:[0-9]{4}$",
            "maxLength": 90
          },
          "call_family": {
            "type": "string",
            "maxLength": 96
          },
          "source_locator": {
            "type": "string",
            "maxLength": 160
          },
          "source_topic_path": {
            "type": "string",
            "maxLength": 160
          },
          "source_topic_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "maxLength": 71
          },
          "applicability_profiles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:@+/-]{1,160}$",
              "maxLength": 160
            }
          },
          "input_profile": {
            "type": "string",
            "pattern": "^independent-ims\\.[a-z0-9-]+\\.v1$",
            "maxLength": 96
          },
          "scenario_class": {
            "enum": [
              "completed",
              "condition",
              "rejected"
            ]
          },
          "fixture_bundle_member": {
            "type": "string",
            "pattern": "^dli/[0-9]{4}\\.json$",
            "maxLength": 32
          },
          "fixture_input_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "maxLength": 71
          },
          "product": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "outcome_class",
              "pcb_status",
              "pcb_kind",
              "position_state",
              "position_digest",
              "mutation_state",
              "state_digest",
              "effect_digest",
              "output_digest",
              "output_length",
              "output_encoding"
            ],
            "properties": {
              "outcome_class": {
                "enum": [
                  "completed",
                  "condition",
                  "rejected"
                ]
              },
              "pcb_status": {
                "type": "string",
                "pattern": "^[A-Z0-9 ]{2}$",
                "maxLength": 2
              },
              "pcb_kind": {
                "enum": [
                  "database",
                  "gsam",
                  "io",
                  "alternate",
                  "none"
                ]
              },
              "position_state": {
                "enum": [
                  "none",
                  "unchanged",
                  "advanced",
                  "reset",
                  "restored",
                  "unknown"
                ]
              },
              "position_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "maxLength": 71
              },
              "mutation_state": {
                "enum": [
                  "no-mutation",
                  "pending",
                  "committed",
                  "backed-out",
                  "unknown"
                ]
              },
              "state_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "maxLength": 71
              },
              "effect_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "maxLength": 71
              },
              "output_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "maxLength": 71
              },
              "output_length": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16777216
              },
              "output_encoding": {
                "enum": [
                  "no-output",
                  "binary",
                  "utf-8",
                  "ebcdic-single-byte"
                ]
              }
            }
          },
          "oracle": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "outcome_class",
              "pcb_status",
              "pcb_kind",
              "position_state",
              "position_digest",
              "mutation_state",
              "state_digest",
              "effect_digest",
              "output_digest",
              "output_length",
              "output_encoding"
            ],
            "properties": {
              "outcome_class": {
                "enum": [
                  "completed",
                  "condition",
                  "rejected"
                ]
              },
              "pcb_status": {
                "type": "string",
                "pattern": "^[A-Z0-9 ]{2}$",
                "maxLength": 2
              },
              "pcb_kind": {
                "enum": [
                  "database",
                  "gsam",
                  "io",
                  "alternate",
                  "none"
                ]
              },
              "position_state": {
                "enum": [
                  "none",
                  "unchanged",
                  "advanced",
                  "reset",
                  "restored",
                  "unknown"
                ]
              },
              "position_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "maxLength": 71
              },
              "mutation_state": {
                "enum": [
                  "no-mutation",
                  "pending",
                  "committed",
                  "backed-out",
                  "unknown"
                ]
              },
              "state_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "maxLength": 71
              },
              "effect_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "maxLength": 71
              },
              "output_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "maxLength": 71
              },
              "output_length": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16777216
              },
              "output_encoding": {
                "enum": [
                  "no-output",
                  "binary",
                  "utf-8",
                  "ebcdic-single-byte"
                ]
              }
            }
          }
        }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "run_id",
        "issued_at",
        "licensed_execution",
        "independent_product_and_oracle_runs",
        "proprietary_bytes_retained_in_receipt",
        "credentials_retained_in_receipt",
        "raw_output_retained_in_receipt",
        "historical_result",
        "synthetic_or_model_result"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:@+/-]{1,160}$",
          "maxLength": 160
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:@+/-]{1,160}$",
          "maxLength": 160
        },
        "issued_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "maxLength": 20
        },
        "licensed_execution": {
          "const": true
        },
        "independent_product_and_oracle_runs": {
          "const": true
        },
        "proprietary_bytes_retained_in_receipt": {
          "const": false
        },
        "credentials_retained_in_receipt": {
          "const": false
        },
        "raw_output_retained_in_receipt": {
          "const": false
        },
        "historical_result": {
          "const": false
        },
        "synthetic_or_model_result": {
          "const": false
        }
      }
    }
  }
}
