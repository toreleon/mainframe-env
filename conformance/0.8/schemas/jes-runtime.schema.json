{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/jes-runtime@1",
  "title": "mainframe-env JES runtime contracts",
  "oneOf": [
    {"$ref": "#/$defs/scheduler"},
    {"$ref": "#/$defs/spool"},
    {"$ref": "#/$defs/output"},
    {"$ref": "#/$defs/checkpoint"}
  ],
  "$defs": {
    "class": {"type": "string", "pattern": "^[A-Z0-9]$"},
    "stateDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "classes", "initiators"],
      "properties": {
        "schema_version": {"const": "mainframe-env.jes-runtime@1"},
        "classes": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 36,
          "propertyNames": {"$ref": "#/$defs/class"},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["class", "priority_floor", "priority_ceiling", "held_by_default", "max_active", "output_class"],
            "properties": {
              "class": {"$ref": "#/$defs/class"},
              "priority_floor": {"type": "integer", "minimum": 0, "maximum": 255},
              "priority_ceiling": {"type": "integer", "minimum": 0, "maximum": 255},
              "held_by_default": {"type": "boolean"},
              "max_active": {"type": "integer", "minimum": 1, "maximum": 16384},
              "output_class": {"$ref": "#/$defs/class"}
            }
          }
        },
        "initiators": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 4096,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "classes", "minimum_priority", "max_active", "enabled"],
            "properties": {
              "name": {"type": "string", "pattern": "^[A-Z0-9@$#]{1,16}$"},
              "classes": {"type": "array", "minItems": 1, "maxItems": 36, "uniqueItems": true, "items": {"$ref": "#/$defs/class"}},
              "minimum_priority": {"type": "integer", "minimum": 0, "maximum": 255},
              "max_active": {"type": "integer", "minimum": 1, "maximum": 16384},
              "enabled": {"type": "boolean"}
            }
          }
        }
      }
    },
    "spool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "job_id", "step_name", "dd_name", "class", "destination", "writer", "forms", "record_count", "byte_count", "created_tick", "retain_until_tick", "state"],
      "properties": {
        "schema_version": {"const": "mainframe-env.jes-spool@1"},
        "id": {"type": "string", "minLength": 1, "maxLength": 64},
        "job_id": {"type": "string", "pattern": "^JOB[0-9]{5,8}$"},
        "step_name": {"type": ["string", "null"], "maxLength": 128},
        "dd_name": {"type": "string", "minLength": 1, "maxLength": 128},
        "class": {"$ref": "#/$defs/class"},
        "destination": {"type": "string", "minLength": 1, "maxLength": 128},
        "writer": {"type": ["string", "null"], "maxLength": 128},
        "forms": {"type": ["string", "null"], "maxLength": 128},
        "record_count": {"type": "integer", "minimum": 0, "maximum": 262144},
        "byte_count": {"type": "integer", "minimum": 0, "maximum": 268435456},
        "created_tick": {"type": "integer", "minimum": 0},
        "retain_until_tick": {"type": "integer", "minimum": 0},
        "state": {"enum": ["open", "closed", "held", "released", "selected", "complete", "cancelled", "purged"]}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "job_id", "class", "destination", "writer", "forms", "copies", "retain_until_tick", "state", "spool_files"],
      "properties": {
        "schema_version": {"const": "mainframe-env.jes-output@1"},
        "id": {"type": "string", "minLength": 1, "maxLength": 64},
        "job_id": {"type": "string", "pattern": "^JOB[0-9]{5,8}$"},
        "class": {"$ref": "#/$defs/class"},
        "destination": {"type": "string", "minLength": 1, "maxLength": 128},
        "writer": {"type": ["string", "null"], "maxLength": 128},
        "forms": {"type": ["string", "null"], "maxLength": 128},
        "copies": {"type": "integer", "minimum": 1, "maximum": 255},
        "retain_until_tick": {"type": "integer", "minimum": 0},
        "state": {"enum": ["awaiting-selection", "held", "released", "selected", "printing", "complete", "cancelled", "purged"]},
        "spool_files": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}}
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "job_id", "job_version", "attempt", "active_step", "effect_sequence", "committed_steps", "dataset_resolutions", "cancellation", "state_digest"],
      "properties": {
        "schema_version": {"const": "mainframe-env.jes-checkpoint@1"},
        "job_id": {"type": "string", "pattern": "^JOB[0-9]{5,8}$"},
        "job_version": {"type": "integer", "minimum": 1},
        "attempt": {"type": "integer", "minimum": 1},
        "active_step": {"type": ["string", "null"], "maxLength": 128},
        "effect_sequence": {"type": "integer", "minimum": 0},
        "committed_steps": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "dataset_resolutions": {"type": "object", "maxProperties": 4096, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 128}},
        "cancellation": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "requested_by", "reason", "requested_tick", "state"],
              "properties": {
                "id": {"type": "string", "minLength": 1, "maxLength": 128},
                "requested_by": {"type": "string", "minLength": 1, "maxLength": 128},
                "reason": {"type": "string", "minLength": 1, "maxLength": 4096},
                "requested_tick": {"type": "integer", "minimum": 0},
                "state": {"enum": ["requested", "observed", "completed"]}
              }
            }
          ]
        },
        "state_digest": {"$ref": "#/$defs/stateDigest"}
      }
    }
  }
}
