{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/cics-licensed-family-v1.json",
  "title": "Sealed CICS licensed-oracle command family",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "family_id", "capture_contract", "command_rows", "observations", "fixture_path", "source_review_path", "environment_manifest_fields", "trusted_authority_id", "signature_algorithm", "public_key_source", "local_model_and_synthetic_credit", "licensed_campaign_status", "differential_gate", "handoff"],
  "properties": {
    "schema_version": {"const": "mainframe-env.cics-licensed-family@1"},
    "family_id": {"$ref": "#/$defs/id"},
    "capture_contract": {"const": "mainframe-env.cics-oracle-capture@2"},
    "command_rows": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/row"}},
    "observations": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["scenario_id", "command_row"], "properties": {"scenario_id": {"$ref": "#/$defs/id"}, "command_row": {"$ref": "#/$defs/row"}}}},
    "fixture_path": {"type": "string", "pattern": "^conformance/subsystems/cics/application/oracles/[A-Za-z0-9-]+\\.json$"},
    "source_review_path": {"type": "string", "pattern": "^conformance/subsystems/cics/application/oracles/[A-Za-z0-9-]+\\.json$"},
    "environment_manifest_fields": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "trusted_authority_id": {"const": "ibm-cics-protected-runner"},
    "signature_algorithm": {"const": "ed25519"},
    "public_key_source": {"const": "--public-key"},
    "local_model_and_synthetic_credit": {"const": 0},
    "licensed_campaign_status": {"const": "not-run"},
    "differential_gate": {"const": "pending"},
    "handoff": {"const": "docs/runbooks/cics-licensed-pilot.md"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9_.@+\\-]+$"},
    "row": {"type": "string", "pattern": "^ibm-cics-ts-6x-2026-08-31:api-commands:[0-9]{4}$"}
  }
}
