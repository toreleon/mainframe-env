{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/official-catalog@1",
  "title": "mainframe-env normalized official catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "baseline_id", "subsystem", "mandatory_rows", "units"],
  "properties": {
    "schema_version": {"const": "mainframe-env.official-catalog@1"},
    "baseline_id": {"type": "string", "minLength": 8},
    "subsystem": {"type": "string", "minLength": 2},
    "mandatory_rows": {"type": "integer", "minimum": 1},
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "denominator", "normalization", "rows"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "denominator": {"type": "integer", "minimum": 1},
          "normalization": {"type": "string", "minLength": 3},
          "rows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "source_locator", "mandatory"],
              "properties": {
                "id": {"type": "string", "minLength": 12},
                "label": {"type": "string", "minLength": 1},
                "source_locator": {"type": "string", "minLength": 4},
                "mandatory": {"const": true}
              }
            }
          }
        }
      }
    }
  }
}
