#!/usr/bin/env bash
# Reuse the Linux CLI bundled with the remote OpenAI Codex extension.
set -euo pipefail
shopt -s nullglob
candidate=
for installed in "$HOME"/.vscode-server/extensions/openai.chatgpt-*/bin/linux-*/codex; do
  [[ -x "$installed" ]] && candidate="$installed"
done
if [[ -z "$candidate" ]]; then
  echo 'Codex is installed by the VS Code extension; finish the remote extension setup first.' >&2
  exit 127
fi
exec "$candidate" "$@"
