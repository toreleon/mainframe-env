{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/work-package-amendments@1",
  "title": "Commit-bound 0.2 work-package repair amendments",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_subsystem", "status", "historical_receipts_rewritten", "amendments"],
  "properties": {
    "schema_version": {"const": "mainframe-env.work-package-amendments@1"},
    "target_subsystem": {"const": "coverage.foundation"},
    "status": {"const": "pass"},
    "historical_receipts_rewritten": {"const": false},
    "amendments": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["work_package", "reason", "historical", "repair_artifacts"],
        "properties": {
          "work_package": {"enum": ["CV-204", "CV-205", "CV-206", "CV-209"]},
          "reason": {"type": "string", "minLength": 1},
          "historical": {
            "type": "object",
            "additionalProperties": false,
            "required": ["completion_commit", "receipt_path", "evidence_digest", "validation"],
            "properties": {
              "completion_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "receipt_path": {"type": "string", "pattern": "^conformance/subsystems/coverage/evidence/work-packages/CV-20[4569]\\.json$"},
              "evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "validation": {"const": "git-object-content"}
            }
          },
          "repair_artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    }
  }
}
