{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/review-repair-round-5@1",
  "title": "mainframe-env 0.2 fifth-review repository-content evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "derived", "status", "evidence_digest", "receipt"],
  "properties": {
    "schema_version": {"const": "mainframe-env.review-repair-round-5@1"},
    "derived": {"const": true},
    "status": {"const": "pass"},
    "evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_version", "accepted_parent", "candidate_source_digest", "branch", "profile", "historical_round_four", "findings", "artifacts", "release_inventory", "sealing", "parent_repository_digest"],
      "properties": {
        "target_version": {"const": "0.2.0"},
        "accepted_parent": {"const": "36344c542e82a4174f5be7da6038f7095ce6cba8"},
        "candidate_source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "branch": {"const": "impl/0.2.0"},
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "schema_version", "profile_id", "sha256"],
          "properties": {
            "path": {"const": "conformance/0.2/evidence/review-repair-round-5-profile.json"},
            "schema_version": {"const": "mainframe-env.seal-profile@1"},
            "profile_id": {"const": "review-repair-round-5"},
            "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        },
        "historical_round_four": {
          "type": "object",
          "additionalProperties": false,
          "required": ["completion_commit", "accepted_parent", "input", "receipt", "validation", "remote_evidence_credit"],
          "properties": {
            "completion_commit": {"const": "36344c542e82a4174f5be7da6038f7095ce6cba8"},
            "accepted_parent": {"const": "b61d604fbdf4867154f235d45fd4453ef7e3b79d"},
            "input": {
              "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
              "properties": {
                "path": {"const": "conformance/0.2/evidence/review-repair-round-4-inputs.json"},
                "sha256": {"const": "sha256:48ff647b06f276a9e5e733de2bdfccbb9b4c6c634fd5ff3912f3794a673ed693"}
              }
            },
            "receipt": {
              "type": "object", "additionalProperties": false, "required": ["path", "sha256", "evidence_digest"],
              "properties": {
                "path": {"const": "conformance/0.2/evidence/review-repair-round-4.json"},
                "sha256": {"const": "sha256:7f9fe7538d9653dfb83e9a65d1ad0c20c50951f991d633a9b090cb8599ef9cc9"},
                "evidence_digest": {"const": "sha256:fa5ea3ce742892135f2811f559b913bc44bb1fdf6ca0a6e5acba803db4cb3fa3"}
              }
            },
            "validation": {"const": "exact Git object bytes and completion trailers"},
            "remote_evidence_credit": {"const": "none"}
          }
        },
        "findings": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "state", "content_rule"],
            "properties": {
              "id": {"type": "integer", "minimum": 1, "maximum": 4},
              "state": {"const": "closed"},
              "content_rule": {"type": "string", "minLength": 1}
            }
          }
        },
        "artifacts": {
          "type": "array", "minItems": 25, "maxItems": 25,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          }
        },
        "release_inventory": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["target", "documents"],
            "properties": {
              "target": {"enum": ["aarch64-apple-darwin", "x86_64-unknown-linux-gnu"]},
              "documents": {"const": ["LICENSES.md", "build-inputs.json", "checksums.sha256", "manifest.json", "provenance.intoto.json", "sbom.cdx.json"]}
            }
          }
        },
        "sealing": {
          "type": "object", "additionalProperties": false,
          "required": ["canonicalization", "candidate", "commit_message", "completion_identity", "callback"],
          "properties": {
            "canonicalization": {"type": "string", "minLength": 1},
            "candidate": {"type": "string", "minLength": 1},
            "commit_message": {"const": "mainframe-env-round-5-commit-message.txt"},
            "completion_identity": {"type": "string", "minLength": 1},
            "callback": {"const": "canonical Git/GitHub-derived JSON on stdout only"}
          }
        },
        "parent_repository_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
