{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/jes-dependency-additions.schema.json",
  "title": "JES conformance dependency and profile additions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_subsystem", "profile_additions", "edges"],
  "properties": {
    "schema_version": {"const": "mainframe-env.conformance-dependency-additions@1"},
    "target_subsystem": {"const": "jes.execution"},
    "profile_additions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "array",
        "prefixItems": [
          {"enum": ["core-server", "conformance"]},
          {"type": "string", "pattern": "^mainframe-env-[a-z0-9-]+$"}
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "array",
        "prefixItems": [
          {"type": "string", "pattern": "^(mainframe-env-[a-z0-9-]+|xtask)$"},
          {"type": "string", "pattern": "^mainframe-env-[a-z0-9-]+$"}
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    }
  }
}
