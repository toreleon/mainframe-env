{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/topic-manifest-registry@1",
  "title": "Explicit zero-credit IBM topic-manifest registry",
  "description": "Registers later source-review manifests without changing the immutable 0.2 catalog index or granting semantic authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_version",
    "semantic_authority",
    "coverage_credit",
    "manifests"
  ],
  "properties": {
    "schema_version": {
      "const": "mainframe-env.topic-manifest-registry@1"
    },
    "target_version": {
      "const": "0.9.0"
    },
    "semantic_authority": {
      "const": false
    },
    "coverage_credit": {
      "const": 0
    },
    "manifests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope_id",
          "subsystem",
          "baseline_id",
          "manifest",
          "manifest_sha256",
          "topic_count",
          "topic_manifest_sha256",
          "semantic_authority",
          "coverage_credit"
        ],
        "properties": {
          "scope_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "subsystem": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 32
          },
          "baseline_id": {
            "type": "string",
            "minLength": 8,
            "maxLength": 160
          },
          "manifest": {
            "type": "string",
            "pattern": "^conformance/0\\.9/manifests/[A-Za-z0-9][A-Za-z0-9_.-]*\\.json$"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "topic_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9999
          },
          "topic_manifest_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "semantic_authority": {
            "const": false
          },
          "coverage_credit": {
            "const": 0
          }
        }
      }
    }
  }
}
