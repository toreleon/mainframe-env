{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/dataset-certification.schema.json",
  "title": "Dataset VSAM AMS local certification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_version", "baseline_id", "surface", "state", "matrices", "validation", "oracle"],
  "properties": {
    "schema_version": { "const": "mainframe-env.dataset-certification@1" },
    "target_version": { "const": "0.6.0" },
    "baseline_id": { "const": "ibm-zos-3.2-dfsms-ams-2026-06" },
    "surface": {
      "type": "object", "additionalProperties": false,
      "required": ["official_rows", "ams_commands", "organizations", "detailed_descriptors", "local_bindings", "local_gates"],
      "properties": {
        "official_rows": { "const": 36 },
        "ams_commands": { "const": 31 },
        "organizations": { "const": 5 },
        "detailed_descriptors": { "const": 131 },
        "local_bindings": { "const": 180 },
        "local_gates": {
          "type": "object", "additionalProperties": false,
          "required": ["recognized", "validated", "executed", "conditioned", "recovered", "differential"],
          "properties": {
            "recognized": { "const": 36 },
            "validated": { "const": 36 },
            "executed": { "const": 36 },
            "conditioned": { "const": 36 },
            "recovered": { "const": 36 },
            "differential": { "const": 0 }
          }
        }
      }
    },
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["writer", "readers", "aix_writer", "migrations"],
      "properties": {
        "writer": { "const": "MEDS6" },
        "readers": { "const": ["MEDS1", "MEDS2", "MEDS3", "MEDS4", "MEDS5", "MEDS6"] },
        "aix_writer": { "const": "MEAIX4" },
        "migrations": { "const": ["2-to-3", "3-to-4", "4-to-5", "5-to-6"] }
      }
    },
    "matrices": {
      "type": "object", "additionalProperties": { "const": "pass" },
      "required": ["base_aix_atomicity", "gdg_atomicity", "disp_cleanup", "locks", "rls_tvs", "restart", "unknown_outcome", "concurrent_mutation", "corruption", "backup_restore", "migration", "scale", "carddemo_exactness", "volume_vtoc", "owner_security", "operand_rejection", "lifecycle_invalidation", "snapshot_all_organizations"]
    },
    "validation": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "oracle": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "required_environment", "receipt"],
      "properties": {
        "status": { "enum": ["pending", "pass"] },
        "required_environment": { "const": "licensed-zos-3.2" },
        "receipt": { "type": ["string", "null"], "maxLength": 256 }
      }
    }
  }
}
