{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/review-repair-round-2@1",
  "title": "mainframe-env 0.2 follow-up independent review repair evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "derived", "status", "evidence_digest", "receipt"],
  "properties": {
    "schema_version": {"const": "mainframe-env.review-repair-round-2@1"},
    "derived": {"const": true},
    "status": {"const": "pass"},
    "evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_version",
        "source_identity",
        "prerequisite_source",
        "prerequisite_commit",
        "candidate_source_digest",
        "round_one",
        "findings",
        "commands",
        "artifacts",
        "remote_actions"
      ],
      "properties": {
        "target_version": {"const": "0.2.0"},
        "source_identity": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "prerequisite_source": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "prerequisite_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "candidate_source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "round_one": {
          "type": "object",
          "additionalProperties": false,
          "required": ["completion_commit", "evidence_path", "evidence_digest", "validation"],
          "properties": {
            "completion_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "evidence_path": {"const": "conformance/0.2/evidence/review-repair.json"},
            "evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "validation": {"const": "commit-bound"}
          }
        },
        "findings": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "state", "repair", "regression"],
            "properties": {
              "id": {"type": "integer", "minimum": 1, "maximum": 10},
              "state": {"const": "closed"},
              "repair": {"type": "string", "minLength": 1},
              "regression": {"type": "string", "minLength": 1}
            }
          }
        },
        "commands": {
          "type": "array",
          "minItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "exit_code", "result"],
            "properties": {
              "command": {"type": "string", "minLength": 1},
              "exit_code": {"const": 0},
              "result": {"type": "string", "minLength": 1}
            }
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          }
        },
        "remote_actions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tagged", "published", "deployed", "merged"],
          "properties": {
            "tagged": {"const": false},
            "published": {"const": false},
            "deployed": {"const": false},
            "merged": {"const": false}
          }
        }
      }
    }
  }
}
