{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mainframe-env.invalid/schemas/dataset-programming-surface.schema.json",
  "title": "mainframe-env 0.6 dataset programming surface",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_version",
    "baseline_id",
    "source",
    "state_schema_version",
    "families"
  ],
  "properties": {
    "schema_version": { "const": "mainframe-env.dataset-programming-surface@1" },
    "target_version": { "const": "0.6.0" },
    "baseline_id": { "const": "ibm-zos-3.2-dfsms-ams-2026-06" },
    "state_schema_version": { "const": 6 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publication", "url", "manifest", "sha256", "bytes", "snapshot_date"],
      "properties": {
        "publication": { "const": "SC23-6846-70" },
        "url": { "type": "string", "format": "uri" },
        "manifest": { "const": "conformance/0.2/manifests/dataset-vsam-ams-topics.json" },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "bytes": { "const": 3448164 },
        "snapshot_date": { "const": "2026-06-22" }
      }
    },
    "families": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/family" }
    }
  },
  "$defs": {
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "items"],
      "properties": {
        "id": {
          "enum": [
            "organizations",
            "access-modes",
            "dcb",
            "allocation",
            "sms",
            "volume",
            "catalog",
            "lifecycle",
            "provider-capabilities",
            "ams-commands"
          ]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/item" }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "authority",
        "implementation",
        "operands",
        "effect",
        "official_rows"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authority": {
          "enum": ["dataset", "catalog", "allocation", "volume", "lifecycle", "provider", "ams"]
        },
        "implementation": { "enum": ["required", "capability-gated"] },
        "operands": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{0,31}$" }
        },
        "effect": { "type": "string", "minLength": 1, "maxLength": 256 },
        "official_rows": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ibm-zos-3\\.2-dfsms-ams-2026-06:(ams-functional-commands|vsam-primary-organizations):[0-9]{4}$"
          }
        }
      }
    }
  }
}
